CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_MASTER_SKU}` OPTIONS(location="${databuffet.REGION}");


DROP TABLE IF EXISTS `${BrandTranslationsTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${BrandTranslationsTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_MASTER_SKU}/brand_translations/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_MASTER_SKU}/brand_translations/'
);

