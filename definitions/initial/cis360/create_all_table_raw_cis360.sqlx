CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_CIS360}` OPTIONS(location="${databuffet.REGION}");


DROP TABLE IF EXISTS `${JuristicProfileTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${JuristicProfileTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_CIS360}/juristic_profile/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_CIS360}/juristic_profile/'
);

