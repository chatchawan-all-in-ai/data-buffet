    const MilTableRef = `${MilTable.database}.${MilTable.schema}.${MilTable.name}`;

    const MirTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "mir",
    };
    const MirTableRef = `${MirTable.database}.${MirTable.schema}.${MirTable.name}`;

    const MieTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "mie",
    };
