config {
  type: "operations",
  dependencies: [],
  tags: [databuffet.TAG_INITIAL],
}

js {
    const CqlTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "cql",
    };
    const CqlTableRef = `${CqlTable.database}.${CqlTable.schema}.${CqlTable.name}`;

    const MihTable = {
        database: databuffet.DATABASE,
