    const ArSTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "ar_s",
    };
    const ArSTableRef = `${ArSTable.database}.${ArSTable.schema}.${ArSTable.name}`;

    const ChqTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "chq",
    };
    const ChqTableRef = `${ChqTable.database}.${ChqTable.schema}.${ChqTable.name}`;

    const DebTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "deb",
    };
    const DebTableRef = `${DebTable.database}.${DebTable.schema}.${DebTable.name}`;

    const DepTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "dep",
