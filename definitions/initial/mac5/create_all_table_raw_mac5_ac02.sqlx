    const StgTableRef = `${StgTable.database}.${StgTable.schema}.${StgTable.name}`;

    const StkTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "stk",
    };
    const StkTableRef = `${StkTable.database}.${StkTable.schema}.${StkTable.name}`;

    const CfsTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "cfs",
    };
    const CfsTableRef = `${CfsTable.database}.${CfsTable.schema}.${CfsTable.name}`;
}


CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_MAC5_AC02}` OPTIONS(location="${databuffet.REGION}");


DROP TABLE IF EXISTS `${CqlTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${CqlTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_MAC5_AC02}/cql/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_MAC5_AC02}/cql/'
);

