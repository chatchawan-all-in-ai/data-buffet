config {
  type: "operations",
  dependencies: [],
  tags: [databuffet.TAG_INITIAL],
}

------------------------------------- SCHEMA --------------------------------------
CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_DERP}` OPTIONS(location="${databuffet.REGION}");
------------------------------------- SCHEMA --------------------------------------


----------------------------------- INCREMENTAL ---------------------------------------
-- 20260914–20260916 = full load (20260915 มีไฟล์ซ้ำ *_NNN_1.avro) · ตั้งแต่ 20260917 = incremental รายวัน
-- validated ต้อง dedup ด้วย id ข้ามทุก partition

-- Table: inventory_movement_journal_headers
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_DERP}.inventory_movement_journal_headers`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_DERP}.inventory_movement_journal_headers`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_headers/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_headers/'
);

