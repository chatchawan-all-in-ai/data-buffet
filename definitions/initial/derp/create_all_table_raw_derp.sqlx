CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_DERP}` OPTIONS(location="${databuffet.REGION}");



DROP TABLE IF EXISTS `${InventoryMovementJournalHeadersTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${InventoryMovementJournalHeadersTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_headers/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_headers/'
);

DROP TABLE IF EXISTS `${InventoryMovementJournalEntriesTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${InventoryMovementJournalEntriesTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_entries/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_movement_journal_entries/'
);

-- inventory_item_price: snapshot เต็มทุกวัน (~175k แถว/วัน) · ไฟล์ AVRO ช่วง 2026-10 มี default ผิดกฎใน 3 ฟิลด์ → BigQuery อาจสร้าง/อ่านไม่ได้จนกว่าต้นทางแก้

DROP TABLE IF EXISTS `${InventoryItemPriceTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${InventoryItemPriceTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_item_price/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_DERP}/inventory_item_price/'
);

-- crm_* / sales_*: เริ่มส่ง 2026-10-21/22/26 (1 partition ต่อโฟลเดอร์ ณ 2026-10-28)

