------------------------------------- EOM ----------------------------------------------
-- ยอดปิดรายเดือนที่ห้างส่งมาเอง — ไว้เทียบกับฟีดรายวันว่าเราทำยอดหายไปเท่าไร
-- ต้นทาง Airflow DAG pipline_saleout_mdt_eom อ่าน /opt/airflow/dags/SaleOut_MDT/SO_MDT_EOM/
--
-- ⚠️ ASATDATE ของชั้นนี้คือ **วันที่ DAG รัน** ไม่ใช่งวดของข้อมูล
--    แต่ละห้างปิดเดือนคนละวัน (GB/BT/HP วันที่ 5 · TW วันที่ 8) วันเดียวกันจึงได้คนละเดือน
--    วัด 2026-10-05: ไฟล์ GB = ก.ย. แต่ไฟล์ TW = ส.ค.
--    **งวดจริงต้องอ่านจากเนื้อไฟล์ที่ชั้น validated** ห้ามเดาจาก ASATDATE เด็ดขาด
--
-- BT เอาเฉพาะ 2 ชีตที่ใช้เทียบยอดขาย (ตัดสินใจ 2026-10-05)
-- อีก 5 ชีต (stock_by_branch, stock_aging, turnover, turnover_brand, sale_by_branch_mch3)
-- ยังขึ้น GCS อยู่ แต่ไม่สร้าง external table เพราะยังไม่มีใครอ่าน เพิ่มทีหลังได้

-- Table: eom_gb   โกลบอลเฮ้าส์ — รายการขายรายบรรทัด + แถวผลรวมต่อท้าย (ต้องกรองทิ้งที่ validated)
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_gb`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_gb`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/gb/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/gb/'
);

-- Table: eom_hp   โฮมโปร + เมกาโฮม — CSV รูปแบบเดียวกับฟีดรายวัน (PERIODTYPE = 'M')
-- เปิดใช้ 2026-10-05 หลังห้างส่งไฟล์ปิดงวด 09/2026 มาให้ (ก่อนหน้านี้ส่งแต่เดือนที่ยังไม่ปิด
-- โฟลเดอร์บน GCS เลยว่าง และ external table บนโฟลเดอร์ว่างสร้างไม่ได้ — เดา schema ไม่ออก)
--
-- ⚠️ หนึ่งพาร์ทิชันมีหลายงวดและหลายเวอร์ชันของงวดเดียวกัน — DAG รวมทุกไฟล์ในโฟลเดอร์
-- เป็น AVRO ก้อนเดียวต่อวันที่รัน วัด 2026-10-05: 6 ไฟล์ = 7,173 แถว ครอบคลุมงวด 09 และ 10
-- โดยงวด 09 มาจาก 3 ไฟล์ (23.77M / 24.19M / 27.04M) ซึ่งเป็นยอดระหว่างเดือน 2 ครั้งและยอดปิด 1 ครั้ง
-- validated ต้องเลือกเวอร์ชันล่าสุดต่องวดด้วย CRDATE — ไม่ตัดซ้ำยอดเดือน 9 จะเบิ้ลเป็น 75M
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_hp`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_hp`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/hp/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/hp/'
);

-- Table: eom_tw   ไทวัสดุ — ชีตชื่อลงท้าย Month ต่างจากรายวัน
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_tw`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_tw`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/tw/reportsalesubscriptionmonth/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/tw/reportsalesubscriptionmonth/'
);

-- Table: eom_bt_sales_by_branch   บุญถาวร — ยอดสรุป MTD/YTD รายสาขา
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_bt_sales_by_branch`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_bt_sales_by_branch`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/bt/sales_by_branch/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/bt/sales_by_branch/'
);

-- Table: eom_bt_sale_by_branch_detail   บุญถาวร — รายละเอียดรายสินค้า
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_bt_sale_by_branch_detail`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_bt_sale_by_branch_detail`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/bt/sale_by_branch_detail/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/so_mdt_eom/bt/sale_by_branch_detail/'
);
------------------------------------- EOM ----------------------------------------------

------------------------------- LASTYEAR (ครั้งเดียว) ----------------------------------

DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear` (
    sale_date    STRING,
    branch_code  STRING,
    branch_name  STRING,
    store_code   STRING,
    product_code STRING,
    product_name STRING,
    sale_qty     STRING,
    sale_amount  STRING
)
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/'
);
------------------------------- LASTYEAR (ครั้งเดียว) ----------------------------------

-- Table: saleout_lastyear_monthly   ประวัติรายเดือน 2022-01 ถึง 2026-07
-- ⚠️ ไฟล์นี้เป็น "สำเนา" ที่ดัมป์จาก onetime.saleout_lastyear_monthly เมื่อ 2026-10-19
--    ไม่ใช่ไฟล์ต้นฉบับจากทีม BI ซึ่งหาไม่เจอแล้ว — ถ้าเจอต้นฉบับให้เอามาแทน
--    มีไว้กันกรณีตารางหาย ก่อนหน้านี้หายแล้วสร้างคืนไม่ได้เลย
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear_monthly`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear_monthly` (
    month_date   STRING,
    store_code   STRING,
    branch_code  STRING,
    branch_name  STRING,
    product_code STRING,
    product_name STRING,
    sale_qty     STRING,
    sale_amount  STRING
)
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear_monthly/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear_monthly/'
);
------------------------------- LASTYEAR (ครั้งเดียว) ----------------------------------
----------------------------------- INCREMENTAL ---------------------------------------
