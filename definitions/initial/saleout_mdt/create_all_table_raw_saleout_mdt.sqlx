DROP TABLE IF EXISTS `${SaleoutLastyearTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${SaleoutLastyearTableRef}` (
    sale_date    STRING,
    branch_code  STRING,
    branch_name  STRING,
    store_code   STRING,
    product_code STRING,
    product_name STRING,
    sale_qty     STRING,
    sale_amount  STRING
)
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/'
);

DROP TABLE IF EXISTS `${SaleoutLastyearMonthlyTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${SaleoutLastyearMonthlyTableRef}` (
    month_date   STRING,
    store_code   STRING,
    branch_code  STRING,
    branch_name  STRING,
    product_code STRING,
    product_name STRING,
    sale_qty     STRING,
    sale_amount  STRING
)
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear_monthly/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear_monthly/'
);
