------------------------------- LASTYEAR (ครั้งเดียว) ----------------------------------
-- Table: saleout_lastyear
-- ยอดขายย้อนหลัง 2022-01-01 ถึง 2026-08-23 ที่ BI ส่งมาเป็น Excel (โหลด 2026-09-11)
-- 430,639 แถว / 4,185,331,780.32 บาท / ครบ 6 ห้าง (รวม DH ที่ฟีดรายวันยังไม่มี)
-- ⚠️ เป็นไฟล์ CSV ไม่ใช่ AVRO เหมือนตัวอื่น เพราะแปลงมาจาก xlsx ตรง ๆ
--    จึงต้องประกาศคอลัมน์เอง (external CSV ไม่มี schema มากับไฟล์)
-- ⚠️ เป็นการโหลดครั้งเดียว ไม่ใช่ฟีดรายวัน — พาร์ทิชันมีแค่ ASATDATE=20260911
-- ⚠️ ช่วง ก.พ.-ส.ค. 2026 ซ้อนกับฟีดรายวัน ห้ามเอาเข้า curated ทั้งก้อน
--    ต้องตัดด้วยวันที่ ดู document/operations/known-issues.md
DROP TABLE IF EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear`;
CREATE OR REPLACE EXTERNAL TABLE `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.saleout_lastyear` (
    sale_date    STRING,
    branch_code  STRING,
    branch_name  STRING,
    store_code   STRING,
    product_code STRING,
    product_name STRING,
    sale_qty     STRING,
    sale_amount  STRING
)
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'CSV',
  skip_leading_rows = 1,
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/lastyear/'
);
------------------------------- LASTYEAR (ครั้งเดียว) ----------------------------------
----------------------------------- INCREMENTAL ---------------------------------------