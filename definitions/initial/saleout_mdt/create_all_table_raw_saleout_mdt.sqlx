CREATE SCHEMA IF NOT EXISTS `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}` OPTIONS(location="${databuffet.REGION}");


DROP TABLE IF EXISTS `${SaleByBranchDetailTableRef}`;
CREATE OR REPLACE EXTERNAL TABLE `${SaleByBranchDetailTableRef}`
WITH PARTITION COLUMNS (
    ASATDATE STRING
)
OPTIONS (
  format = 'AVRO',
  uris = ['${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/bt/sale_by_branch_detail/*'],
  hive_partition_uri_prefix = '${databuffet.RAW_BUCKET}/${databuffet.GCS_SALEOUT_MDT}/bt/sale_by_branch_detail/'
);

