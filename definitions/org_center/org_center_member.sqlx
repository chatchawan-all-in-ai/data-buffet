config {
    type: "table",
    schema: databuffet.ORG_CENTER,
    dependencies: [
                    "org_center_schema", "org_center_link",
                    "dim_director_last", "dim_region_manager_last", "dim_section_manager_last",
                    "dim_sale_representative_last", "dim_section_last",
                    "update_sk_sale_rep_group"
                  ],
    tags: [databuffet.TAG_DIM_DAILY],
    uniqueKey: ["company_id", "employee_id", "position_code", "unit_id", "valid_from"],
    bigquery: {
        clusterBy: ["company_id", "employee_id"]
    },
}

js {
const MdsDataOrgEmployeeMappingCenterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_org_employee_mapping_center",
    };
    const MdsDataOrgEmployeeMappingCenterTableRef = `${MdsDataOrgEmployeeMappingCenterTable.database}.${MdsDataOrgEmployeeMappingCenterTable.schema}.${MdsDataOrgEmployeeMappingCenterTable.name}`;

const DimDirectorLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_director_last",
    };
    const DimDirectorLastTableRef = `${DimDirectorLastTable.database}.${DimDirectorLastTable.schema}.${DimDirectorLastTable.name}`;

const MdsDataCompanyMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_company_master",
    };
    const MdsDataCompanyMasterTableRef = `${MdsDataCompanyMasterTable.database}.${MdsDataCompanyMasterTable.schema}.${MdsDataCompanyMasterTable.name}`;

const DimRegionManagerLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region_manager_last",
    };
    const DimRegionManagerLastTableRef = `${DimRegionManagerLastTable.database}.${DimRegionManagerLastTable.schema}.${DimRegionManagerLastTable.name}`;

const DimSectionManagerLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_section_manager_last",
    };
    const DimSectionManagerLastTableRef = `${DimSectionManagerLastTable.database}.${DimSectionManagerLastTable.schema}.${DimSectionManagerLastTable.name}`;

const DimSaleRepresentativeLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sale_representative_last",
    };
    const DimSaleRepresentativeLastTableRef = `${DimSaleRepresentativeLastTable.database}.${DimSaleRepresentativeLastTable.schema}.${DimSaleRepresentativeLastTable.name}`;

const DimSectionLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_section_last",
    };
    const DimSectionLastTableRef = `${DimSectionLastTable.database}.${DimSectionLastTable.schema}.${DimSectionLastTable.name}`;

const MdsDataMdtSalesPcMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_mdt_sales_pc_master",
    };
    const MdsDataMdtSalesPcMasterTableRef = `${MdsDataMdtSalesPcMasterTable.database}.${MdsDataMdtSalesPcMasterTable.schema}.${MdsDataMdtSalesPcMasterTable.name}`;

const OrgCenterLinkTable = {
        database: databuffet.DATABASE,
        schema: databuffet.ORG_CENTER,
        name: "org_center_link",
    };
    const OrgCenterLinkTableRef = `${OrgCenterLinkTable.database}.${OrgCenterLinkTable.schema}.${OrgCenterLinkTable.name}`;
















}

-- unit_id ต้องตรงกับ org_center_unit · ไม่กรองแถวหมดอายุ
WITH emp_email AS (
  SELECT
    ${databuffet.functionData.cleanString("employeeid")} AS employee_id,
    ${databuffet.functionData.cleanString("employeeemail")} AS email
  FROM `${MdsDataOrgEmployeeMappingCenterTableRef}`
  WHERE is_active = TRUE
    AND ${databuffet.functionData.cleanString("employeeid")} IS NOT NULL
  QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY email IS NULL, updated_at DESC) = 1

), director AS (
  -- dim มีแค่ชื่อเต็ม: คำแรก = ชื่อ ที่เหลือ = นามสกุล
  SELECT
    ${databuffet.functionData.cleanString("companyID")} AS company_id,
    ${databuffet.functionData.cleanString("DirectorOfSalesID")} AS employee_id,
    REGEXP_EXTRACT(${databuffet.functionData.cleanString("DirectorOfSalesName")}, r'^(\S+)') AS first_name,
    REGEXP_EXTRACT(${databuffet.functionData.cleanString("DirectorOfSalesName")}, r'^\S+\s+(.+)$') AS last_name,
    CAST(NULL AS STRING) AS nickname,
    'DIRECTOR' AS position_code,
    CONCAT('DIR-', ${databuffet.functionData.cleanString("DirectorID")}) AS unit_id,
    CAST([] AS ARRAY<STRING>) AS department_id,
    StartDate AS valid_from,
    EndDate AS valid_to
  FROM `${DimDirectorLastTableRef}`

), ceo_source AS (
  -- ยังไม่กรอก CEOEmpID ใน MDS = ไม่มีที่นั่ง CEO; CEOName ว่างได้
  SELECT
    ${databuffet.functionData.cleanString("CompanyID")} AS company_id,
    ${databuffet.functionData.cleanString("CEOEmpID")} AS employee_id,
    ${databuffet.functionData.cleanString("CEOName")} AS full_name
  FROM `${MdsDataCompanyMasterTableRef}`
  WHERE is_active = TRUE
    AND ${databuffet.functionData.cleanString("CompanyID")} IS NOT NULL
  QUALIFY ROW_NUMBER() OVER (PARTITION BY company_id ORDER BY updated_at DESC, id) = 1

), ceo AS (
  SELECT
    c.company_id,
    c.employee_id,
    REGEXP_EXTRACT(c.full_name, r'^(\S+)') AS first_name,
    REGEXP_EXTRACT(c.full_name, r'^\S+\s+(.+)$') AS last_name,
    CAST(NULL AS STRING) AS nickname,
    'CEO' AS position_code,
    CONCAT('CO-', c.company_id) AS unit_id,
    CAST([] AS ARRAY<STRING>) AS department_id,
    DATE '2000-01-01' AS valid_from,
    DATE '2066-12-31' AS valid_to
  FROM ceo_source AS c
  WHERE c.employee_id IS NOT NULL

), region_manager AS (
  SELECT
    ${databuffet.functionData.cleanString("companyID")} AS company_id,
    ${databuffet.functionData.cleanString("RegionManagerEmployeeID")} AS employee_id,
    ${databuffet.functionData.cleanString("RegionManagerName")} AS first_name,
    ${databuffet.functionData.cleanString("RegionManagerSurname")} AS last_name,
    ${databuffet.functionData.cleanString("RegionManagerNickname")} AS nickname,
    'REGION_MGR' AS position_code,
    CONCAT('REG-', ${databuffet.functionData.cleanString("SubRegionID")}) AS unit_id,
    CAST([] AS ARRAY<STRING>) AS department_id,
    StartDate AS valid_from,
    EndDate AS valid_to
  FROM `${DimRegionManagerLastTableRef}`

), section_manager AS (
  SELECT
    ${databuffet.functionData.cleanString("companyID")} AS company_id,
    ${databuffet.functionData.cleanString("SectionManagerEmployeeID")} AS employee_id,
    ${databuffet.functionData.cleanString("SectionManagerName")} AS first_name,
    ${databuffet.functionData.cleanString("SectionManagerSurname")} AS last_name,
    ${databuffet.functionData.cleanString("SectionManagerNickname")} AS nickname,
    'SECTION_MGR' AS position_code,
    CONCAT('SEC-', ${databuffet.functionData.cleanString("SectionID")}) AS unit_id,
    CAST([] AS ARRAY<STRING>) AS department_id,
    StartDate AS valid_from,
    EndDate AS valid_to
  FROM `${DimSectionManagerLastTableRef}`

), ta_base AS (
  SELECT
    ${databuffet.functionData.cleanString("rep.companyID")} AS company_id,
    ${databuffet.functionData.cleanString("rep.EmployeeID")} AS employee_id,
    ${databuffet.functionData.cleanString("rep.EmployeeName")} AS first_name,
    ${databuffet.functionData.cleanString("rep.EmployeeSurname")} AS last_name,
    ${databuffet.functionData.cleanString("rep.EmployeeNickname")} AS nickname,
    CONCAT('SEC-', ${databuffet.functionData.cleanString("sec.SectionID")}) AS unit_id,
    ${databuffet.functionData.cleanString("rep.DepartmentID")} AS department_id,
    rep.StartDate,
    rep.EndDate
  FROM `${DimSaleRepresentativeLastTableRef}` AS rep
  LEFT JOIN `${DimSectionLastTableRef}` AS sec
    ON rep.SectionSK = sec.SectionSK
  WHERE rep.DepartmentID IS NOT NULL

), ta_agg AS (
  SELECT
    company_id,
    employee_id,
    unit_id,
    ARRAY_AGG(STRUCT(first_name, last_name, nickname) ORDER BY EndDate DESC, StartDate DESC LIMIT 1)[OFFSET(0)] AS latest,
    ARRAY_AGG(DISTINCT department_id IGNORE NULLS ORDER BY department_id) AS department_id,
    MIN(StartDate) AS valid_from,
    MAX(EndDate) AS valid_to
  FROM ta_base
  GROUP BY company_id, employee_id, unit_id

), ta AS (
  SELECT
    company_id,
    employee_id,
    latest.first_name,
    latest.last_name,
    latest.nickname,
    'TA' AS position_code,
    unit_id,
    department_id,
    valid_from,
    valid_to
  FROM ta_agg

), pc_name AS (
  SELECT
    employee_id,
    ${databuffet.functionData.cleanString("employee_name")} AS first_name,
    ${databuffet.functionData.cleanString("employee_surname")} AS last_name
  FROM `${MdsDataMdtSalesPcMasterTableRef}`
  WHERE is_active = TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY end_date DESC, start_date DESC, updated_at DESC, id) = 1

), ta_dept AS (
  SELECT DISTINCT
    company_id,
    department_id,
    unit_id,
    StartDate AS valid_from,
    EndDate AS valid_to
  FROM ta_base

), pc_ov AS (
  -- PC อยู่ส่วนของ department ที่ link ชี้ ในช่วงที่ซ้อนกับที่นั่ง TA ของ department นั้น (valid_to ของ link ไม่รวมวันนั้น, 2066-12-31 = ไม่มีวันสิ้นสุด)
  -- link ที่ department_id ว่าง = ไม่มีแถว member (ยังอยู่ใน link และ org_center_flags รายงาน)
  SELECT
    l.company_id,
    l.pc_employee_id AS employee_id,
    l.pc_type AS position_code,
    d.unit_id,
    GREATEST(l.valid_from, d.valid_from) AS valid_from,
    LEAST(IF(l.valid_to = DATE '2066-12-31', l.valid_to, DATE_SUB(l.valid_to, INTERVAL 1 DAY)), d.valid_to) AS valid_to
  FROM `${OrgCenterLinkTableRef}` AS l
  JOIN ta_dept AS d
    ON l.company_id = d.company_id
   AND l.department_id = d.department_id
   AND GREATEST(l.valid_from, d.valid_from) <= LEAST(IF(l.valid_to = DATE '2066-12-31', l.valid_to, DATE_SUB(l.valid_to, INTERVAL 1 DAY)), d.valid_to)
  WHERE l.pc_type IS NOT NULL
    AND l.pc_employee_id IS NOT NULL

), pc_ranges AS (
  SELECT DISTINCT company_id, employee_id, position_code, unit_id, valid_from, valid_to
  FROM pc_ov

), pc_previous AS (
  SELECT
    *,
    MAX(valid_to) OVER (
      PARTITION BY company_id, employee_id, position_code, unit_id
      ORDER BY valid_from, valid_to
      ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
    ) AS previous_valid_to
  FROM pc_ranges

), pc_grouped AS (
  SELECT
    *,
    SUM(CASE
      WHEN UNIX_DATE(valid_from) <= UNIX_DATE(previous_valid_to) + 1 THEN 0
      ELSE 1
    END) OVER (
      PARTITION BY company_id, employee_id, position_code, unit_id
      ORDER BY valid_from, valid_to
      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS period_id
  FROM pc_previous

), pc_period AS (
  SELECT
    company_id,
    employee_id,
    position_code,
    unit_id,
    MIN(valid_from) AS valid_from,
    MAX(valid_to) AS valid_to
  FROM pc_grouped
  GROUP BY company_id, employee_id, position_code, unit_id, period_id

), pc AS (
  SELECT
    pl.company_id,
    pl.employee_id,
    n.first_name,
    n.last_name,
    CAST(NULL AS STRING) AS nickname,
    pl.position_code,
    pl.unit_id,
    CAST([] AS ARRAY<STRING>) AS department_id,
    pl.valid_from,
    pl.valid_to
  FROM pc_period AS pl
  LEFT JOIN pc_name AS n
    ON pl.employee_id = n.employee_id

), member AS (
  SELECT * FROM ceo
  UNION ALL
  SELECT * FROM director
  UNION ALL
  SELECT * FROM region_manager
  UNION ALL
  SELECT * FROM section_manager
  UNION ALL
  SELECT * FROM ta
  UNION ALL
  SELECT * FROM pc

)
  SELECT
    m.company_id,
    m.employee_id,
    m.first_name,
    m.last_name,
    m.nickname,
    em.email,
    m.position_code,
    m.unit_id,
    m.department_id,
    m.valid_from,
    m.valid_to
  FROM member AS m
  LEFT JOIN emp_email AS em
    ON m.employee_id = em.employee_id
  WHERE m.employee_id IS NOT NULL

pre_operations {
}

post_operations {
}
