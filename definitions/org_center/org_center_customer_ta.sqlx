config {
    type: "table",
    schema: databuffet.ORG_CENTER,
    dependencies: [
                    "org_center_schema"
                  ],
    tags: [databuffet.TAG_DIM_DAILY],
    uniqueKey: ["company_id", "customer_code", "department_id", "valid_from"],
    bigquery: {
        clusterBy: ["company_id", "customer_code"]
    },
}

js {
    const MdsDataTaCustomerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_ta_customer",
    };
    const MdsDataTaCustomerTableRef = `${MdsDataTaCustomerTable.database}.${MdsDataTaCustomerTable.schema}.${MdsDataTaCustomerTable.name}`;
}

SELECT
  ${databuffet.functionData.cleanString("companyID")} AS company_id,
  ${databuffet.functionData.cleanString("CustomerCode")} AS customer_code,
  ${databuffet.functionData.cleanString("DepartmentID")} AS department_id,
  SharePercent AS share_percent,
  StartDate AS valid_from,
  IFNULL(EndDate, DATE '2066-12-31') AS valid_to,
  ${databuffet.functionData.cleanString("CustomerName")} AS customer_name,
  id AS source_row_id
FROM `${MdsDataTaCustomerTableRef}`
WHERE is_active = TRUE

pre_operations {
}

post_operations {
}
