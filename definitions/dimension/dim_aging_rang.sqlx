config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_aging_rang_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimAgingRangTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimAgingRangTableRef = `${DimAgingRangTable.database}.${DimAgingRangTable.schema}.${DimAgingRangTable.name}`;




    const stableDimensionColumns = ['AgingRangSK', 'CompanySK', 'companyID', 'AgingDayMin', 'AgingDayMax', 'ReportName', 'MdsId'];
    const stableDimensionKeyColumns = ['companyID', 'AgingDayMin', 'AgingDayMax'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableNaturalKeyMatch = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionLookupCondition = stableNaturalKeyMatch;
    const stableDimensionMergeCondition = 'T.`AgingRangSK` = S.`AgingRangSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'AgingRangSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");
}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
      CAST(NULL AS INT64) AS AgingRangSK,
      dim_com.CompanySK,
      ${databuffet.functionData.cleanString("t1.companyID")} AS companyID,
      ${databuffet.functionData.castInt64("t1.AgingDayMin")} AS AgingDayMin,
      ${databuffet.functionData.castInt64("t1.AgingDayMax")} AS AgingDayMax,
      ${databuffet.functionData.cleanString("t1.ReportName")} AS ReportName,
      ${databuffet.functionData.cleanString("t1.id")} AS MdsId
    FROM `${MdsSourceTableRef}` AS t1
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON ${databuffet.functionData.cleanString("t1.companyID")} = dim_com.companyID
    WHERE t1.is_active = TRUE
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimAgingRangTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    WHERE MdsId IS NOT NULL
    GROUP BY MdsId
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang source MDS identity must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimAgingRangTableRef}`
    WHERE MdsId IS NOT NULL
    GROUP BY MdsId
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang target MDS identity must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    JOIN `${DimAgingRangTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
    GROUP BY TO_JSON_STRING(STRUCT(source_row.MdsId, source_row.companyID, source_row.AgingDayMin, source_row.AgingDayMax))
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang source must match at most one target row';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimAgingRangTableRef}`
    WHERE AgingRangSK IS NULL
  ) AS 'dim_aging_rang target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimAgingRangTableRef}`
    GROUP BY AgingRangSK
    HAVING COUNT(*) > 1
  ) AS 'dim_aging_rang target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(AgingRangSK)
    FROM `${DimAgingRangTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`AgingRangSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `AgingRangSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`AgingRangSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`AgingRangSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimAgingRangTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimAgingRangTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
