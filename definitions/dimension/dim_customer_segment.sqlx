config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimCustomerSegmentTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimCustomerSegmentTableRef = `${DimCustomerSegmentTable.database}.${DimCustomerSegmentTable.schema}.${DimCustomerSegmentTable.name}`;

    const stableDimensionColumns = ['CustomerSegmentSK', 'CompanySK', 'CompanyID', 'Segment1', 'Segment2', 'Segment3', 'DescriptionThai', 'DescriptionEng', 'SortOrder', 'MdsID'];
    const stableDimensionKeyColumns = ['CompanyID', 'Segment3'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`CustomerSegmentSK` = S.`CustomerSegmentSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'CustomerSegmentSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_customer_segment_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
}



BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    WITH segment_master AS (
      SELECT
        ROW_NUMBER() OVER(
          ORDER BY
            ${databuffet.functionData.cleanString("t1.companyID")},
            ${databuffet.functionData.cleanString("t1.Segment3")}
        ) AS CustomerSegmentSK,
        dim_com.CompanySK,
        ${databuffet.functionData.cleanString("t1.companyID")} AS CompanyID,
        ${databuffet.functionData.cleanString("t1.Segment1")} AS Segment1,
        ${databuffet.functionData.cleanString("t1.Segment2")} AS Segment2,
        ${databuffet.functionData.cleanString("t1.Segment3")} AS Segment3,
        ${databuffet.functionData.cleanString("t1.DescriptionThai")} AS DescriptionThai,
        ${databuffet.functionData.cleanString("t1.DescriptionEng")} AS DescriptionEng,
        ${databuffet.functionData.castInt64("t1.SortOrder")} AS SortOrder,
        ${databuffet.functionData.cleanString("t1.id")} AS MdsID
      FROM `${MdsSourceTableRef}` AS t1
      LEFT JOIN `${DimCompanyTableRef}` AS dim_com
        ON ${databuffet.functionData.cleanString("t1.companyID")} = dim_com.companyID
      WHERE t1.is_active = TRUE

    ), non_segment AS (
      -- สงวน SK -1 ให้แถวกลางที่ไม่ผูกบริษัท เพื่อให้ dim_customer_report_info มีสมาชิกอ้างอิงเมื่อ join ไม่เจอ
      SELECT
        -1                    AS CustomerSegmentSK,
        CAST(NULL AS INT64)   AS CompanySK,
        CAST(NULL AS STRING)  AS CompanyID,
        'Non-Segment'         AS Segment1,
        'Non-Segment'         AS Segment2,
        'Non-Segment'         AS Segment3,
        'Non-Segment'         AS DescriptionThai,
        'Non-Segment'         AS DescriptionEng,
        99                    AS SortOrder,
        CAST(NULL AS STRING)  AS MdsID
    )

    SELECT * FROM segment_master
    UNION ALL
    SELECT * FROM non_segment
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_customer_segment source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimCustomerSegmentTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_customer_segment target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimCustomerSegmentTableRef}`
    WHERE `CustomerSegmentSK` IS NULL
  ) AS 'dim_customer_segment target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimCustomerSegmentTableRef}`
    GROUP BY `CustomerSegmentSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_customer_segment target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`CustomerSegmentSK`)
    FROM `${DimCustomerSegmentTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`CustomerSegmentSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `CustomerSegmentSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`CustomerSegmentSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`CustomerSegmentSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimCustomerSegmentTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimCustomerSegmentTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
