config {
    type: "operations",
  hasOutput: true,
    schema: databuffet.DIMENSION_TABLE,
    dependencies: [
                    "dim_company", "dim_director"
                ],
    tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimDirectorTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_director",
    };
    const DimDirectorTableRef = `${DimDirectorTable.database}.${DimDirectorTable.schema}.${DimDirectorTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimDirectorLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimDirectorLastTableRef = `${DimDirectorLastTable.database}.${DimDirectorLastTable.schema}.${DimDirectorLastTable.name}`;




    const stableDimensionColumns = ['DirectorSK', 'CompanySK', 'companyID', 'DirectorID', 'DirectorName', 'DirectorOfSalesID', 'DirectorOfSalesName', 'StartDate', 'EndDate'];
    const stableDimensionKeyColumns = ['companyID', 'DirectorID', 'StartDate', 'EndDate'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`DirectorSK` = S.`DirectorSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'DirectorSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY dim_com.CompanySK, t1.DirectorID) AS DirectorSK,
        dim_com.CompanySK,
        dim_com.companyID,
        t1.DirectorID,
        t1.DirectorName,
        t1.DirectorOfSalesID,
        t1.DirectorOfSalesName,
        t1.StartDate,
        t1.EndDate,
      FROM (
        SELECT
          *
        FROM `${DimDirectorTableRef}`
        QUALIFY ROW_NUMBER() OVER (PARTITION BY CompanyID, DirectorID ORDER BY EndDate DESC, StartDate DESC) = 1
      ) as t1
      LEFT JOIN `${DimCompanyTableRef}` as dim_com
        on t1.CompanyID = dim_com.CompanyID
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_director_last source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimDirectorLastTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_director_last target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimDirectorLastTableRef}`
    WHERE `DirectorSK` IS NULL
  ) AS 'dim_director_last target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimDirectorLastTableRef}`
    GROUP BY `DirectorSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_director_last target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`DirectorSK`)
    FROM `${DimDirectorLastTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`DirectorSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `DirectorSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`DirectorSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`DirectorSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimDirectorLastTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimDirectorLastTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
