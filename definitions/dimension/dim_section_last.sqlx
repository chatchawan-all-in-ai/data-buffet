config {
    type: "operations",
  hasOutput: true,
    schema: databuffet.DIMENSION_TABLE,
    dependencies: [
                    "dim_company", "dim_section"
                ],
    tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimSectionTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_section",
    };
    const DimSectionTableRef = `${DimSectionTable.database}.${DimSectionTable.schema}.${DimSectionTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimSectionLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimSectionLastTableRef = `${DimSectionLastTable.database}.${DimSectionLastTable.schema}.${DimSectionLastTable.name}`;




    const stableDimensionColumns = ['SectionSK', 'SectionManagerSK', 'RegionSK', 'RegionManagerSK', 'DirectorSK', 'CompanySK', 'companyID', 'SectionID', 'SectionName', 'StartDate', 'EndDate'];
    const stableDimensionKeyColumns = ['companyID', 'SectionID', 'StartDate', 'EndDate'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`SectionSK` = S.`SectionSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'SectionSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY dim_com.CompanySK, t1.SectionID) AS SectionSK,
        NULL AS SectionManagerSK,
        NULL AS RegionSK,
        NULL AS RegionManagerSK,
        NULL AS DirectorSK,
        dim_com.CompanySK,
        dim_com.companyID,
        t1.SectionID,
        t1.SectionName,
        t1.StartDate,
        t1.EndDate,
      FROM (
        SELECT
          *
        FROM `${DimSectionTableRef}`
        QUALIFY ROW_NUMBER() OVER (PARTITION BY CompanyID, SectionID ORDER BY EndDate DESC, StartDate DESC) = 1
      ) as t1
      LEFT JOIN `${DimCompanyTableRef}` as dim_com
        on t1.CompanyID = dim_com.CompanyID
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_section_last source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSectionLastTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_section_last target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSectionLastTableRef}`
    WHERE `SectionSK` IS NULL
  ) AS 'dim_section_last target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSectionLastTableRef}`
    GROUP BY `SectionSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_section_last target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`SectionSK`)
    FROM `${DimSectionLastTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`SectionSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `SectionSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`SectionSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`SectionSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimSectionLastTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimSectionLastTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
