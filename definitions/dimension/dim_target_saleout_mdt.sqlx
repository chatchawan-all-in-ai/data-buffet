config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_sales_branch_mdt","dim_product_mkt"],
  tags: [databuffet.TAG_DIM_DAILY, databuffet.TAG_SALEOUT_DAILY],
  uniqueKey: ["TargetSaleoutMdtSK"],
  bigquery: {
    partitionBy: "TargetDate",
    clusterBy: ["BranchMdtSK", "MarketingGroupID","ProductMktSK"],
  },
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_mdt_sales_target_by_product_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;
    const DimSalesBranchMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sales_branch_mdt",
    };
    const DimSalesBranchMdtTableRef = `${DimSalesBranchMdtTable.database}.${DimSalesBranchMdtTable.schema}.${DimSalesBranchMdtTable.name}`;




}

WITH monthly AS (
  SELECT
    ${databuffet.functionData.castInt64("t1.year")} AS TargetYear,
    ${databuffet.functionData.castInt64("t1.month")} AS TargetMonth,
    DATE(${databuffet.functionData.castInt64("t1.year")}, ${databuffet.functionData.castInt64("t1.month")}, 1) AS MonthStart,
    ${databuffet.functionData.cleanString("t1.branch_code")}      AS BranchCodeMdt,
    ${databuffet.functionData.cleanString("t1.marketinggroupid")} AS MarketingGroupID,
    ${databuffet.functionData.cleanString("t1.marketinggroup")}   AS MarketingGroupName,
    ${databuffet.functionData.cleanString("t1.submarketingid")}   AS SubMarketingID,
    ${databuffet.functionData.cleanString("t1.submarketing")}     AS SubMarketingName,
    ${databuffet.functionData.cleanString("t1.segmentid")}        AS SegmentID,
    ${databuffet.functionData.cleanString("t1.segment")}          AS SegmentName,
    t1.value AS MonthAmt,
    t1.Quantity AS MonthQty,
    t1.id AS MdsID
  FROM `${MdsSourceTableRef}` AS t1
  WHERE t1.is_active = TRUE
    AND t1.year IS NOT NULL
    AND t1.month IS NOT NULL
  -- กันเป้าซ้ำต่อ (สาขา, กลุ่ม, ชั้นย่อย, เซกเมนต์, ปี, เดือน) — เก็บแถวที่แก้ล่าสุด
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY TRIM(t1.branch_code), TRIM(t1.marketinggroupid),
                 TRIM(t1.submarketingid), TRIM(t1.segmentid),
                 ${databuffet.functionData.castInt64("t1.year")}, ${databuffet.functionData.castInt64("t1.month")}
    ORDER BY t1.updated_at DESC, t1.id
  ) = 1

), daily AS (
  SELECT
    m.*,
    d AS TargetDate,
    DATE_DIFF(DATE_ADD(m.MonthStart, INTERVAL 1 MONTH), m.MonthStart, DAY) AS DaysInMonth
  FROM monthly AS m
  CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(m.MonthStart, LAST_DAY(m.MonthStart))) AS d

  ), product_mkt_lookup AS (
  -- ต้องกรอง CompanyID ไม่งั้น 1 ชุดชี้ 2 SK เพราะมี 2 บริษัท · MDT เป็นของ ag01 ทั้งช่องทาง
  SELECT ProductMktSK, MarketingGroupID, SubMarketingID, SegmentID
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01'
  -- กัน fan-out เผื่อวันหน้าต้นทางมีชุดซ้ำ สาขาจะได้ไม่บวมเงียบ ๆ
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY MarketingGroupID, SubMarketingID, SegmentID ORDER BY CompanyID, TypeMarketingID, MarketingGroupID, SubMarketingID, SegmentID
  ) = 1

), target_master AS (
  SELECT
    ROW_NUMBER() OVER(
      ORDER BY d.TargetDate, d.BranchCodeMdt, d.MarketingGroupID,
               d.SubMarketingID, d.SegmentID
    ) AS TargetSaleoutMdtSK,
    IFNULL(dim_br.BranchMdtSK, -1) AS BranchMdtSK,
    IFNULL(dim_mkt.ProductMktSK, -1) AS ProductMktSK,
    dim_br.StoreCode,
    d.BranchCodeMdt,
    d.MarketingGroupID,
    d.MarketingGroupName,
    d.SubMarketingID,
    d.SubMarketingName,
    d.SegmentID,
    d.SegmentName,
    d.TargetDate,
    d.TargetYear,
    d.TargetMonth,
    d.DaysInMonth,
    d.MonthAmt / d.DaysInMonth AS Amt,
    d.MonthQty / d.DaysInMonth AS Qty,
    d.MdsID
  FROM daily AS d
  LEFT JOIN `${DimSalesBranchMdtTableRef}` AS dim_br
    ON IF(STARTS_WITH(d.BranchCodeMdt, 'GH_'),
          CONCAT('GB_', SUBSTR(d.BranchCodeMdt, 4)),
          d.BranchCodeMdt) = dim_br.BranchCodeMdt
  LEFT JOIN product_mkt_lookup AS dim_mkt
    ON  d.MarketingGroupID = dim_mkt.MarketingGroupID
      AND d.SubMarketingID   = dim_mkt.SubMarketingID
      AND d.SegmentID        = dim_mkt.SegmentID

), unknown_target AS (
  SELECT
    -1                    AS TargetSaleoutMdtSK,
    -1                    AS BranchMdtSK,
    -1                    AS ProductMktSK,
    'NotStore'            AS StoreCode,
    'NotBranch'           AS BranchCodeMdt,
    'NotGroup'            AS MarketingGroupID,
    'ไม่ระบุกลุ่มสินค้า'         AS MarketingGroupName,
    'NotSubGroup'         AS SubMarketingID,
    'ไม่ระบุกลุ่มย่อย'          AS SubMarketingName,
    'NotSegment'          AS SegmentID,
    'ไม่ระบุเซกเมนต์'          AS SegmentName,
    CAST(NULL AS DATE)    AS TargetDate,
    CAST(NULL AS INT64)   AS TargetYear,
    CAST(NULL AS INT64)   AS TargetMonth,
    CAST(NULL AS INT64)   AS DaysInMonth,
    CAST(NULL AS FLOAT64) AS Amt,
    CAST(NULL AS FLOAT64) AS Qty,
    CAST(NULL AS STRING)  AS MdsID
)

SELECT * FROM target_master
UNION ALL
SELECT * FROM unknown_target

pre_operations {}

post_operations {}
