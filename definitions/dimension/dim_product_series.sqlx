config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["SeriesSK"],
  bigquery: {
    clusterBy: ["SeriesSK"],
  },
}

-- ponytail: rows hardcoded from BI's dim_product_series.xlsx (2026-10-02) — move to mds_dataset once BI loads it there
SELECT
  ROW_NUMBER() OVER(ORDER BY t1.SeriesCode) AS SeriesSK,
  t1.SeriesCode,
  t1.SeriesName
FROM UNNEST([
  STRUCT('100001' AS SeriesCode, 'TITAN' AS SeriesName),
  ('999999', 'OTHERS')
]) AS t1


pre_operations {}

post_operations {}
