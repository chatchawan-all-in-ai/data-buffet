config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  tags: [databuffet.TAG_DIM_DAILY, databuffet.TAG_SALEOUT_DAILY],
  uniqueKey: ["SeriesSK"],
  bigquery: {
    clusterBy: ["SeriesSK"],
  },
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_mdt_product_series_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
}

SELECT
  ROW_NUMBER() OVER(ORDER BY NULLIF(CAST(TRIM(t1.SeriesCode) AS STRING), '')) AS SeriesSK,

  NULLIF(CAST(TRIM(t1.SeriesCode) AS STRING), '') AS SeriesCode,
  NULLIF(CAST(TRIM(t1.SeriesName) AS STRING), '') AS SeriesName,
  t1.id                                           AS MdsID,
FROM `${MdsSourceTableRef}` AS t1
WHERE t1.is_active = TRUE
-- กัน series ซ้ำที่รหัส ถ้าซ้ำแล้วเป้าใน dim_target_series_mdt จะคูณตาม — เก็บแถวที่แก้ล่าสุด
QUALIFY ROW_NUMBER() OVER(
  PARTITION BY TRIM(t1.SeriesCode)
  ORDER BY t1.updated_at DESC, t1.id
) = 1

pre_operations {}

post_operations {}
