config {
    type: "operations",
  hasOutput: true,
    schema: databuffet.DIMENSION_TABLE,
    dependencies: [ 
                    "dim_company", "dim_sale_representative"
                  ],
    tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimSaleRepresentativeLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimSaleRepresentativeLastTableRef = `${DimSaleRepresentativeLastTable.database}.${DimSaleRepresentativeLastTable.schema}.${DimSaleRepresentativeLastTable.name}`;

    const stableDimensionColumns = ['SaleRepSK', 'DepartmentSK', 'SectionSK', 'SectionManagerSK', 'RegionSK', 'RegionManagerSK', 'DirectorSK', 'CompanySK', 'companyID', 'DepartmentID', 'EmployeeID', 'EmployeeName', 'EmployeeSurname', 'EmployeeNickname', 'DepCode', 'CostChannelID', 'ProvinceID', 'ChangeSectionFlag', 'CustomerFlag', 'StartDate', 'EndDate', 'OrderStartDate', 'OrderEndDate'];
    const stableDimensionKeyColumns = ['companyID', 'DepartmentID', 'EmployeeID', 'DepCode', 'CostChannelID', 'ProvinceID', 'StartDate', 'EndDate', 'OrderStartDate', 'OrderEndDate', 'CustomerFlag'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`SaleRepSK` = S.`SaleRepSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'SaleRepSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");


    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const DimSaleRepTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sale_representative",
    };
    const DimSaleRepTableRef = `${DimSaleRepTable.database}.${DimSaleRepTable.schema}.${DimSaleRepTable.name}`;

}


BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    WITH stable_main_source AS (
    with raw as (
        SELECT
            -- ROW_NUMBER() OVER (ORDER BY dim_com.CompanySK, t1.DepartmentID, t1.EmployeeID, t1.DepCode, t1.CostChannelID, t1.ProvinceID) AS SaleRepSK,
            NULL AS DepartmentSK,
            NULL AS SectionSK,
            NULL AS SectionManagerSK,
            NULL AS RegionSK,
            NULL AS RegionManagerSK,
            NULL AS DirectorSK,
            dim_com.CompanySK,
            dim_com.companyID,

            t1.DepartmentID,
            t1.EmployeeID,
            t1.EmployeeName,
            t1.EmployeeSurname,
            t1.EmployeeNickname,
            t1.DepCode,
            t1.CostChannelID,
            t1.ProvinceID,
            t1.ChangeSectionFlag,
            t1.CustomerFlag,
            t1.StartDate,
            t1.EndDate,
            t1.OrderStartDate,
            t1.OrderEndDate,
        FROM (
            SELECT *
            FROM `${DimSaleRepTableRef}`
            -- WHERE CURRENT_DATE('Asia/Bangkok') between StartDate and EndDate
            WHERE DepartmentID is not null
            QUALIFY ROW_NUMBER() OVER (PARTITION BY CompanyID, DepartmentID, EmployeeID, DepCode, CostChannelID, ProvinceID, OrderStartDate, OrderEndDate ORDER BY EndDate DESC, StartDate DESC) = 1
        ) as t1
        LEFT JOIN `${DimCompanyTableRef}` as dim_com
            on t1.CompanyID = dim_com.CompanyID

    ), agg_normal as (
      SELECT *
      FROM raw
      WHERE DepCode is null
        and CostChannelID is null
        and ProvinceID is null
        and ChangeSectionFlag is null
        and OrderStartDate is null
      QUALIFY ROW_NUMBER() OVER (PARTITION BY CompanyID, EmployeeID, OrderStartDate, OrderEndDate ORDER BY EndDate DESC, StartDate DESC) = 1

    ), final as (
      SELECT *
      FROM raw
      WHERE OrderStartDate is not null
        OR NOT EXISTS (select 1 from agg_normal as ag where raw.CompanyID = ag.CompanyID and raw.EmployeeID = ag.EmployeeID)
      UNION ALL
      SELECT *
      FROM agg_normal

    )
      SELECT
        ROW_NUMBER() OVER (ORDER BY CompanySK, DepartmentID, EmployeeID, DepCode, CostChannelID, ProvinceID) AS SaleRepSK,
        *
      FROM final
    ), raw_per AS (
      SELECT DISTINCT
        company_id,
        percode AS EmployeeID,
        TRIM(REGEXP_REPLACE(pernamet, r'\s+', ' ')) AS pernamet
      FROM ${ref(databuffet.VALIDATED_MAC5, 'per')}
    )
    SELECT * FROM stable_main_source
    UNION ALL
    SELECT
      CAST(NULL AS INT64) AS SaleRepSK,
      CAST(NULL AS INT64) AS DepartmentSK,
      CAST(NULL AS INT64) AS SectionSK,
      CAST(NULL AS INT64) AS SectionManagerSK,
      CAST(NULL AS INT64) AS RegionSK,
      CAST(NULL AS INT64) AS RegionManagerSK,
      CAST(NULL AS INT64) AS DirectorSK,
      dim_com.CompanySK,
      dim_com.companyID,
      CAST(NULL AS STRING) AS DepartmentID,
      per.EmployeeID,
      REGEXP_EXTRACT(per.pernamet, r'^([^\s]+)') AS EmployeeName,
      REGEXP_EXTRACT(per.pernamet, r'\s([^\s(]+)') AS EmployeeSurname,
      REGEXP_EXTRACT(per.pernamet, r'\((.*?)\)') AS EmployeeNickname,
      CAST(NULL AS STRING) AS DepCode,
      CAST(NULL AS STRING) AS CostChannelID,
      CAST(NULL AS STRING) AS ProvinceID,
      CAST(NULL AS STRING) AS ChangeSectionFlag,
      CAST(NULL AS STRING) AS CustomerFlag,
      CAST(NULL AS DATE) AS StartDate,
      CAST(NULL AS DATE) AS EndDate,
      CAST(NULL AS DATE) AS OrderStartDate,
      CAST(NULL AS DATE) AS OrderEndDate
    FROM raw_per AS per
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON per.company_id = dim_com.companyID
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative_last source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeLastTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative_last target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeLastTableRef}`
    WHERE `SaleRepSK` IS NULL
  ) AS 'dim_sale_representative_last target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeLastTableRef}`
    GROUP BY `SaleRepSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative_last target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`SaleRepSK`)
    FROM `${DimSaleRepresentativeLastTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`SaleRepSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `SaleRepSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`SaleRepSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`SaleRepSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimSaleRepresentativeLastTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimSaleRepresentativeLastTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;

END;
