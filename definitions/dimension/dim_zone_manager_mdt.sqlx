config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_zone_mdt"],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ZoneManagerMdtSK"],
  bigquery: {
    clusterBy: ["ZoneManagerMdtSK"],
  },
}

/*
  ผู้จัดการโซนของช่องทาง MDT — ต้นทาง mds_data_sales_zone_manager_master ตารางเดียว
  แยกออกจาก dim_zone_mdt เมื่อ 2026-09-11 ตามรีวิว
  (เดิมถูก LEFT JOIN เข้าไปแปะ 4 คอลัมน์อยู่ใน dim_zone_mdt)

  ⚠️ ต้นทางมี 0 แถว (ตรวจ 2026-09-11) ตารางนี้จึงมีแต่แถว -1 ไปก่อน
  ไฟล์ต้นฉบับ Excel ชีท Zone มีชื่อผู้จัดการครบทั้ง 15 โซน ต้องแจ้งคนดูแล mds ให้นำเข้า
  (โซน CEN ไม่มี employee_id ในไฟล์ต้นฉบับ)

  1 แถว = 1 แถวของ mds คือการมอบหมาย (โซน x ผู้จัดการ) ไม่ใช่ตัวคน
  เกรนนี้รองรับทั้งกรณี 1 โซนมีผู้จัดการหลายคน และ 1 คนดูแลหลายโซน
  วัดเกรนจริงไม่ได้ตอนนี้เพราะยังไม่มีข้อมูล ถ้าเข้ามาแล้วพบว่า 1 โซน = 1 คนเสมอ
  ก็ยังใช้ได้ ไม่ต้องแก้

  เก็บทุกคอลัมน์ของ MDS ครบ ไม่ตัดอะไรออก รวมคอลัมน์กำกับการแก้ไข
  (Version / CreatedAt / CreatedBy / UpdatedAt / UpdatedBy / IsActive)

  เก็บ ZoneMdtSK ไว้ในตัวเอง เพื่อให้คนที่ต้องการผู้จัดการโซนไม่ต้อง join
  dim_zone_mdt อีกทอด (แนวเดียวกับ dim_sales_branch_mdt ที่เก็บ ZoneMdtSK)
  ZoneName ก็มาจากต้นทางเองอยู่แล้ว ไม่ได้ดึงจาก dim_zone_mdt

  ยังไม่มี fact หรือ view ไหนใช้ตารางนี้

  ponytail: SK ปั้นด้วย ROW_NUMBER สร้างใหม่ทุกคืน ยังไม่มี consumer ที่เก็บ SK นี้ไว้
  ถ้าวันหน้ามี fact ที่เก็บ ZoneManagerMdtSK ข้ามเดือน ต้องเปลี่ยนมาใช้ MERGE ก่อน
*/

js {
    const ZoneManagerSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_zone_manager_master`;

    const DimZoneMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_zone_mdt",
    };
    const DimZoneMdtTableRef = `${DimZoneMdtTable.database}.${DimZoneMdtTable.schema}.${DimZoneMdtTable.name}`;
}

WITH zone_manager_master AS (
  SELECT
    ROW_NUMBER() OVER(
      ORDER BY ${databuffet.functionData.cleanString("t1.zone_id")},
               ${databuffet.functionData.cleanString("t1.zonemanageremployeeid")}
    ) AS ZoneManagerMdtSK,
    IFNULL(dim_zone.ZoneMdtSK, -1) AS ZoneMdtSK,

    -- คอลัมน์ธุรกิจ
    ${databuffet.functionData.cleanString("t1.zone_id")}   AS ZoneCode,
    ${databuffet.functionData.cleanString("t1.zone_name")} AS ZoneName,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeeid")}       AS EmployeeID,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeename")}     AS EmployeeName,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeesurname")}  AS EmployeeSurname,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeenickname")} AS EmployeeNickname,
    t1.start_date AS StartDate,
    t1.end_date   AS EndDate,

    -- คอลัมน์กำกับการแก้ไขจาก MDS (เก็บครบตามที่ตกลง)
    t1.is_active  AS IsActive,
    t1.version    AS Version,
    t1.created_at AS CreatedAt,
    ${databuffet.functionData.cleanString("t1.created_by")} AS CreatedBy,
    t1.updated_at AS UpdatedAt,
    ${databuffet.functionData.cleanString("t1.updated_by")} AS UpdatedBy,

    ${databuffet.functionData.cleanString("t1.id")} AS MdsID
  FROM `${ZoneManagerSourceRef}` AS t1
  LEFT JOIN `${DimZoneMdtTableRef}` AS dim_zone
    ON ${databuffet.functionData.cleanString("t1.zone_id")} = dim_zone.ZoneCode
  WHERE t1.is_active = TRUE

), unknown_zone_manager AS (
  SELECT
    -1                      AS ZoneManagerMdtSK,
    -1                      AS ZoneMdtSK,

    CAST(NULL AS STRING)    AS ZoneCode,
    CAST(NULL AS STRING)    AS ZoneName,
    CAST(NULL AS STRING)    AS EmployeeID,
    'ไม่ระบุผู้จัดการโซน'         AS EmployeeName,
    CAST(NULL AS STRING)    AS EmployeeSurname,
    CAST(NULL AS STRING)    AS EmployeeNickname,
    CAST(NULL AS DATE)      AS StartDate,
    CAST(NULL AS DATE)      AS EndDate,

    CAST(NULL AS BOOL)      AS IsActive,
    CAST(NULL AS INT64)     AS Version,
    CAST(NULL AS TIMESTAMP) AS CreatedAt,
    CAST(NULL AS STRING)    AS CreatedBy,
    CAST(NULL AS TIMESTAMP) AS UpdatedAt,
    CAST(NULL AS STRING)    AS UpdatedBy,

    CAST(NULL AS STRING)    AS MdsID
)

SELECT * FROM zone_manager_master
UNION ALL
SELECT * FROM unknown_zone_manager

pre_operations {}

post_operations {}
