config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_zone_mdt"],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ZoneManagerMdtSK"],
  bigquery: {
    clusterBy: ["ZoneManagerMdtSK"],
  },
}

/*
  ผู้จัดการโซนของช่องทาง MDT — 1 แถว = 1 โซน (15 โซน + แถว -1)
  แยกออกจาก dim_zone_mdt เมื่อ 2026-09-11 ตามรีวิว
  (เดิมถูก LEFT JOIN เข้าไปแปะ 4 คอลัมน์อยู่ใน dim_zone_mdt)

  ⚠️ ขับตารางนี้จาก dim_zone_mdt ไม่ใช่จาก mds_data_sales_zone_manager_master
  เพราะต้นทางผู้จัดการยังว่าง 0 แถว (ตรวจ 2026-09-11 14:58 · ตารางสร้าง 09-08 ไม่ถูกแตะเลย)
  ถ้าขับจากต้นทางผู้จัดการ ตารางนี้จะมีแต่แถว -1 และ dim_sales_branch_mdt
  จะได้ ZoneManagerMdtSK = -1 ทั้ง 494 สาขา
  ขับจากโซนแทน ทำให้ได้โครงครบ 15 โซนตั้งแต่วันนี้ สาขาจับ SK ได้จริง
  แล้วชื่อผู้จัดการค่อยเติมเข้ามาเองคืนที่ mds นำเข้าข้อมูล — ไม่ต้องกลับมาแก้โค้ด

  เกรน 1 แถว = 1 โซน ตามที่เจ้าของ mds ยืนยัน (2026-09-10) ว่าตอนนี้
  zone_manager_master เกรนเท่ากับ zone_master และ join ด้วย zone_id ได้ตรง ๆ
  QUALIFY ใน mgr_src กันไว้เผื่อวันหน้าโซนหนึ่งมีผู้จัดการหลายคน — ไม่งั้นโซนจะบวม
  ถ้าวันนั้นมาถึงต้องตัดสินใจใหม่ว่าจะเก็บเป็นตารางมอบหมาย (โซน x คน) หรือเลือกคนเดียว

  ZoneCode / ZoneName เอาจาก dim_zone_mdt ไม่เอาจากต้นทางผู้จัดการ
  เพื่อให้มีที่มาที่เดียว และเพราะต้นทางยังไม่มีข้อมูลให้ใช้

  ⚠️ โซน CEN ไม่มี employee_id ในไฟล์ Excel ต้นฉบับ ต้องถามว่าจะใส่อะไรแทน

  ไม่เก็บ MdsID และคอลัมน์กำกับการแก้ไข (ผู้ใช้ตัดสิน 2026-09-11) เหลือ 10 คอลัมน์
  ให้เหมือน dim_zone_mdt / dim_pc / dim_sales_branch_mdt
  ⚠️ ผลข้างเคียงของการขับจากโซน: นับแถวเทียบกับ mds ตรง ๆ ไม่ได้แล้ว
     ตารางนี้เท่ากับจำนวนโซน ไม่ใช่จำนวนแถวในตารางผู้จัดการ

  consumer: dim_sales_branch_mdt เก็บ ZoneManagerMdtSK ไว้ในตัว (2026-09-11)
  join ด้วย ZoneCode แบบเดียวกับ dim_zone_mdt

  ponytail: SK ปั้นด้วย ROW_NUMBER สร้างใหม่ทุกคืน ใช้ได้เพราะ dim_sales_branch_mdt
  rebuild ทุกคืนเหมือนกัน
  ถ้าวันหน้ามี fact ที่เก็บ ZoneManagerMdtSK ข้ามเดือน ต้องเปลี่ยนมาใช้ MERGE ก่อน
*/

js {
    const ZoneManagerSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_zone_manager_master`;

    const DimZoneMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_zone_mdt",
    };
    const DimZoneMdtTableRef = `${DimZoneMdtTable.database}.${DimZoneMdtTable.schema}.${DimZoneMdtTable.name}`;
}

WITH mgr_src AS (
  -- 1 แถวต่อ 1 โซน — QUALIFY กันไว้เผื่อวันหน้าโซนหนึ่งมีผู้จัดการหลายคน
  -- ไม่งั้น LEFT JOIN ข้างล่างจะทำให้โซนบวมตามจำนวนผู้จัดการแบบเงียบ ๆ
  SELECT
    ${databuffet.functionData.cleanString("t1.zone_id")}                     AS ZoneCode,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeeid")}       AS EmployeeID,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeename")}     AS EmployeeName,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeesurname")}  AS EmployeeSurname,
    ${databuffet.functionData.cleanString("t1.zonemanageremployeenickname")} AS EmployeeNickname,
    t1.start_date AS StartDate,
    t1.end_date   AS EndDate
  FROM `${ZoneManagerSourceRef}` AS t1
  WHERE t1.is_active = TRUE
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY ${databuffet.functionData.cleanString("t1.zone_id")}
    ORDER BY ${databuffet.functionData.cleanString("t1.zonemanageremployeeid")}
  ) = 1

), zone_manager_master AS (
  SELECT
    ROW_NUMBER() OVER(ORDER BY z.ZoneCode) AS ZoneManagerMdtSK,
    z.ZoneMdtSK,
    z.ZoneCode,
    z.ZoneName,
    mgr.EmployeeID,
    mgr.EmployeeName,
    mgr.EmployeeSurname,
    mgr.EmployeeNickname,
    mgr.StartDate,
    mgr.EndDate
  FROM `${DimZoneMdtTableRef}` AS z
  LEFT JOIN mgr_src AS mgr
    ON z.ZoneCode = mgr.ZoneCode
  -- ตัดแถว -1 ของ dim_zone_mdt ออก ไม่งั้นจะซ้ำกับ unknown_zone_manager ข้างล่าง
  WHERE z.ZoneMdtSK <> -1

), unknown_zone_manager AS (
  SELECT
    -1                      AS ZoneManagerMdtSK,
    -1                      AS ZoneMdtSK,

    CAST(NULL AS STRING)    AS ZoneCode,
    CAST(NULL AS STRING)    AS ZoneName,
    CAST(NULL AS STRING)    AS EmployeeID,
    'ไม่ระบุผู้จัดการโซน'         AS EmployeeName,
    CAST(NULL AS STRING)    AS EmployeeSurname,
    CAST(NULL AS STRING)    AS EmployeeNickname,
    CAST(NULL AS DATE)      AS StartDate,
    CAST(NULL AS DATE)      AS EndDate
)

SELECT * FROM zone_manager_master
UNION ALL
SELECT * FROM unknown_zone_manager

pre_operations {}

post_operations {}
