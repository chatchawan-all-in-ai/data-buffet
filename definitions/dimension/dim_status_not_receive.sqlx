config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_payment_status_not_receive_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const DimStatusNotReceiveTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimStatusNotReceiveTableRef = `${DimStatusNotReceiveTable.database}.${DimStatusNotReceiveTable.schema}.${DimStatusNotReceiveTable.name}`;




    const stableDimensionColumns = ['NotReceiveSK', 'CompanyID', 'StatusID', 'StatusNameTH', 'StatusNameENG', 'MdsID'];
    const stableDimensionKeyColumns = ['CompanyID', 'StatusID'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`NotReceiveSK` = S.`NotReceiveSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'NotReceiveSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");


}



BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
      ROW_NUMBER() OVER(
        ORDER BY
          ${databuffet.functionData.cleanString("t1.CompanyID")},
          ${databuffet.functionData.castInt64("t1.StatusID")}
      ) AS NotReceiveSK,
      ${databuffet.functionData.cleanString("t1.CompanyID")} AS CompanyID,
      ${databuffet.functionData.castInt64("t1.StatusID")} AS StatusID,
      ${databuffet.functionData.cleanString("t1.StatusNameTH")} AS StatusNameTH,
      ${databuffet.functionData.cleanString("t1.StatusNameENG")} AS StatusNameENG,
      ${databuffet.functionData.cleanString("t1.id")} as MdsID
    FROM `${MdsSourceTableRef}` AS t1
    WHERE t1.is_active = TRUE
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_status_not_receive source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimStatusNotReceiveTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_status_not_receive target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimStatusNotReceiveTableRef}`
    WHERE `NotReceiveSK` IS NULL
  ) AS 'dim_status_not_receive target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimStatusNotReceiveTableRef}`
    GROUP BY `NotReceiveSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_status_not_receive target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`NotReceiveSK`)
    FROM `${DimStatusNotReceiveTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`NotReceiveSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `NotReceiveSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`NotReceiveSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`NotReceiveSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimStatusNotReceiveTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimStatusNotReceiveTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
