config {
  // SK เสถียร (2026-10-28): MERGE + max_sk แบบ dim_customer — ตารางต้องมีอยู่แล้วใน BigQuery ห้าม rebuild ใหม่
  // (clusterBy CustomerReportInfoSK ติดมากับตารางเดิม)
  type: "operations",
  // ชุดเล็กสุด: update_sk_sale_rep_group รันหลัง *_last ทั้งหมด (รวม dim_department_last, dim_sale_representative_last, dim_company)
  // ตารางหลัง view (กฎ Run order): view_dim_invoice อ่าน dim_aging (ครอบ dim_invoice, dim_customer), dim_order, mec ตรง ๆ
  // · view_dim_customer อ่าน dim_group_customer · view_deb_address_data อ่าน deb_address_data
  dependencies: ["update_sk_sale_rep_group", "dim_customer_segment", "dim_aging", "dim_order", "dim_group_customer", "mec", "deb_address_data"],
  tags: [databuffet.TAG_DIM_DAILY],
  hasOutput: true
}

js {
    const DimCustomerReportInfoTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimCustomerReportInfoTableRef = `${DimCustomerReportInfoTable.database}.${DimCustomerReportInfoTable.schema}.${DimCustomerReportInfoTable.name}`;
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_customer_report_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const ViewDimInvoiceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_VIEW,
        name: "view_dim_invoice",
    };
    const ViewDimInvoiceTableRef = `${ViewDimInvoiceTable.database}.${ViewDimInvoiceTable.schema}.${ViewDimInvoiceTable.name}`;
    const ViewDimCustomerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_VIEW,
        name: "view_dim_customer",
    };
    const ViewDimCustomerTableRef = `${ViewDimCustomerTable.database}.${ViewDimCustomerTable.schema}.${ViewDimCustomerTable.name}`;
    const CleanCompanyPrefixTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FUNCTION_DATASET,
        name: "clean_company_prefix",
    };
    const CleanCompanyPrefixTableRef = `${CleanCompanyPrefixTable.database}.${CleanCompanyPrefixTable.schema}.${CleanCompanyPrefixTable.name}`;
    const DimSaleRepresentativeLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sale_representative_last",
    };
    const DimSaleRepresentativeLastTableRef = `${DimSaleRepresentativeLastTable.database}.${DimSaleRepresentativeLastTable.schema}.${DimSaleRepresentativeLastTable.name}`;
    const DimDepartmentLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_department_last",
    };
    const DimDepartmentLastTableRef = `${DimDepartmentLastTable.database}.${DimDepartmentLastTable.schema}.${DimDepartmentLastTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const ViewDebAddressDataTable = {
        database: databuffet.DATABASE,
        schema: databuffet.PROCESS_DATASET,
        name: "view_deb_address_data",
    };
    const ViewDebAddressDataTableRef = `${ViewDebAddressDataTable.database}.${ViewDebAddressDataTable.schema}.${ViewDebAddressDataTable.name}`;
    const DimCustomerSegmentTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_customer_segment",
    };
    const DimCustomerSegmentTableRef = `${DimCustomerSegmentTable.database}.${DimCustomerSegmentTable.schema}.${DimCustomerSegmentTable.name}`;





    // ชื่อของรหัสลูกค้า สูตรเดียวกับ CustomerReportName ใน view_dim_invoice (ไม่รวมสาขา SCG/CRC)
    const CodeNameExpr = `IF(IFNULL(cust.FlagMDSNickName, FALSE), cust.NicknameCustomer, \`${CleanCompanyPrefixTableRef}\`(cust.debnamet))`;
}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;
  -- ไม่นับแถวสงวน -1
  SET max_sk = (SELECT IFNULL(MAX(CustomerReportInfoSK), 0) FROM `${DimCustomerReportInfoTableRef}` WHERE CustomerReportInfoSK <> -1);

  -- ชื่อเดิม (CompanyID + CustomerReportKey) คง SK และอัปเดตคอลัมน์อื่น · ชื่อใหม่ได้ max_sk + ROW_NUMBER
  -- ชื่อที่หายจาก source (MDS inactive และไม่มี invoice) ไม่ลบ — แถวเดิมคงอยู่
  MERGE `${DimCustomerReportInfoTableRef}` AS T
  USING (
with mds as (
  SELECT
    ${databuffet.functionData.cleanString("t1.companyID")} AS CompanyID,
    ${databuffet.functionData.cleanString("t1.CustomerReportName")} AS CustomerReportName,
    -- key ไม่สนช่องว่าง ใช้ join กับ CustomerReportName ของ invoice
    REGEXP_REPLACE(${databuffet.functionData.cleanString("t1.CustomerReportName")}, r'\s', '') AS CustomerReportKey,
    UPPER(${databuffet.functionData.cleanString("t1.CustomerTier")}) AS CustomerTier,
    t1.FlagPC,
    ${databuffet.functionData.cleanString("t1.ShopOnline")} AS ShopOnline,
    ${databuffet.functionData.castFloat64("t1.OnlinePercent")} AS OnlinePercent,
    ${databuffet.functionData.cleanString("t1.id")} AS MdsID
  FROM `${MdsSourceTableRef}` AS t1
  WHERE t1.is_active = TRUE
  -- ชื่อที่ต่างกันแค่ช่องว่างต้องเหลือแถวเดียว ไม่งั้น join แล้วแถว fact ซ้ำ
  QUALIFY ROW_NUMBER() OVER(PARTITION BY CompanyID, CustomerReportKey ORDER BY t1.updated_at DESC, t1.id) = 1

), inv_rows as (
  -- ทุกชื่อร้านใน invoice ให้ relationship ใน Power BI ครบทุกแถว ไม่ใช่แค่ชื่อใน MDS
  -- dependencies ประกาศเป็นตารางที่อยู่หลัง view_dim_invoice (กฎ Run order ใน view-layer.md)
  SELECT
    inv.companyID AS CompanyID,
    REGEXP_REPLACE(${databuffet.functionData.cleanString("inv.CustomerReportName")}, r'\s', '') AS CustomerReportKey,
    ${databuffet.functionData.cleanString("inv.CustomerReportName")} AS CustomerReportName,
    ${databuffet.functionData.cleanString("inv.mihCus")} AS mihCus,
    inv.mix_date,
    inv.mihVnos,
    -- พนักงานผู้ขาย + แผนกของบิล ใช้เลือก TA ภาคของพนักงาน MDT (mdt_slot)
    inv.mihPer,
    TRIM(inv.mihDep) AS mihDep,
    inv.mihCancel
  FROM `${ViewDimInvoiceTableRef}` AS inv
  WHERE ${databuffet.functionData.cleanString("inv.CustomerReportName")} IS NOT NULL

), inv as (
  -- ชื่อที่ต่างกันแค่ช่องว่าง ใช้ตัวสะกดที่มี invoice มากสุด
  SELECT CompanyID, CustomerReportKey, CustomerReportName
  FROM inv_rows
  GROUP BY 1, 2, 3
  QUALIFY ROW_NUMBER() OVER(PARTITION BY CompanyID, CustomerReportKey ORDER BY COUNT(*) DESC, CustomerReportName) = 1

), inv_cus as (
  -- ลูกค้าของบิลล่าสุด ใช้หา channel เมื่อชื่อไม่อยู่ใน MDS (ชื่อเดียวมีหลาย debcode ได้)
  SELECT CompanyID, CustomerReportKey, mihCus AS debcode
  FROM inv_rows
  QUALIFY ROW_NUMBER() OVER(PARTITION BY CompanyID, CustomerReportKey ORDER BY mix_date DESC, mihVnos DESC) = 1

), ta_cus as (
  -- รหัสที่ใช้หา TA: เฉพาะรหัสที่ชื่อของตัวเองตรงกับชื่อรายงาน (สูตรชื่อเดียวกับ view_dim_invoice:
  -- Prefer MDS nicknames; invoice customer codes recover TA when no direct match exists.
  SELECT r.CompanyID, r.CustomerReportKey, r.mihCus AS debcode
  FROM inv_rows AS r
  JOIN `${ViewDimCustomerTableRef}` AS cust
    ON r.CompanyID = cust.companyID
    AND r.mihCus = cust.debcode
  WHERE REGEXP_REPLACE(${databuffet.functionData.cleanString(CodeNameExpr)}, r'\s', '') = r.CustomerReportKey
  QUALIFY ROW_NUMBER() OVER(PARTITION BY r.CompanyID, r.CustomerReportKey ORDER BY r.mix_date DESC, r.mihVnos DESC) = 1

), rep_cur as (
  -- แถว TA ที่ใช้ได้วันนี้และไม่ใช่ Dummy ของพนักงานทุกคน (ปกติ + MDT)
  SELECT sr.companyID, sr.EmployeeID, sr.DepartmentSK, sr.DepartmentID, sr.DepCode
  FROM `${DimSaleRepresentativeLastTableRef}` AS sr
  JOIN `${DimDepartmentLastTableRef}` AS dep
    ON sr.CompanySK = dep.CompanySK
    AND sr.DepartmentSK = dep.DepartmentSK
  WHERE sr.DepartmentID IS NOT NULL
    AND IFNULL(sr.StartDate <= CURRENT_DATE('Asia/Bangkok'), TRUE)
    AND IFNULL(sr.EndDate >= CURRENT_DATE('Asia/Bangkok'), TRUE)
    AND NOT STARTS_WITH(LOWER(dep.DepartmentID), 'dummy')
    AND IFNULL(dep.EndDate >= CURRENT_DATE('Asia/Bangkok'), TRUE)

), mdt_emp as (
  -- ห้ามใช้จำนวน TA หลังกรองวันตัดสิน MDT: เชนที่หมดอายุอาจทำให้พนักงาน MDT ดูเหมือนมี TA เดียว
  -- ตรวจแถว non-Dummy ทั้งปัจจุบันและหมดอายุของบริษัท + พนักงาน ก่อนเลือก TA ที่ใช้ได้วันนี้
  SELECT DISTINCT history.companyID, history.EmployeeID
  FROM `${DimSaleRepresentativeLastTableRef}` AS history
  WHERE history.DepartmentID IS NOT NULL
    AND NOT STARTS_WITH(LOWER(history.DepartmentID), 'dummy')
    AND (history.CostChannelID IS NOT NULL OR history.DepCode IS NOT NULL)

), rep_ta as (
  -- TA ของพนักงานปกติ = rep_cur ที่ไม่ใช่พนักงาน MDT
  SELECT r.companyID, r.EmployeeID, r.DepartmentSK
  FROM rep_cur AS r
  WHERE NOT EXISTS (
    SELECT 1
    FROM mdt_emp AS m
    WHERE m.companyID = r.companyID
      AND m.EmployeeID = r.EmployeeID
  )

), deb_ta as (
  -- deb.debsalesp -> TA; พนักงานที่มีหลาย TA ที่ใช้ได้วันนี้ = ไม่ให้ TA
  SELECT deb.company_id, deb.debcode, deb.debsalesp,
    IF(COUNT(DISTINCT r.DepartmentSK) = 1, ANY_VALUE(r.DepartmentSK), NULL) AS DepartmentSK
  FROM ${ref(databuffet.VALIDATED_MAC5, "deb")} AS deb
  LEFT JOIN rep_ta AS r
    ON deb.company_id = r.companyID
    AND deb.debsalesp = r.EmployeeID
  GROUP BY 1, 2, 3

), mdt_cand as (
  -- พนักงาน MDT: เชนจาก deb.debgroup (กฎเดียวกับ view_fact_transcation) แล้วตัวเลือก = TA ปัจจุบันในเชนนั้น
  SELECT d.company_id, d.debcode, d.debsalesp, r.DepartmentSK, r.DepCode
  FROM (
    SELECT deb.company_id, deb.debcode, deb.debsalesp,
      (CASE
        WHEN deb.debgroup IN ('HP', 'HPEXPO') THEN 'hp'
        WHEN deb.debgroup IN ('TW', 'TWEXPO') THEN 'tw'
        WHEN deb.debgroup IN ('BT', 'BT.C') THEN 'bt'
        WHEN deb.debgroup IN ('GB') THEN 'gb'
        WHEN deb.debgroup IN ('MH') THEN 'mh'
        WHEN deb.debgroup IN ('DOHOME') THEN 'dh'
      END) AS chain
    FROM ${ref(databuffet.VALIDATED_MAC5, "deb")} AS deb
    JOIN mdt_emp AS m
      ON deb.company_id = m.companyID
      AND deb.debsalesp = m.EmployeeID
  ) AS d
  JOIN rep_cur AS r
    ON d.company_id = r.companyID
    AND d.debsalesp = r.EmployeeID
    AND STARTS_WITH(LOWER(r.DepartmentID), d.chain || '_')

), mdt_slot as (
  -- หลาย TA ในเชน (แยกภาคด้วย DepCode): ใช้ mihDep ของบิลล่าสุดที่พนักงานคนนี้ขายให้ร้านนี้ (ชื่อรายงานเดียวกับ ta_cus)
  -- ที่ตรงกับ DepCode ของตัวเลือก · ไม่มีบิลตรง = ว่าง
  SELECT c.company_id, c.debcode, c.DepartmentSK
  FROM mdt_cand AS c
  JOIN ta_cus AS tc
    ON c.company_id = tc.CompanyID
    AND c.debcode = tc.debcode
  JOIN inv_rows AS i
    ON tc.CompanyID = i.CompanyID
    AND tc.CustomerReportKey = i.CustomerReportKey
    AND c.debsalesp = i.mihPer
    AND i.mihDep IN UNNEST(SPLIT(REPLACE(c.DepCode, ' ', ''), '|'))
    AND IFNULL(i.mihCancel, 0) <> -1
  QUALIFY ROW_NUMBER() OVER(PARTITION BY c.company_id, c.debcode ORDER BY i.mix_date DESC, i.mihVnos DESC, (SELECT dep.DepartmentID FROM `${DimDepartmentLastTableRef}` AS dep WHERE dep.DepartmentSK = c.DepartmentSK)) = 1

), mdt_ta as (
  -- TA เดียวในเชน ใช้ตัวนั้น · หลาย TA ใช้ mdt_slot · ไม่มีตัวเลือก / debgroup ไม่ใช่เชน = ว่าง
  SELECT c.company_id, c.debcode,
    IF(COUNT(DISTINCT c.DepartmentSK) = 1, ANY_VALUE(c.DepartmentSK), ANY_VALUE(slot.DepartmentSK)) AS DepartmentSK
  FROM mdt_cand AS c
  LEFT JOIN mdt_slot AS slot
    ON c.company_id = slot.company_id
    AND c.debcode = slot.debcode
  GROUP BY 1, 2

), cust_channel as (
  -- กรอง channel ที่รู้จักก่อนเลือกแถวล่าสุด; channel ว่าง/นอก allowlist ไม่แทนที่แถวเก่า
  SELECT q.company_id, q.debcode, q.channel, deb.debdate
  FROM (
    SELECT company_id, TRIM(SPLIT(agent1, ' ')[SAFE_OFFSET(0)]) AS debcode, channel
    FROM ${ref(databuffet.VALIDATED_MAC5, "tbook_quotation")}
    WHERE channel IN ('TT', 'DC', 'DA', 'DG', 'DD', 'DT', 'DR')
      AND NULLIF(TRIM(agent1), '') IS NOT NULL
    QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, TRIM(SPLIT(agent1, ' ')[SAFE_OFFSET(0)]) ORDER BY dinsert DESC, SAFE_CAST(id AS INT64) DESC) = 1
  ) AS q
  LEFT JOIN ${ref(databuffet.VALIDATED_MAC5, "deb")} AS deb
    ON q.company_id = deb.company_id
    AND q.debcode = deb.debcode

), all_names as (
  SELECT
    COALESCE(mds.CompanyID, inv.CompanyID) AS CompanyID,
    COALESCE(mds.CustomerReportKey, inv.CustomerReportKey) AS CustomerReportKey,
    -- ตัวสะกดจาก invoice ก่อน (ผ่าน MDS rename แล้ว) ให้ตรงกับ view_dim_invoice · ร้านที่ไม่มีบิลใช้ชื่อ MDS
    COALESCE(inv.CustomerReportName, mds.CustomerReportName) AS CustomerReportName,
    mds.CustomerTier,
    mds.FlagPC,
    mds.ShopOnline,
    mds.OnlinePercent,
    mds.MdsID
  FROM mds
  FULL OUTER JOIN inv
    ON mds.CompanyID = inv.CompanyID
    AND mds.CustomerReportKey = inv.CustomerReportKey

), with_segment as (
  SELECT
    t.*,
    cus.debcode AS SegmentDebcode,
    ch.channel AS SegmentChannel,
    -- Tier ที่ระบุแต่ไม่มีใน master ไม่ลอง channel เพื่อคงลำดับ fallback เดิม
    (CASE
      WHEN t.CustomerTier IS NOT NULL THEN t.CustomerTier
      WHEN ch.channel = 'TT'
        THEN IF(DATE_TRUNC(DATE(ch.debdate), MONTH) = DATE_TRUNC(CURRENT_DATE('Asia/Bangkok'), MONTH), 'BRONZE', 'SILVER')
      ELSE ch.channel
    END) AS SegmentCode
  FROM all_names AS t
  LEFT JOIN inv_cus AS cus
    ON t.CompanyID = cus.CompanyID
    AND t.CustomerReportKey = cus.CustomerReportKey
  LEFT JOIN cust_channel AS ch
    ON cus.CompanyID = ch.company_id
    AND cus.debcode = ch.debcode

), with_ta_code as (
  -- TA: debsalesp ของรหัสใน ta_cus (พนักงานปกติ) แล้วจึงเชนของพนักงาน MDT · ไม่อ่าน TA จาก MDS (ตัด 2026-10-09)
  SELECT
    t.*,
    dim_com.CompanySK,
    COALESCE(dta.DepartmentSK, mdt.DepartmentSK) AS TADepartmentSK,
    (CASE
      WHEN dta.DepartmentSK IS NOT NULL THEN 'DEBSALESP'
      WHEN mdt.DepartmentSK IS NOT NULL THEN 'MDT'
    END) AS TASource,
    -- รหัสที่ใช้หา TA เก็บไว้ตรวจร้านที่ TA ว่าง
    tc.debcode AS TADebcode,
    -- พนักงาน: debsalesp ของรหัสที่ใช้หา TA
    dta.debsalesp AS TAEmployeeID
  FROM with_segment AS t
  LEFT JOIN `${DimCompanyTableRef}` AS dim_com
    ON t.CompanyID = dim_com.companyID
  LEFT JOIN ta_cus AS tc
    ON t.CompanyID = tc.CompanyID
    AND t.CustomerReportKey = tc.CustomerReportKey
  LEFT JOIN deb_ta AS dta
    ON tc.CompanyID = dta.company_id
    AND tc.debcode = dta.debcode
  LEFT JOIN mdt_ta AS mdt
    ON tc.CompanyID = mdt.company_id
    AND tc.debcode = mdt.debcode

), with_ta as (
  SELECT
    t.*,
    sr.SaleRepSK
  FROM with_ta_code AS t
  LEFT JOIN (
    SELECT CompanySK, EmployeeID, SaleRepSK
    FROM `${DimSaleRepresentativeLastTableRef}`
    QUALIFY ROW_NUMBER() OVER(PARTITION BY CompanySK, EmployeeID
      ORDER BY IF(EmployeeName IS NOT NULL, 0, 1), (CASE WHEN DepartmentID IS NULL THEN 1 ELSE 0 END), CompanySK, DepartmentID, EmployeeID, DepCode, CostChannelID, ProvinceID) = 1
  ) AS sr
    ON t.CompanySK = sr.CompanySK
    AND t.TAEmployeeID = sr.EmployeeID

), deb_address as (
  -- ที่อยู่ของรหัสลูกค้า (แบบเดียวกับ Invoice*SK ใน dim_customer) · view คืนได้หลายแถวต่อรหัส
  -- (ชื่อตำบลซ้ำใน dim_sub_districts) เลือกแถวเดียว: sub_districts > districts > provinces แล้ว SK น้อยสุด
  SELECT company_id, debcode, ProvinceSK, DistrictSK, SubDistrictSK
  FROM `${ViewDebAddressDataTableRef}`
  QUALIFY ROW_NUMBER() OVER(PARTITION BY company_id, debcode
    ORDER BY (CASE condition WHEN 'sub_districts' THEN 1 WHEN 'districts' THEN 2 ELSE 3 END),
      SubDistrictSK, DistrictSK, ProvinceSK) = 1

), with_address as (
  -- รหัสลูกค้าของร้าน = รหัสที่ใช้หา segment ถ้าไม่มีใช้รหัสที่ใช้หา TA · credit term จาก deb · ที่อยู่จาก deb_address
  SELECT
    t.*,
    deb.DEBcreditTerm,
    addr.ProvinceSK AS InvoiceProvinceSK,
    addr.DistrictSK AS InvoiceDistrictSK,
    addr.SubDistrictSK AS InvoiceSubDistrictSK
  FROM (
    SELECT *, COALESCE(SegmentDebcode, TADebcode) AS ReportDebcode
    FROM with_ta
  ) AS t
  LEFT JOIN ${ref(databuffet.VALIDATED_MAC5, "deb")} AS deb
    ON t.CompanyID = deb.company_id
    AND t.ReportDebcode = deb.debcode
  LEFT JOIN deb_address AS addr
    ON t.CompanyID = addr.company_id
    AND t.ReportDebcode = addr.debcode
), source_data as (
SELECT
  t.CompanySK,
  -- คง DC fallback เดิม; ใช้ Non-Segment เฉพาะเมื่อ join ไม่เจอทั้ง segment และ DC
  COALESCE(seg.CustomerSegmentSK, seg_dc.CustomerSegmentSK, -1) AS CustomerSegmentSK,
  t.CompanyID,
  t.CustomerReportName,
  -- key ที่ใช้ match ชื่อเดิม (ชื่อตัด whitespace ทั้งหมด)
  t.CustomerReportKey,
  t.FlagPC,
  t.ShopOnline,
  t.OnlinePercent,
  (CASE
    WHEN seg.CustomerSegmentSK IS NOT NULL AND t.CustomerTier IS NOT NULL THEN 'MDS'
    WHEN seg.CustomerSegmentSK IS NOT NULL THEN 'CHANNEL'
    ELSE 'DEFAULT'
  END) AS SegmentSource,
  t.SegmentDebcode,
  t.SegmentChannel,
  t.MdsID,
  -- TA chain เป็น SK ของ dim_department_last แถวที่เลือก (ตามที่ update_sk_sale_rep_group ตั้งไว้) · NULL เมื่อไม่มี TA
  dep.DepartmentSK,
  dep.SectionSK,
  dep.RegionSK,
  dep.SectionManagerSK,
  dep.RegionManagerSK,
  dep.DirectorSK,
  t.TASource,
  -- รหัสลูกค้าที่ใช้หา TA และพนักงาน (SK) · ชื่อ/รหัสพนักงานอยู่ใน view_dim_customer_report_info
  t.TADebcode,
  t.SaleRepSK,
  -- รหัสลูกค้าของร้าน + credit term + ที่อยู่ (SK) · ชื่อตำบล/อำเภอ/จังหวัดอยู่ใน view_dim_customer_report_info
  t.ReportDebcode,
  t.DEBcreditTerm,
  t.InvoiceProvinceSK,
  t.InvoiceDistrictSK,
  t.InvoiceSubDistrictSK
FROM with_address AS t
LEFT JOIN `${DimDepartmentLastTableRef}` AS dep
  ON t.CompanySK = dep.CompanySK
  AND t.TADepartmentSK = dep.DepartmentSK
LEFT JOIN `${DimCustomerSegmentTableRef}` AS seg
  ON t.CompanySK = seg.CompanySK
  AND t.SegmentCode = seg.Segment3
LEFT JOIN `${DimCustomerSegmentTableRef}` AS seg_dc
  ON t.CompanySK = seg_dc.CompanySK
  AND seg_dc.Segment3 = 'DC'
)
SELECT
  (CASE
    WHEN t2.CustomerReportInfoSK IS NOT NULL THEN t2.CustomerReportInfoSK
    ELSE max_sk + ROW_NUMBER() OVER(
      PARTITION BY (CASE WHEN t2.CustomerReportInfoSK IS NULL THEN 1 ELSE 0 END)
      ORDER BY t1.CompanyID, t1.CustomerReportKey)
  END) AS CustomerReportInfoSK,
  t1.*
FROM source_data AS t1
LEFT JOIN `${DimCustomerReportInfoTableRef}` AS t2
  ON t1.CompanyID = t2.CompanyID
  AND t1.CustomerReportKey = t2.CustomerReportKey

  ) AS S
  ON T.CompanyID = S.CompanyID
  AND T.CustomerReportKey = S.CustomerReportKey

  WHEN MATCHED THEN
    -- ทุกคอลัมน์ยกเว้น SK และ key
    UPDATE SET
      CompanySK = S.CompanySK,
      CustomerSegmentSK = S.CustomerSegmentSK,
      CustomerReportName = S.CustomerReportName,
      FlagPC = S.FlagPC,
      ShopOnline = S.ShopOnline,
      OnlinePercent = S.OnlinePercent,
      SegmentSource = S.SegmentSource,
      SegmentDebcode = S.SegmentDebcode,
      SegmentChannel = S.SegmentChannel,
      MdsID = S.MdsID,
      DepartmentSK = S.DepartmentSK,
      SectionSK = S.SectionSK,
      RegionSK = S.RegionSK,
      SectionManagerSK = S.SectionManagerSK,
      RegionManagerSK = S.RegionManagerSK,
      DirectorSK = S.DirectorSK,
      TASource = S.TASource,
      TADebcode = S.TADebcode,
      SaleRepSK = S.SaleRepSK,
      ReportDebcode = S.ReportDebcode,
      DEBcreditTerm = S.DEBcreditTerm,
      InvoiceProvinceSK = S.InvoiceProvinceSK,
      InvoiceDistrictSK = S.InvoiceDistrictSK,
      InvoiceSubDistrictSK = S.InvoiceSubDistrictSK

  WHEN NOT MATCHED THEN
    INSERT (
      CustomerReportInfoSK, CompanySK, CustomerSegmentSK, CompanyID, CustomerReportName, CustomerReportKey, FlagPC, ShopOnline, OnlinePercent, SegmentSource, SegmentDebcode, SegmentChannel, MdsID, DepartmentSK, SectionSK, RegionSK, SectionManagerSK, RegionManagerSK, DirectorSK, TASource, TADebcode, SaleRepSK, ReportDebcode, DEBcreditTerm, InvoiceProvinceSK, InvoiceDistrictSK, InvoiceSubDistrictSK
    )
    VALUES (
      S.CustomerReportInfoSK, S.CompanySK, S.CustomerSegmentSK, S.CompanyID, S.CustomerReportName, S.CustomerReportKey, S.FlagPC, S.ShopOnline, S.OnlinePercent, S.SegmentSource, S.SegmentDebcode, S.SegmentChannel, S.MdsID, S.DepartmentSK, S.SectionSK, S.RegionSK, S.SectionManagerSK, S.RegionManagerSK, S.DirectorSK, S.TASource, S.TADebcode, S.SaleRepSK, S.ReportDebcode, S.DEBcreditTerm, S.InvoiceProvinceSK, S.InvoiceDistrictSK, S.InvoiceSubDistrictSK
    );

  -- แถวสงวน SK -1: view_fact_transcation ใส่ -1 ให้บิลจริงที่ชื่อร้าน join ไม่เจอ (ชื่อว่าง/รหัสลูกค้าไม่อยู่ใน deb)
  -- Keep unmatched blank-name rows outside the merge so they do not duplicate or advance max_sk.
  INSERT INTO `${DimCustomerReportInfoTableRef}` (CustomerReportInfoSK, CustomerSegmentSK, SegmentSource)
  SELECT -1, -1, 'DEFAULT'
  FROM (SELECT 1)
  WHERE NOT EXISTS (
    SELECT 1 FROM `${DimCustomerReportInfoTableRef}` WHERE CustomerReportInfoSK = -1
  );
END;
