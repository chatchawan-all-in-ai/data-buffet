config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const DimRegionManagerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimRegionManagerTableRef = `${DimRegionManagerTable.database}.${DimRegionManagerTable.schema}.${DimRegionManagerTable.name}`;

    const stableDimensionColumns = ['RegionManagerSK', 'CompanySK', 'companyID', 'RegionID', 'SubRegionID', 'RegionName', 'RegionManagerEmployeeID', 'RegionManagerName', 'RegionManagerSurname', 'RegionManagerNickname', 'StartDate', 'EndDate', 'MdsID'];
    const stableDimensionKeyColumns = ['companyID', 'RegionID', 'SubRegionID', 'StartDate', 'EndDate'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`RegionManagerSK` = S.`RegionManagerSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'RegionManagerSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_sales_region_manager_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
}



BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
      ROW_NUMBER() OVER(
        ORDER BY
          ${databuffet.functionData.cleanString("t1.companyID")},
          ${databuffet.functionData.cleanString("t1.RegionID")},
          ${databuffet.functionData.cleanString("t1.SubRegionID")},
          t1.StartDate,
          t1.EndDate
      ) AS RegionManagerSK,
      dim_com.CompanySK,
      ${databuffet.functionData.cleanString("t1.companyID")} AS companyID,
      ${databuffet.functionData.cleanString("t1.RegionID")} AS RegionID,
      ${databuffet.functionData.cleanString("t1.SubRegionID")} AS SubRegionID,
      ${databuffet.functionData.cleanString("t1.RegionName")} AS RegionName,
      ${databuffet.functionData.cleanString("t1.RegionManagerEmployeeID")} AS RegionManagerEmployeeID,
      ${databuffet.functionData.cleanString("t1.RegionManagerName")} AS RegionManagerName,
      ${databuffet.functionData.cleanString("t1.RegionManagerSurname")} AS RegionManagerSurname,
      ${databuffet.functionData.cleanString("t1.RegionManagerNickname")} AS RegionManagerNickname,
      t1.StartDate AS StartDate,
      t1.EndDate AS EndDate,
      ${databuffet.functionData.cleanString("t1.id")} as MdsID
    FROM `${MdsSourceTableRef}` AS t1
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON ${databuffet.functionData.cleanString("t1.companyID")} = dim_com.companyID
    WHERE t1.is_active = TRUE
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_region_manager source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimRegionManagerTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_region_manager target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimRegionManagerTableRef}`
    WHERE `RegionManagerSK` IS NULL
  ) AS 'dim_region_manager target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimRegionManagerTableRef}`
    GROUP BY `RegionManagerSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_region_manager target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`RegionManagerSK`)
    FROM `${DimRegionManagerTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`RegionManagerSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `RegionManagerSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`RegionManagerSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`RegionManagerSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimRegionManagerTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimRegionManagerTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
