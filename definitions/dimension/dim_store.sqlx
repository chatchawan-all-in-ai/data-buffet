config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["StoreSK"],
  bigquery: {
    clusterBy: ["StoreSK"],
  },
}

js {
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
}

-- คลังสินค้า/สาขา จาก master ของ MAC5 (validated_mac5.sto)
-- StoreGroup คือชั้นที่ใช้สไลซ์บนรายงาน (KK ขอนแก่น, LP ลำพูน, HY หาดใหญ่,
-- UB อุบลราชธานี, PK ภูเก็ต ฯลฯ) ส่วน StoreCode คือคลังรายตัวไว้ drill ลงไป
WITH sto_master AS (
  SELECT
    ROW_NUMBER() OVER(ORDER BY sto.company_id, sto.stocode) AS StoreSK,
    dim_com.CompanySK,
    sto.company_id AS companyID,
    sto.stocode    AS StoreCode,
    sto.stogroup   AS StoreGroup,
    sto.stodesct   AS StoreNameT,
    sto.stodesce   AS StoreNameE
  FROM ${ref(databuffet.VALIDATED_MAC5, "sto")} AS sto
  LEFT JOIN `${DimCompanyTableRef}` AS dim_com
    ON sto.company_id = dim_com.companyID
),

-- แถว Unknown รับรหัสคลังที่เป็น NULL หรือไม่มีใน sto
-- (วัด 2026-09-01: mil PS 8,410 แถว, mil IS 4 แถว, cps 36 แถว)
-- fact ใช้ IFNULL(StoreSK, -1) จึงไม่มีแถวไหนหายจากการ join
unknown_store AS (
  SELECT
    -1               AS StoreSK,
    CAST(NULL AS INT64)  AS CompanySK,
    CAST(NULL AS STRING) AS companyID,
    CAST(NULL AS STRING) AS StoreCode,
    CAST(NULL AS STRING) AS StoreGroup,
    'ไม่ระบุคลัง'      AS StoreNameT,
    'Unknown'        AS StoreNameE
)

SELECT * FROM sto_master
UNION ALL
SELECT * FROM unknown_store

pre_operations {}

post_operations {}
