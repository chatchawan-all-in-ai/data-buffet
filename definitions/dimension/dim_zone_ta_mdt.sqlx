config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_zone_mdt"],
  tags: [databuffet.TAG_DIM_DAILY, databuffet.TAG_SALEOUT_DAILY],
}

js {
    const DimZoneTaMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimZoneTaMdtTableRef = `${DimZoneTaMdtTable.database}.${DimZoneTaMdtTable.schema}.${DimZoneTaMdtTable.name}`;

    const stableDimensionColumns = ['ZoneTaMdtSK', 'ZoneMdtSK', 'ZoneCode', 'ZoneName', 'EmployeeID', 'EmployeeName', 'EmployeeSurname', 'EmployeeNickname', 'StartDate', 'EndDate', 'MdsID'];
    const stableDimensionKeyColumns = ['ZoneCode', 'EmployeeID', 'StartDate', 'EndDate'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`ZoneTaMdtSK` = S.`ZoneTaMdtSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'ZoneTaMdtSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_mdt_sales_zone_ta_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;

    const DimZoneMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_zone_mdt",
    };
    const DimZoneMdtTableRef = `${DimZoneMdtTable.database}.${DimZoneMdtTable.schema}.${DimZoneMdtTable.name}`;
}



BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    WITH zone_ta_master AS (
      SELECT
        ROW_NUMBER() OVER(
          ORDER BY NULLIF(CAST(TRIM(t1.zone_id) AS STRING), ''),
                   CAST(t1.zonetaemployeeid AS INT64)
        ) AS ZoneTaMdtSK,
        IFNULL(dim_zone.ZoneMdtSK, -1) AS ZoneMdtSK,

        NULLIF(CAST(TRIM(t1.zone_id) AS STRING), '')                     AS ZoneCode,
        NULLIF(CAST(TRIM(t1.zone_name) AS STRING), '')                   AS ZoneName,
        -- ต้นทางเป็น FLOAT64 → INT64 ก่อน STRING กัน ".0" ติดมา
        CAST(CAST(t1.zonetaemployeeid AS INT64) AS STRING) AS EmployeeID,
        NULLIF(CAST(TRIM(t1.zonetaemployeename) AS STRING), '')     AS EmployeeName,
        NULLIF(CAST(TRIM(t1.zonetaemployeesurname) AS STRING), '')  AS EmployeeSurname,
        NULLIF(CAST(TRIM(t1.zonetaemployeenickname) AS STRING), '') AS EmployeeNickname,
        t1.start_date AS StartDate,
        t1.end_date   AS EndDate,
        t1.id         AS MdsID
      FROM `${MdsSourceTableRef}` AS t1
      LEFT JOIN `${DimZoneMdtTableRef}` AS dim_zone
        ON NULLIF(CAST(TRIM(t1.zone_id) AS STRING), '') = dim_zone.ZoneCode
      WHERE t1.is_active = TRUE

    ), unknown_zone_ta AS  (
      SELECT
        -1                      AS ZoneTaMdtSK,
        -1                      AS ZoneMdtSK,

        'NotZone'               AS ZoneCode,
        'ไม่ระบุโซน'              AS ZoneName,
        'NotEmployee'           AS EmployeeID,
        'ไม่ระบุผู้จัดการโซน'         AS EmployeeName,
        CAST(NULL AS STRING)    AS EmployeeSurname,
        CAST(NULL AS STRING)    AS EmployeeNickname,
        CAST(NULL AS DATE)      AS StartDate,
        CAST(NULL AS DATE)      AS EndDate,
        CAST(NULL AS STRING)    AS MdsID
    )

    SELECT * FROM zone_ta_master
    UNION ALL
    SELECT * FROM unknown_zone_ta
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_zone_ta_mdt source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimZoneTaMdtTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_zone_ta_mdt target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimZoneTaMdtTableRef}`
    WHERE `ZoneTaMdtSK` IS NULL
  ) AS 'dim_zone_ta_mdt target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimZoneTaMdtTableRef}`
    GROUP BY `ZoneTaMdtSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_zone_ta_mdt target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`ZoneTaMdtSK`)
    FROM `${DimZoneTaMdtTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`ZoneTaMdtSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `ZoneTaMdtSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`ZoneTaMdtSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`ZoneTaMdtSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimZoneTaMdtTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimZoneTaMdtTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
