config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: [],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["StoreMdtSK"],
  bigquery: {
    clusterBy: ["StoreMdtSK"],
  },
}

/*
  ห้างค้าปลีก 6 แห่งในโปรเจกต์ Sales Out MDT — รายการคงที่ ไม่มีต้นทางเป็นไฟล์

  SK เขียนเป็นค่าคงที่ในโค้ด ไม่ใช้ ROW_NUMBER เพราะ fact เก็บ SK ข้ามเดือน
  ถ้าใช้ ROW_NUMBER แล้วมีการเพิ่ม/เรียงห้างใหม่ SK จะเลื่อน ข้อมูลย้อนหลังจะชี้ผิดห้าง
  (ต่างจาก dim ที่มาจาก mds ซึ่งสร้าง SK ใหม่ทุกวันได้ เพราะ consumer rebuild ทุกวัน)

  StoreMdtSK = -1 คือแถวไม่ระบุ — fact ใช้ LEFT JOIN + IFNULL(SK, -1) ห้าม INNER JOIN
  ปัจจุบันมี 4 แถวใน curated ที่ตกมาที่ -1 คือรหัส CS01 และ EX99 ของ HomePro
  ที่ไม่ใช่สาขาขายปลีก (81,716.50 บาท) — รอคำตอบว่าจะนับเป็นยอดขายหรือไม่

  DH (Dohome) ยังไม่มีไฟล์ส่งมา แต่ใส่ไว้ล่วงหน้าเพื่อให้ SK จองที่ไว้แล้ว
*/

SELECT * FROM UNNEST([
  STRUCT( 1 AS StoreMdtSK, 'HP' AS StoreCode, 'โฮมโปร'          AS StoreNameTH, 'HomePro'      AS StoreNameEN, TRUE  AS HasFeed),
  STRUCT( 2            , 'MH'              , 'เมกาโฮม'                        , 'Megahome'                  , TRUE            ),
  STRUCT( 3            , 'TW'              , 'ไทวัสดุ'                          , 'Thai Watsadu'              , TRUE            ),
  STRUCT( 4            , 'GH'              , 'โกลบอลเฮ้าส์'                     , 'Global House'              , TRUE            ),
  STRUCT( 5            , 'BT'              , 'บุญถาวร'                         , 'Boonthavorn'               , TRUE            ),
  STRUCT( 6            , 'DH'              , 'ดูโฮม'                           , 'Dohome'                    , FALSE           ),
  STRUCT(-1            , CAST(NULL AS STRING), 'ไม่ระบุ'                        , 'Unknown'                   , FALSE           )
])

pre_operations {}

post_operations {}
