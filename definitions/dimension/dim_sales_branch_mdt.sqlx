config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_zone_mdt", "dim_zone_manager_mdt", "dim_region_last", "dim_section_last"],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["BranchMdtSK"],
  bigquery: {
    clusterBy: ["BranchMdtSK"],
  },
}

js {
    const BranchSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_branch_master`;

    const DimZoneMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_zone_mdt",
    };
    const DimZoneMdtTableRef = `${DimZoneMdtTable.database}.${DimZoneMdtTable.schema}.${DimZoneMdtTable.name}`;

    const DimZoneManagerMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_zone_manager_mdt",
    };
    const DimZoneManagerMdtTableRef = `${DimZoneManagerMdtTable.database}.${DimZoneManagerMdtTable.schema}.${DimZoneManagerMdtTable.name}`;


        const DimSectionLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_section_last",
    };
    const DimSectionLastTableRef = `${DimSectionLastTable.database}.${DimSectionLastTable.schema}.${DimSectionLastTable.name}`;

    const DimRegionLastTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region_last",
    };
    const DimRegionLastTableRef = `${DimRegionLastTable.database}.${DimRegionLastTable.schema}.${DimRegionLastTable.name}`;

}


WITH section_lookup AS (
  -- 1 แถวต่อ SectionID — กัน fan-out เผื่อ dim มีรหัสซ้ำ
  SELECT SectionID, SectionSK, SectionManagerSK
  FROM `${DimSectionLastTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY SectionID ORDER BY SectionSK) = 1

), zone_manager_current AS (
  -- ตอนนี้ zone_manager เกรนเท่ากับ zone_master (1 แถว = 1 โซน) จึง join แบบเดียวกับ
  -- dim_zone_mdt ได้เลย  QUALIFY เป็นตัวกันไว้เผื่อวันหน้าโซนหนึ่งมีผู้จัดการหลายคน
  -- ไม่งั้นสาขาจะบวมตามจำนวนผู้จัดการแบบเงียบ ๆ
  SELECT ZoneManagerMdtSK, ZoneCode
  FROM `${DimZoneManagerMdtTableRef}`
  WHERE ZoneManagerMdtSK <> -1
  QUALIFY ROW_NUMBER() OVER(PARTITION BY ZoneCode ORDER BY ZoneManagerMdtSK) = 1

), branch_master AS (
  SELECT
    ROW_NUMBER() OVER(
      ORDER BY
        ${databuffet.functionData.cleanString("t1.region_id")},
        ${databuffet.functionData.cleanString("t1.store_id")}
    ) AS BranchMdtSK,
    IFNULL(dim_region.RegionSK, -1)           AS RegionSK,
    IFNULL(dim_region.RegionManagerSK, -1)    AS RegionManagerSK,
    IFNULL(dim_section.SectionSK, -1)         AS SectionSK,
    IFNULL(dim_section.SectionManagerSK, -1)  AS SectionManagerSK,
    IFNULL(dim_zone.ZoneMdtSK, -1)            AS ZoneMdtSK,
    IFNULL(dim_zone_mgr.ZoneManagerMdtSK, -1) AS ZoneManagerMdtSK,

    ${databuffet.functionData.cleanString("t1.region_id")}   AS StoreCode,
    dim_region.RegionName                                    AS RegionName,
    dim_region.SubRegionID                                   AS SubRegionID,
    ${databuffet.functionData.cleanString("t1.store_id")}    AS BranchCode,
    ${databuffet.functionData.cleanString("t1.branch_code")} AS BranchCodeMdt,
    ${databuffet.functionData.cleanString("t1.branch_name")} AS BranchName,
    ${databuffet.functionData.cleanString("t1.zone_id")}     AS ZoneCode,
    dim_zone.ZoneName                                        AS ZoneName,
    ${databuffet.functionData.cleanString("t1.warehouse")}   AS Warehouse,
    t1.start_date AS StartDate,
    t1.end_date   AS EndDate,
  FROM `${BranchSourceRef}` AS t1
  LEFT JOIN `${DimZoneMdtTableRef}` AS dim_zone
    ON ${databuffet.functionData.cleanString("t1.zone_id")} = dim_zone.ZoneCode
  -- ผู้จัดการโซน join ด้วย zone_id แบบเดียวกับ dim_zone_mdt
  LEFT JOIN zone_manager_current AS dim_zone_mgr
    ON ${databuffet.functionData.cleanString("t1.zone_id")} = dim_zone_mgr.ZoneCode
  -- dim_region_last มีแถวเดียวต่อรหัส จึง join ตรงได้ ไม่ต้องมี CTE กรองช่วงเวลา
    -- Section แกะจาก BranchCodeMdt ที่เราตั้งเอง (<ห้าง>_<Section>_<ลำดับ>)
  -- ต้องขัด 2 อย่างถึงจะตรงกับ dim_section_last: เติมศูนย์ และแปลง CEN
  LEFT JOIN section_lookup AS dim_section
    ON CONCAT(
         ${databuffet.functionData.cleanString("t1.region_id")}, '_',
         CASE
           WHEN REGEXP_EXTRACT(${databuffet.functionData.cleanString("t1.branch_code")}, r'^[A-Z]+_([A-Z0-9]+)_') = 'CEN' THEN ''
           WHEN REGEXP_CONTAINS(REGEXP_EXTRACT(${databuffet.functionData.cleanString("t1.branch_code")}, r'^[A-Z]+_([A-Z0-9]+)_'), r'^[A-Z][0-9]$')
             THEN CONCAT(
                    SUBSTR(REGEXP_EXTRACT(${databuffet.functionData.cleanString("t1.branch_code")}, r'^[A-Z]+_([A-Z0-9]+)_'), 1, 1), '0',
                    SUBSTR(REGEXP_EXTRACT(${databuffet.functionData.cleanString("t1.branch_code")}, r'^[A-Z]+_([A-Z0-9]+)_'), 2, 1))
           ELSE REGEXP_EXTRACT(${databuffet.functionData.cleanString("t1.branch_code")}, r'^[A-Z]+_([A-Z0-9]+)_')
         END
       ) = dim_section.SectionID
  LEFT JOIN `${DimRegionLastTableRef}` AS dim_region
    ON ${databuffet.functionData.cleanString("t1.region_id")} = dim_region.RegionID
   AND dim_region.companyID = 'ag01'
  WHERE t1.is_active = TRUE

), unknown_branch AS (
  SELECT
    -1                   AS BranchMdtSK,
    -1                   AS RegionSK,
    -1                   AS RegionManagerSK,
    -1                   AS SectionSK,
    -1                   AS SectionManagerSK,
    -1                   AS ZoneMdtSK,
    -1                   AS ZoneManagerMdtSK,

    CAST(NULL AS STRING) AS StoreCode,
    CAST(NULL AS STRING) AS RegionName,
    CAST(NULL AS STRING) AS SubRegionID,
    CAST(NULL AS STRING) AS BranchCode,
    CAST(NULL AS STRING) AS BranchCodeMdt,
    'ไม่ระบุสาขา'          AS BranchName,
    CAST(NULL AS STRING) AS ZoneCode,
    'ไม่ระบุโซน'           AS ZoneName,
    CAST(NULL AS STRING) AS Warehouse,
    CAST(NULL AS DATE)   AS StartDate,
    CAST(NULL AS DATE)   AS EndDate,
)

SELECT * FROM branch_master
UNION ALL
SELECT * FROM unknown_branch

pre_operations {}

post_operations {}
