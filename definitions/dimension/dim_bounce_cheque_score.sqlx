config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_custgrade_cheque_score_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimBounceChequeScoreTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimBounceChequeScoreTableRef = `${DimBounceChequeScoreTable.database}.${DimBounceChequeScoreTable.schema}.${DimBounceChequeScoreTable.name}`;




    const stableDimensionColumns = ['BounceChequeSK', 'CompanySK', 'companyID', 'BouncedChequeMin', 'BouncedChequeMax', 'Score', 'StartDate', 'EndDate', 'MdsID'];
    const stableDimensionKeyColumns = ['companyID', 'BouncedChequeMin', 'BouncedChequeMax', 'StartDate', 'EndDate'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`BounceChequeSK` = S.`BounceChequeSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'BounceChequeSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    SELECT
      ROW_NUMBER() OVER(
        ORDER BY
          ${databuffet.functionData.cleanString("t1.companyID")},
          ${databuffet.functionData.castFloat64("t1.BouncedChequeMin")},
          ${databuffet.functionData.castFloat64("t1.BouncedChequeMax")},
          t1.StartDate,
          t1.EndDate
      ) AS BounceChequeSK,
      dim_com.CompanySK,
      ${databuffet.functionData.cleanString("t1.companyID")} AS companyID,
      ${databuffet.functionData.castFloat64("t1.BouncedChequeMin")} AS BouncedChequeMin,
      ${databuffet.functionData.castFloat64("t1.BouncedChequeMax")} AS BouncedChequeMax,
      ${databuffet.functionData.castFloat64("t1.Score")} AS Score,
      t1.StartDate,
      t1.EndDate,
      ${databuffet.functionData.cleanString("t1.id")} as MdsID
    FROM `${MdsSourceTableRef}` AS t1
    LEFT JOIN `${DimCompanyTableRef}` AS dim_com
      ON ${databuffet.functionData.cleanString("t1.companyID")} = dim_com.companyID
    WHERE t1.is_active = TRUE
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_bounce_cheque_score source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimBounceChequeScoreTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_bounce_cheque_score target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimBounceChequeScoreTableRef}`
    WHERE `BounceChequeSK` IS NULL
  ) AS 'dim_bounce_cheque_score target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimBounceChequeScoreTableRef}`
    GROUP BY `BounceChequeSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_bounce_cheque_score target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`BounceChequeSK`)
    FROM `${DimBounceChequeScoreTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`BounceChequeSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `BounceChequeSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`BounceChequeSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`BounceChequeSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimBounceChequeScoreTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimBounceChequeScoreTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
