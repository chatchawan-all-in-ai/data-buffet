config {
  type: "operations",
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
  hasOutput: true
}

js {
    // Define table references
    const DimOrderTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(), // ใช้ชื่อไฟล์เป็นชื่อตาราง
    };
    const DimOrderTableRef = `${DimOrderTable.database}.${DimOrderTable.schema}.${DimOrderTable.name}`;

    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;

    const MdsPrefixOrderChannelTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_prefix_order_channel_master",
    };
    const MdsPrefixOrderChannelTableRef = `${MdsPrefixOrderChannelTable.database}.${MdsPrefixOrderChannelTable.schema}.${MdsPrefixOrderChannelTable.name}`;
}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;
  SET max_sk = (SELECT IFNULL(MAX(OrderSK), 0) FROM `${DimOrderTableRef}`);

  MERGE `${DimOrderTableRef}` AS T
  USING (
    WITH mil as (
        select
            company_id, miltype, milvnos, milstk, milQuan, milSum, millinkvcno
        from ${ref(databuffet.CURATED_MAC5, 'curated_mil')} as mil
        where mil.miltype in ('PS', 'IS')
            and PARSE_DATE('%Y%m%d', CONCAT(mil.milYear, FORMAT("%02d", mil.milMonth), FORMAT("%02d", mil.milDay))) >= DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 4 YEAR), YEAR)
    ),
    main_table as (
        select
            company_id, milvnos, milstk, sum(milQuan) as milQuan, sum(milSum) as milSum
        from mil
        where miltype = 'PS'
        group by 1, 2, 3
    ),
    sec_table as (
        select
            company_id, millinkvcno, milstk, sum(milQuan) as milQuan, sum(milSum) as milSum
        from mil
        where miltype = 'IS'
        and exists (
            select 1
            from main_table as main
            where mil.millinkvcno = main.milvnos
            and lower(mil.milstk) = lower(main.milstk)
            and mil.company_id = main.company_id
        )
        group by 1, 2, 3
    ),
    cal_table as (
        select
            main.company_id,
            main.milvnos, main.milstk,
            main.milQuan as main_qty, main.milSum as main_sum,
            sec.milQuan as sec_qty, sec.milSum as sec_sum,
            (case
                when sec.millinkvcno is null and sec.milstk is null then 'On Order'
                when sec.milQuan >= main.milQuan then 'Complete'
                else 'In Process'
            end) as item_status
        from main_table as main
        left join sec_table as sec
            on main.milvnos = sec.millinkvcno
            and lower(main.milstk) = lower(sec.milstk)
            and main.company_id = sec.company_id
    ),
    order_status as (
        select
            company_id,
            milvnos,
            (case
                when countif(item_status = 'In Process') > 0 then 'In Process'
                when countif(item_status = 'On Order') > 0 then 'On Order'
                else 'Complete'
            end) as OrderStatus
        from cal_table
        group by 1, 2
    ),
    -- ช่องทางขายตาม prefix เลข order (MDS): 1 แถวต่อ prefix กัน MERGE fan out ถ้า MDS มี prefix ซ้ำ
    order_channel as (
        select
            UPPER(${databuffet.functionData.cleanString("Prefix")}) as Prefix,
            ${databuffet.functionData.cleanString("Channel_Name")} as Channel_Name
        from `${MdsPrefixOrderChannelTableRef}`
        where is_active = TRUE
            and ${databuffet.functionData.cleanString("Prefix")} is not null
        qualify row_number() over(
            partition by UPPER(${databuffet.functionData.cleanString("Prefix")})
            order by version desc, updated_at desc
        ) = 1
    ),
    source_data AS (
        SELECT
            dim_com.CompanySK,
            dim_com.companyID,
            PARSE_DATE('%Y%m%d', CONCAT(mihYear, FORMAT("%02d", mihMonth),  mihDay)) as mix_date,
            mih.mihYear,
            mih.mihMonth,
            mih.mihDay,
            mih.mihType,
            mih.mihVnos,
            mih.mihJob,
            mih.mihRef1,
            mih.mihRef2,
            mih.mihRef3,
            mih.mihCancel,
            mih.mihStatus ,
            ar.ar_snamet as StatusName,
            mih.memoExtract,
            mih.mihMemoNew,
            mih.mihstatus_desc as mihStatusDesc,
            mih.mihCus,
            mih.mihNotes,
            mih.mihDesc,
            mih.mihKeydate,
            mih.mihDelvdate,
            mih.mihClearum,
            mih.mihExtrasum,
            mih.mihPer,
            per.pernamet,
            mih.mihBl,
            ar.ar_scolb as StatusColorBg,
            order_status.OrderStatus,
            -- prefix = ตัวอักษรชุดแรกก่อนตัวเลข เทียบเท่ากันทั้งคำ (SH ไม่ชน SHT); ไม่เจอใน MDS → 'Other'
            COALESCE(order_channel.Channel_Name, 'Other') as OrderChannel
        FROM ${ref(databuffet.CURATED_MAC5, 'curated_mih')} as mih
        LEFT JOIN ${ref(databuffet.VALIDATED_MAC5, 'ar_s')} as ar
            on mih.mihStatus = ar.ar_scode
            AND mih.company_id = ar.company_id
        LEFT JOIN ${ref(databuffet.VALIDATED_MAC5, 'per')} as per
            on mih.mihPer = per.percode
            AND mih.company_id = per.company_id
        LEFT JOIN order_status as order_status
            on order_status.milvnos = mih.mihVnos
            and order_status.company_id = mih.company_id
        left join `${DimCompanyTableRef}` as dim_com
            on mih.company_id = dim_com.companyID
        LEFT JOIN order_channel as order_channel
            on UPPER(REGEXP_EXTRACT(mih.mihVnos, r'^[A-Za-z]+')) = order_channel.Prefix
        WHERE mih.mihType = 'PS'
            and PARSE_DATE('%Y%m%d', CONCAT(mih.mihYear, FORMAT("%02d", mih.mihMonth), FORMAT("%02d", mih.mihDay))) >= DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 4 YEAR), YEAR)
    )

    SELECT
        (CASE
            WHEN t2.OrderSK IS NOT NULL THEN t2.OrderSK
            ELSE max_sk + ROW_NUMBER() OVER(
                PARTITION BY (CASE WHEN t2.mihVnos IS NULL THEN 1 ELSE 0 END)
                ORDER BY t1.CompanySK, t1.mihYear, t1.mihMonth, t1.mihDay, t1.mihVnos
            )
        END) AS OrderSK,
        t1.CompanySK,
        t1.companyID,
        t1.mix_date,
        t1.mihYear,
        t1.mihMonth,
        t1.mihDay,
        t1.mihType,
        t1.mihVnos,
        t1.mihCus,
        t1.mihJob,
        t1.mihRef1,
        t1.mihRef2,
        t1.mihRef3,
        t1.mihCancel,
        t1.mihStatus,
        t1.StatusName,
        t1.memoExtract,
        t1.mihMemoNew,
        t1.mihStatusDesc,
        t1.mihNotes,
        t1.mihDesc,
        t1.mihKeydate,
        t1.mihDelvdate,
        t1.mihClearum,
        t1.mihExtrasum,
        t1.mihPer,
        t1.pernamet,
        t1.mihBl,
        t1.StatusColorBg,
        t1.OrderStatus,
        t1.OrderChannel
    FROM source_data AS t1
    LEFT JOIN `${DimOrderTableRef}` AS t2
        ON  t1.mihYear = t2.mihYear
        AND t1.mihMonth = t2.mihMonth
        AND t1.mihDay = t2.mihDay
        AND t1.mihType = t2.mihType
        AND t1.mihVnos = t2.mihVnos
        AND IFNULL(t1.mihCus, '') = IFNULL(t2.mihCus, '')
        AND t1.CompanySK = t2.CompanySK

  ) AS S
  ON T.OrderSK = S.OrderSK

  WHEN MATCHED THEN
    UPDATE SET
      T.mix_date = S.mix_date,
      T.mihYear = S.mihYear,
      T.mihMonth = S.mihMonth,
      T.mihDay = S.mihDay,
      T.mihCus = S.mihCus,
      T.mihJob = S.mihJob,
      T.mihRef1 = S.mihRef1,
      T.mihRef2 = S.mihRef2,
      T.mihRef3 = S.mihRef3,
      T.mihCancel = S.mihCancel,
      T.mihStatus = S.mihStatus,
      T.StatusName = S.StatusName,
      T.memoExtract = S.memoExtract,
      T.mihMemoNew = S.mihMemoNew,
      T.mihNotes = S.mihNotes,
      T.mihStatusDesc = S.mihStatusDesc,
      T.mihDesc = S.mihDesc,
      T.mihKeydate = S.mihKeydate,
      T.mihDelvdate = S.mihDelvdate,
      T.mihClearum = S.mihClearum,
      T.mihExtrasum = S.mihExtrasum,
      T.mihPer = S.mihPer,
      T.pernamet = S.pernamet,
      T.mihBl = S.mihBl,
      T.StatusColorBg = S.StatusColorBg,
      T.OrderStatus = S.OrderStatus,
      T.OrderChannel = S.OrderChannel

  WHEN NOT MATCHED THEN
    INSERT (
      OrderSK, CompanySK,
      companyID,
      mix_date, mihYear, mihMonth, mihDay, mihType, mihVnos, mihCus,
      mihJob, mihRef1, mihRef2, mihRef3, mihCancel, mihStatus, 
      StatusName, memoExtract, mihMemoNew, mihNotes,
      mihStatusDesc, OrderStatus,
      mihDesc, mihKeydate, mihDelvdate, mihClearum, mihExtrasum,
      mihPer, pernamet, mihBl, StatusColorBg,
      OrderChannel
    )
    VALUES (
      S.OrderSK, S.CompanySK,
      S.companyID,
      S.mix_date, S.mihYear, S.mihMonth, S.mihDay, S.mihType, S.mihVnos, S.mihCus,
      S.mihJob, S.mihRef1, S.mihRef2, S.mihRef3, S.mihCancel, S.mihStatus,
      S.StatusName, S.memoExtract, S.mihMemoNew, S.mihNotes,
      S.mihStatusDesc, S.OrderStatus,
      S.mihDesc, S.mihKeydate, S.mihDelvdate, S.mihClearum, S.mihExtrasum,
      S.mihPer, S.pernamet, S.mihBl, S.StatusColorBg,
      S.OrderChannel
    );
END;
