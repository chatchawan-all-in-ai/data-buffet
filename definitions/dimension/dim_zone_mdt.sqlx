config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: [],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ZoneMdtSK"],
  bigquery: {
    clusterBy: ["ZoneMdtSK"],
  },
}

/*
  โซนขายของ MDT — ต้นทางคือ Master Branch MDT_final.xlsx ชีท Zone ที่ BI ดูแล
  ยังไม่ได้โหลดเข้า BigQuery จึงมีแต่แถวไม่ระบุไปก่อน

  fact ไม่ join ตารางนี้ตรงๆ — อ่าน ZoneMdtSK จาก dim_sales_branch_mdt
  ตารางนี้มีไว้ให้ BI ต่อเอาชื่อโซนกับชื่อผู้จัดการ

  ตั้งชื่อ dim_zone_mdt ไม่ใช่ dim_zone เพราะ dim_zone เปล่าๆ กำกวมกับโซนของ MAC5

  ponytail: ตอนเติมแถวจริงต้องเปลี่ยนไปใช้ MERGE เพื่อให้ SK นิ่ง
*/

SELECT * FROM UNNEST([
  STRUCT(
    -1                   AS ZoneMdtSK,
    CAST(NULL AS STRING) AS ZoneCode,
    'ไม่ระบุ'              AS ZoneNameTH,
    CAST(NULL AS STRING) AS ZoneManagerName
  )
])

pre_operations {}

post_operations {}
