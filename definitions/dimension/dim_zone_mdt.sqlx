config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: [],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ZoneMdtSK"],
  bigquery: {
    clusterBy: ["ZoneMdtSK"],
  },
}

/*
  โซนการขายของช่องทาง MDT — 1 แถว = 1 โซน (15 โซน + แถว -1)
  ต้นทาง mds_data_sales_zone_master ตารางเดียว ไม่ join ใคร

  แก้ 2026-09-11 ตามรีวิว 2 ข้อ
  1. ผู้จัดการโซนแยกไปอยู่ dim_zone_manager_mdt
     เดิมไฟล์นี้ LEFT JOIN mds_data_sales_zone_manager_master เข้ามาแปะ 4 คอลัมน์
     ซึ่งผิดเพราะยุบ 2 ตาราง MDS เป็น dim เดียว (ตามรอยกลับต้นทางยาก) และถ้าโซนหนึ่ง
     มีผู้จัดการหลายคน แถวโซนจะบวมตามจำนวนผู้จัดการ แล้ว ZoneMdtSK ที่ปั้นด้วย
     ROW_NUMBER จะซ้ำ  ตอนแก้ตารางนั้นมี 0 แถว คอลัมน์ผู้จัดการทั้ง 4 จึงเป็น NULL
     ทุกแถวอยู่แล้ว การลบออกไม่ทำให้ใครเสียข้อมูล
  2. เก็บทุกคอลัมน์ของ MDS ครบ ไม่ตัดอะไรออก รวมคอลัมน์กำกับการแก้ไข
     (Version / CreatedAt / CreatedBy / UpdatedAt / UpdatedBy / IsActive)
     ต่างจาก dim mds อื่นในรีโปที่เก็บแค่ MdsID เป็นร่องรอย — จงใจตามที่ตกลงกัน

  IsActive เป็น TRUE ทุกแถวของ zone_master เพราะกรองด้วย WHERE อยู่แล้ว
  เก็บไว้เพื่อให้คอลัมน์ตรงกับต้นทาง ไม่ได้ใช้ตัดสินอะไร

  ponytail: SK ปั้นด้วย ROW_NUMBER สร้างใหม่ทุกคืน ใช้ได้เพราะ dim_sales_branch_mdt
  และ fact_saleout_mdt rebuild ทุกคืนเหมือนกัน
*/

js {
    const ZoneSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_zone_master`;
}

WITH zone_master AS (
  SELECT
    ROW_NUMBER() OVER(ORDER BY ${databuffet.functionData.cleanString("t1.zone_id")}) AS ZoneMdtSK,

    -- คอลัมน์ธุรกิจ
    ${databuffet.functionData.cleanString("t1.zone_id")}   AS ZoneCode,
    ${databuffet.functionData.cleanString("t1.zone_name")} AS ZoneName,
    t1.start_date AS StartDate,
    t1.end_date   AS EndDate,

    -- คอลัมน์กำกับการแก้ไขจาก MDS (เก็บครบตามที่ตกลง)
    t1.is_active  AS IsActive,
    t1.version    AS Version,
    t1.created_at AS CreatedAt,
    ${databuffet.functionData.cleanString("t1.created_by")} AS CreatedBy,
    t1.updated_at AS UpdatedAt,
    ${databuffet.functionData.cleanString("t1.updated_by")} AS UpdatedBy,

    ${databuffet.functionData.cleanString("t1.id")} AS MdsID
  FROM `${ZoneSourceRef}` AS t1
  WHERE t1.is_active = TRUE

), unknown_zone AS (
  SELECT
    -1                      AS ZoneMdtSK,

    CAST(NULL AS STRING)    AS ZoneCode,
    'ไม่ระบุโซน'              AS ZoneName,
    CAST(NULL AS DATE)      AS StartDate,
    CAST(NULL AS DATE)      AS EndDate,

    CAST(NULL AS BOOL)      AS IsActive,
    CAST(NULL AS INT64)     AS Version,
    CAST(NULL AS TIMESTAMP) AS CreatedAt,
    CAST(NULL AS STRING)    AS CreatedBy,
    CAST(NULL AS TIMESTAMP) AS UpdatedAt,
    CAST(NULL AS STRING)    AS UpdatedBy,

    CAST(NULL AS STRING)    AS MdsID
)

SELECT * FROM zone_master
UNION ALL
SELECT * FROM unknown_zone

pre_operations {}

post_operations {}
