config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: [],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ZoneMdtSK"],
  bigquery: {
    clusterBy: ["ZoneMdtSK"],
  },
}



js {
    const ZoneSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_zone_master`;
    const ZoneManagerSourceRef = `${databuffet.DATABASE}.${databuffet.MDS_DATASET}.mds_data_sales_zone_manager_master`;
}

WITH zone_master AS (
  SELECT
    ROW_NUMBER() OVER(ORDER BY ${databuffet.functionData.cleanString("t1.zone_id")}) AS ZoneMdtSK,
    ${databuffet.functionData.cleanString("t1.zone_id")}   AS ZoneCode,
    ${databuffet.functionData.cleanString("t1.zone_name")} AS ZoneName,
    ${databuffet.functionData.cleanString("mgr.zonemanageremployeeid")}       AS ZoneManagerEmployeeID,
    ${databuffet.functionData.cleanString("mgr.zonemanageremployeename")}     AS ZoneManagerName,
    ${databuffet.functionData.cleanString("mgr.zonemanageremployeesurname")}  AS ZoneManagerSurname,
    ${databuffet.functionData.cleanString("mgr.zonemanageremployeenickname")} AS ZoneManagerNickname,
    t1.start_date AS StartDate,
    t1.end_date   AS EndDate,
    ${databuffet.functionData.cleanString("t1.id")} AS MdsID
  FROM `${ZoneSourceRef}` AS t1
  LEFT JOIN `${ZoneManagerSourceRef}` AS mgr
    ON ${databuffet.functionData.cleanString("t1.zone_id")} = ${databuffet.functionData.cleanString("mgr.zone_id")}
   AND mgr.is_active = TRUE
  WHERE t1.is_active = TRUE

), unknown_zone AS (
  SELECT
    -1                   AS ZoneMdtSK,
    CAST(NULL AS STRING) AS ZoneCode,
    'ไม่ระบุโซน'           AS ZoneName,
    CAST(NULL AS STRING) AS ZoneManagerEmployeeID,
    CAST(NULL AS STRING) AS ZoneManagerName,
    CAST(NULL AS STRING) AS ZoneManagerSurname,
    CAST(NULL AS STRING) AS ZoneManagerNickname,
    CAST(NULL AS DATE)   AS StartDate,
    CAST(NULL AS DATE)   AS EndDate,
    CAST(NULL AS STRING) AS MdsID
)

SELECT * FROM zone_master
UNION ALL
SELECT * FROM unknown_zone

pre_operations {}

post_operations {}
