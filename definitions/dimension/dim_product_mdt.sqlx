config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_product_master", "dim_stk_mkt", "dim_product_mkt"],
  tags: [databuffet.TAG_DIM_DAILY, databuffet.TAG_SALEOUT_DAILY],
  uniqueKey: ["ProductMdtSK"],
  bigquery: {
    clusterBy: ["ProductMdtSK"],
  },
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_mdt_product_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;

    const DimProductMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_master",
    };
    const DimProductMasterTableRef = `${DimProductMasterTable.database}.${DimProductMasterTable.schema}.${DimProductMasterTable.name}`;

    const DimStkMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_stk_mkt",
    };
    const DimStkMktTableRef = `${DimStkMktTable.database}.${DimStkMktTable.schema}.${DimStkMktTable.name}`;
    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;

}

WITH mac5_dedup AS (
  SELECT ProductSK, ProductMktSK, companyID, ProductCode
  FROM `${DimProductMasterTableRef}`
  QUALIFY ROW_NUMBER() OVER(PARTITION BY companyID, ProductCode ORDER BY ProductSK) = 1

  ), mkt_fallback AS (

  SELECT k.StkCode, k.companyID, m.ProductMktSK
  FROM `${DimStkMktTableRef}` AS k
  INNER JOIN `${DimProductMktTableRef}` AS m
    ON  k.MarketingGroupID = m.MarketingGroupID
    AND k.SubMarketingID   = m.SubMarketingID
    AND k.SegmentID        = m.SegmentID
    AND k.companyID        = m.companyID
  QUALIFY ROW_NUMBER() OVER(PARTITION BY k.companyID, k.StkCode ORDER BY m.ProductMktSK) = 1

), product_src AS (
  SELECT *
  FROM `${MdsSourceTableRef}`
  WHERE is_active = TRUE
    AND product_mdt_code IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY CAST(product_mdt_code AS INT64)
    ORDER BY product_mac5_code IS NULL, region_id, id
  ) = 1

), product_master AS (
    SELECT
    ROW_NUMBER() OVER(ORDER BY CAST(t1.product_mdt_code AS INT64)) AS ProductMdtSK,
    IFNULL(mac5.ProductSK, IFNULL(wait5.ProductSK, -1)) AS ProductSK,
    IFNULL(NULLIF(mac5.ProductMktSK, -1),
           IFNULL(fb.ProductMktSK, IFNULL(wait.ProductMktSK, -1))) AS ProductMktSK,
    CAST(CAST(t1.product_mdt_code AS INT64) AS STRING)          AS ProductCode,
    NULLIF(CAST(TRIM(t1.product_mdt_name) AS STRING), '')  AS ProductName,
    IF(mac5.ProductSK IS NULL AND fb.ProductMktSK IS NULL,
       'WAITING999',
       NULLIF(CAST(TRIM(t1.product_mac5_code) AS STRING), '')) AS ProductMac5Code,
    NULLIF(CAST(TRIM(t1.region_id) AS STRING), '')         AS StoreCode,
    NULLIF(CAST(TRIM(t1.commpy) AS STRING), '')            AS CompanyID,
    t1.id                                                         AS MdsID
  FROM product_src AS t1
  LEFT JOIN mac5_dedup AS mac5
    ON  NULLIF(CAST(TRIM(t1.product_mac5_code) AS STRING), '') = mac5.ProductCode
    AND NULLIF(CAST(TRIM(t1.commpy) AS STRING), '')            = mac5.companyID
   LEFT JOIN mkt_fallback AS fb
    ON  NULLIF(CAST(TRIM(t1.product_mac5_code) AS STRING), '') = fb.StkCode
    AND NULLIF(CAST(TRIM(t1.commpy) AS STRING), '')            = fb.companyID

  LEFT JOIN mkt_fallback AS wait
    ON  wait.StkCode  = 'WAITING999'
    AND wait.companyID = NULLIF(CAST(TRIM(t1.commpy) AS STRING), '')

  LEFT JOIN mac5_dedup AS wait5
    ON  wait5.ProductCode = 'WAITING999'
    AND wait5.companyID   = NULLIF(CAST(TRIM(t1.commpy) AS STRING), '')

    ), feed_product AS (

  SELECT
    LTRIM(product_code, '0') AS product_code,
    ANY_VALUE(product_name) AS product_name,
    MIN(store_code)         AS store_code
  FROM (
    SELECT product_code, product_name, store_code
    FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_saleout_mdt")}
    UNION ALL
    SELECT product_code, product_name, store_code
    FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_saleout_monthly_mdt")}
    UNION ALL
    SELECT product_code, product_name, store_code
    FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_stock_mdt")}
  )
  WHERE product_code IS NOT NULL
  GROUP BY LTRIM(product_code, '0')

), new_product AS (

  SELECT
    (SELECT IFNULL(MAX(ProductMdtSK), 0) FROM product_master)
      + ROW_NUMBER() OVER(ORDER BY f.product_code)        AS ProductMdtSK,
    IFNULL(wait5.ProductSK, -1)                          AS ProductSK,
    IFNULL(wait.ProductMktSK, -1)                        AS ProductMktSK,
    f.product_code                                       AS ProductCode,
    IFNULL(f.product_name, f.product_code)               AS ProductName,
    'WAITING999'                                           AS ProductMac5Code,
    f.store_code                                         AS StoreCode,
    'ag01'                                               AS CompanyID,
    CAST(NULL AS STRING)                                 AS MdsID
  FROM feed_product AS f
  LEFT JOIN mkt_fallback AS wait
    ON  wait.StkCode   = 'WAITING999'
    AND wait.companyID = 'ag01'
  LEFT JOIN mac5_dedup AS wait5
    ON  wait5.ProductCode = 'WAITING999'
    AND wait5.companyID   = 'ag01'
  WHERE NOT EXISTS (
    SELECT 1 FROM product_master AS p WHERE p.ProductCode = f.product_code
  )

), unknown_product AS (
  SELECT
    -1                   AS ProductMdtSK,
    -1                   AS ProductSK,
    -1                   AS ProductMktSK,
    'NotProduct'         AS ProductCode,
    'ไม่ระบุสินค้า'           AS ProductName,
    'ยังไม่มีข้อมูล'           AS ProductMac5Code,
    'NotStore'           AS StoreCode,
    'NotCompany'         AS CompanyID,
    CAST(NULL AS STRING) AS MdsID
)

SELECT * FROM product_master
UNION ALL
SELECT * FROM new_product
UNION ALL
SELECT * FROM unknown_product

pre_operations {}

post_operations {}
