config {
  type: "table",
  schema: databuffet.DIMENSION_TABLE,
  dependencies: [],
  tags: [databuffet.TAG_DIM_DAILY],
  uniqueKey: ["ProductMdtSK"],
  bigquery: {
    clusterBy: ["ProductMdtSK"],
  },
}

/*
  สินค้าที่ขายผ่าน MDT — ต้นทางคือ Master Branch MDT_final.xlsx ชีท Product ที่ BI ดูแล
  ยังไม่ได้โหลดเข้า BigQuery จึงมีแต่แถวไม่ระบุไปก่อน

  คีย์ธรรมชาติคือ StoreCode + SourceProductCode ต้องใช้ 2 คอลัมน์
  เพราะรหัสสินค้าของแต่ละห้างเป็นระบบของตัวเอง ชนกันข้ามห้างได้

  เก็บ ProductSK ไว้ในตัวเอง fact จึงไม่ต้อง join dim_product_master
  ตอนเติมแถวจริงต้องตอบก่อนว่าใช้ ProductSK ของบริษัทไหน
  dim_product_master มี CompanySK — รหัสสินค้าเดียวกันมีหลายแถวข้ามบริษัท

  แถวใหม่ห้ามเพิ่มอัตโนมัติ ต้องมีคนกรอกผ่าน form ยืนยันก่อน
  รหัสที่จับไม่ได้จะไปอยู่ที่ SK = -1 ยอดไม่หาย

  ponytail: ตอนเติมแถวจริงต้องเปลี่ยนไปใช้ MERGE เพื่อให้ SK นิ่ง
*/

SELECT * FROM UNNEST([
  STRUCT(
    -1                   AS ProductMdtSK,
    CAST(NULL AS STRING) AS StoreCode,
    CAST(NULL AS STRING) AS SourceProductCode,
    'ไม่ระบุ'              AS ProductNameMdt,
    CAST(NULL AS STRING) AS ProductMdtCode,
    -1                   AS ProductSK
  )
])

pre_operations {}

post_operations {}
