config {
  type: "operations",
  hasOutput: true,
  schema: databuffet.DIMENSION_TABLE,
  dependencies: ["dim_company"],
  tags: [databuffet.TAG_DIM_DAILY],
}

js {
    const MdsSourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_sales_representative_master",
    };
    const MdsSourceTableRef = `${MdsSourceTable.database}.${MdsSourceTable.schema}.${MdsSourceTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimSaleRepresentativeTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: name(),
    };
    const DimSaleRepresentativeTableRef = `${DimSaleRepresentativeTable.database}.${DimSaleRepresentativeTable.schema}.${DimSaleRepresentativeTable.name}`;




    const stableDimensionColumns = ['SaleRepSK', 'CompanySK', 'companyID', 'DepartmentID', 'EmployeeID', 'EmployeeName', 'EmployeeSurname', 'EmployeeNickname', 'DepCode', 'CostChannelID', 'ProvinceID', 'ChangeSectionFlag', 'CustomerFlag', 'StartDate', 'EndDate', 'OrderStartDate', 'OrderEndDate', 'MdsID'];
    const stableDimensionKeyColumns = ['companyID', 'DepartmentID', 'EmployeeID', 'DepCode', 'CostChannelID', 'ProvinceID', 'StartDate', 'EndDate', 'OrderStartDate', 'OrderEndDate', 'CustomerFlag'];
    const stableDimensionKeySql = stableDimensionKeyColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionOrderSql = stableDimensionKeyColumns.map((column) => `source_row.\`${column}\``).join(", ");
    const stableDimensionLookupCondition = stableDimensionKeyColumns.map((column) =>
        `source_row.\`${column}\` IS NOT DISTINCT FROM target_row.\`${column}\``
    ).join("\n      AND ");
    const stableDimensionMergeCondition = 'T.`SaleRepSK` = S.`SaleRepSK`';
    const stableDimensionUpdateSet = stableDimensionColumns
        .filter((column) => column !== 'SaleRepSK' && !stableDimensionKeyColumns.includes(column))
        .map((column) => `T.\`${column}\` = S.\`${column}\``)
        .join(",\n      ");
    const stableDimensionInsertColumns = stableDimensionColumns.map((column) => `\`${column}\``).join(", ");
    const stableDimensionInsertValues = stableDimensionColumns.map((column) => `S.\`${column}\``).join(", ");

}

BEGIN
  DECLARE max_sk INT64 DEFAULT 0;

  CREATE TEMP TABLE stable_sk_source_snapshot AS (
    WITH mds_base AS (
      SELECT
        dim_com.CompanySK,
        ${databuffet.functionData.cleanString("t1.companyID")} AS companyID,
        ${databuffet.functionData.cleanString("t1.DepartmentID")} AS DepartmentID,
        ${databuffet.functionData.cleanString("t1.EmployeeID")} AS EmployeeID,
        ${databuffet.functionData.cleanString("t1.EmployeeName")} AS EmployeeName,
        ${databuffet.functionData.cleanString("t1.EmployeeSurname")} AS EmployeeSurname,
        ${databuffet.functionData.cleanString("t1.EmployeeNickname")} AS EmployeeNickname,
        ${databuffet.functionData.cleanString("t1.DepCode")} AS DepCode,
        ${databuffet.functionData.cleanString("t1.CostChannelID")} AS CostChannelID,
        ${databuffet.functionData.cleanString("t1.ProvinceID")} AS ProvinceID,
        ${databuffet.functionData.cleanString("t1.ChangeSectionFlag")} AS ChangeSectionFlag,
        ${databuffet.functionData.cleanString("t1.CustomerFlag")} AS CustomerFlag,
        t1.StartDate AS StartDate,
        t1.EndDate AS EndDate,
        t1.OrderStartDate,
        t1.OrderEndDate,
        ${databuffet.functionData.cleanString("t1.id")} AS MdsID
      FROM `${MdsSourceTableRef}` AS t1
      LEFT JOIN `${DimCompanyTableRef}` AS dim_com
        ON ${databuffet.functionData.cleanString("t1.companyID")} = dim_com.companyID
      WHERE t1.is_active = TRUE

    ), flag_only AS (
      SELECT companyID, EmployeeID, DepartmentID, StartDate, EndDate, CustomerFlag
      FROM mds_base
      WHERE CustomerFlag IS NOT NULL
        AND DepCode IS NULL
        AND CostChannelID IS NULL
        AND ProvinceID IS NULL
        AND OrderStartDate IS NULL

    ), rule_rows AS (
      SELECT *
      FROM mds_base
      WHERE NOT (CustomerFlag IS NOT NULL
                 AND DepCode IS NULL
                 AND CostChannelID IS NULL
                 AND ProvinceID IS NULL
                 AND OrderStartDate IS NULL)

    ), mds_rep AS (
      SELECT
        r.CompanySK,
        r.companyID,
        r.DepartmentID,
        r.EmployeeID,
        r.EmployeeName,
        r.EmployeeSurname,
        r.EmployeeNickname,
        r.DepCode,
        r.CostChannelID,
        r.ProvinceID,
        r.ChangeSectionFlag,
        NULLIF(
          ARRAY_TO_STRING([
            r.CustomerFlag,
            (SELECT STRING_AGG(f.CustomerFlag, '|' ORDER BY f.CustomerFlag)
             FROM flag_only AS f
             WHERE r.DepCode IS NOT NULL
               AND f.companyID    = r.companyID
               AND f.EmployeeID   = r.EmployeeID
               AND f.DepartmentID = r.DepartmentID
               AND r.StartDate <= f.EndDate
               AND f.StartDate <= r.EndDate)
          ], '|'),
          ''
        ) AS CustomerFlag,
        r.StartDate,
        r.EndDate,
        r.OrderStartDate,
        r.OrderEndDate,
        r.MdsID
      FROM rule_rows AS r

    ), raw_per AS (
      SELECT DISTINCT
        company_id,
        percode AS EmployeeID,
        TRIM(REGEXP_REPLACE(pernamet, r'\s+', ' ')) AS pernamet
      FROM ${ref(databuffet.VALIDATED_MAC5, 'per')} AS per

    ), ledger_rep AS (
      SELECT
        dim_com.CompanySK,
        dim_com.companyID,
        CAST(NULL AS STRING) AS DepartmentID,
        raw_per.EmployeeID,
        REGEXP_EXTRACT(pernamet, r'^([^\s]+)') AS EmployeeName,
        REGEXP_EXTRACT(pernamet, r'\s([^\s(]+)') AS EmployeeSurname,
        REGEXP_EXTRACT(pernamet, r'\((.*?)\)') AS EmployeeNickname,
        CAST(NULL AS STRING) AS DepCode,
        CAST(NULL AS STRING) AS CostChannelID,
        CAST(NULL AS STRING) AS ProvinceID,
        CAST(NULL AS STRING) AS ChangeSectionFlag,
        CAST(NULL AS STRING) AS CustomerFlag,
        DATE('1900-01-01') AS StartDate,
        DATE('2499-12-31') AS EndDate,
        CAST(NULL AS DATE) AS OrderStartDate,
        CAST(NULL AS DATE) AS OrderEndDate,
        CAST(NULL AS STRING) AS MdsID
      FROM raw_per
      LEFT JOIN `${DimCompanyTableRef}` AS dim_com
        ON raw_per.company_id = dim_com.companyID

    ), combined AS (
      SELECT * FROM mds_rep
      UNION ALL
      SELECT * FROM ledger_rep

    )
    SELECT
      ROW_NUMBER() OVER(
        ORDER BY
          (CASE WHEN MdsID IS NULL THEN 1 ELSE 0 END),
          companyID,
          DepartmentID,
          EmployeeID,
          DepCode,
          CostChannelID,
          ProvinceID,
          StartDate,
          EndDate
      ) AS SaleRepSK,
      CompanySK,
      companyID,
      DepartmentID,
      EmployeeID,
      EmployeeName,
      EmployeeSurname,
      EmployeeNickname,
      DepCode,
      CostChannelID,
      ProvinceID,
      ChangeSectionFlag,
      CustomerFlag,
      StartDate,
      EndDate,
      OrderStartDate,
      OrderEndDate,
      MdsID
    FROM combined
  );

  ASSERT NOT EXISTS (
    SELECT 1
    FROM _SESSION.stable_sk_source_snapshot
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative source natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeTableRef}`
    GROUP BY ${stableDimensionKeySql}
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative target natural key must be unique';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeTableRef}`
    WHERE `SaleRepSK` IS NULL
  ) AS 'dim_sale_representative target surrogate key must not be NULL';

  ASSERT NOT EXISTS (
    SELECT 1
    FROM `${DimSaleRepresentativeTableRef}`
    GROUP BY `SaleRepSK`
    HAVING COUNT(*) > 1
  ) AS 'dim_sale_representative target surrogate key must be unique';

  SET max_sk = COALESCE((
    SELECT MAX(`SaleRepSK`)
    FROM `${DimSaleRepresentativeTableRef}`
  ), 0);

  CREATE TEMP TABLE stable_sk_source AS
  SELECT
    allocated_row.* EXCEPT (stable_existing_sk, stable_new_sk_rank)
    REPLACE (
      CASE
        WHEN allocated_row.`SaleRepSK` = -1 THEN -1
        ELSE COALESCE(
          allocated_row.stable_existing_sk,
          max_sk + allocated_row.stable_new_sk_rank
        )
      END AS `SaleRepSK`
    )
  FROM (
    SELECT
      source_row.*,
      target_row.`SaleRepSK` AS stable_existing_sk,
      ROW_NUMBER() OVER (
        PARTITION BY (target_row.`SaleRepSK` IS NULL)
        ORDER BY ${stableDimensionOrderSql}
      ) AS stable_new_sk_rank
    FROM _SESSION.stable_sk_source_snapshot AS source_row
    LEFT JOIN `${DimSaleRepresentativeTableRef}` AS target_row
      ON ${stableDimensionLookupCondition}
  ) AS allocated_row;

  MERGE `${DimSaleRepresentativeTableRef}` AS T
  USING _SESSION.stable_sk_source AS S
    ON ${stableDimensionMergeCondition}
  WHEN MATCHED THEN
    UPDATE SET
      ${stableDimensionUpdateSet}
  WHEN NOT MATCHED THEN
    INSERT (${stableDimensionInsertColumns})
    VALUES (${stableDimensionInsertValues})
  WHEN NOT MATCHED BY SOURCE THEN
    DELETE;
END;
