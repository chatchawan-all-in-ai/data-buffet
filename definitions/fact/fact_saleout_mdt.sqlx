config {
    type: "table",
    schema: databuffet.FACT_TABLE,
    dependencies: ["dim_sales_branch_mdt", "dim_product_mdt", "dim_product_mkt", "dim_report", "dim_region", "dim_region_manager", "dim_director"],
    tags: [databuffet.TAG_FACT_DAILY, databuffet.TAG_SALEOUT_DAILY],
    uniqueKey: ["sale_date", "store_code", "branch_code", "product_code", "doc_type"],
    bigquery: {
        partitionBy: "sale_date",
        clusterBy: ["store_code", "branch_sk", "product_mdt_sk"]
    },
}

js {
    const DimSalesBranchMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sales_branch_mdt",
    };
    const DimBranchTableRef = `${DimSalesBranchMdtTable.database}.${DimSalesBranchMdtTable.schema}.${DimSalesBranchMdtTable.name}`;

    const DimProductMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mdt",
    };
    const DimProductMdtTableRef = `${DimProductMdtTable.database}.${DimProductMdtTable.schema}.${DimProductMdtTable.name}`;

    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;

    const DimReportTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_report",
    };
    const DimReportTableRef = `${DimReportTable.database}.${DimReportTable.schema}.${DimReportTable.name}`;
    const DimRegionTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region",
    };
    const DimRegionTableRef = `${DimRegionTable.database}.${DimRegionTable.schema}.${DimRegionTable.name}`;
    const DimRegionManagerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region_manager",
    };
    const DimRegionManagerTableRef = `${DimRegionManagerTable.database}.${DimRegionManagerTable.schema}.${DimRegionManagerTable.name}`;
    const DimDirectorTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_director",
    };
    const DimDirectorTableRef = `${DimDirectorTable.database}.${DimDirectorTable.schema}.${DimDirectorTable.name}`;
}
WITH mkt_group AS (
  -- ProductMktSK -> MarketingGroupID เพื่อเอาไปหาบรรทัดรายงาน
  SELECT ProductMktSK, MarketingGroupID, SegmentID
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY ProductMktSK ORDER BY MarketingGroupID) = 1

), waiting_mkt AS (

  SELECT ANY_VALUE(ProductMktSK) AS WaitingMktSK
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01' AND MarketingGroupID = '999'

), report_exact AS (
  -- บรรทัดรายงานที่ระบุกลุ่มสินค้า · dim_report.RegionID ฝั่ง MDT คือรหัสห้าง ไม่ใช่ภูมิภาค
  SELECT RegionID AS StoreCode, MarketingGroupID, ReportSK
  FROM `${DimReportTableRef}`
  WHERE companyID = 'ag01' AND MarketingGroupID IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, MarketingGroupID ORDER BY ReportSK) = 1

), report_fallback AS (
  -- แถว Other ของแต่ละห้าง — แยก CTE เพราะ join ด้วย NULL = NULL ไม่เป็นจริง
  SELECT RegionID AS StoreCode, ReportSK
  FROM `${DimReportTableRef}`
  WHERE companyID = 'ag01' AND MarketingGroupID IS NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID ORDER BY ReportSK) = 1

  ), region_at_sale AS (
  -- ภาค ณ วันที่ขาย (dim_region ไม่ใช่ _last) · QUALIFY กัน SubRegion แตกในอนาคต
  SELECT RegionID, SubRegionID, RegionSK, DirectorID, StartDate, EndDate
  FROM `${DimRegionTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, StartDate ORDER BY SubRegionID, RegionSK) = 1

), region_manager_at_sale AS (
  -- ผู้จัดการภาค ณ วันที่ขาย — ตอบว่า "ตอนนั้นใครดูแล" ไม่ใช่ "ตอนนี้ใครดูแล"
  SELECT RegionID, RegionManagerSK, StartDate, EndDate
  FROM `${DimRegionManagerTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, StartDate ORDER BY SubRegionID, RegionManagerSK) = 1

), director_at_sale AS (
  -- ผู้อำนวยการ ณ วันที่ขาย — ต้องผ่าน dim_region ก่อนเพราะ DirectorID อยู่ที่นั่น
  SELECT DirectorID, DirectorSK, StartDate, EndDate
  FROM `${DimDirectorTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY DirectorID, StartDate ORDER BY DirectorSK) = 1

)

SELECT
  c.sale_date,
  c.store_code,

  IFNULL(dim_br.BranchMdtSK,   -1) AS branch_sk,
  IFNULL(dim_br.ZoneMdtSK,     -1) AS zone_sk,
  IFNULL(dim_pr.ProductMdtSK,  -1) AS product_mdt_sk,
  IFNULL(dim_pr.ProductSK,     -1) AS product_sk,
   -- NULLIF จับทั้งสองกรณี: สินค้าที่ไม่มีในทะเบียนเลย (NULL) และที่มีแต่ยังไม่ได้จัดกลุ่ม (-1)
  IFNULL(NULLIF(dim_pr.ProductMktSK, -1), IFNULL((SELECT WaitingMktSK FROM waiting_mkt), -1)) AS product_mkt_sk,
  COALESCE(rep.ReportSK, rep_fb.ReportSK, -1) AS report_sk,
  -- ชุด "Transaction" ตามเอกสาร requirement — ค่า ณ วันที่ขาย ไม่ใช่ค่าปัจจุบัน
  -- ต่างจาก RegionSK/RegionManagerSK ใน dim_sales_branch_mdt ซึ่งมาจาก _last = ค่าล่าสุด
  -- (ฝั่ง sale in เรียกชุดค่าปัจจุบันว่า ChangeRegionSK — เรายังไม่ได้ทำชุดนั้น)
  IFNULL(rg.RegionSK,         -1) AS region_sk,
  IFNULL(rgm.RegionManagerSK, -1) AS region_manager_sk,
  IFNULL(dr.DirectorSK,       -1) AS director_sk,

  c.doc_type,
  c.doc_type_source,
  c.sale_qty,
  c.sale_amount,
  c.days_covered,
  c.date_is_estimated,

  -- degenerate: เก็บรหัสที่ห้างส่งมาไว้สืบกลับถึงแถวต้นทาง
  c.branch_code,
  c.product_code,

  c.asatdate
FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_saleout_mdt")} AS c
LEFT JOIN `${DimBranchTableRef}` AS dim_br
  ON  c.store_code  = dim_br.StoreCode
  AND c.branch_code = dim_br.BranchCode
LEFT JOIN `${DimProductMdtTableRef}` AS dim_pr
  ON LTRIM(c.product_code, '0') = dim_pr.ProductCode
  LEFT JOIN mkt_group AS mkt
  ON dim_pr.ProductMktSK = mkt.ProductMktSK
LEFT JOIN report_exact AS rep
  ON  c.store_code        = rep.StoreCode
  AND mkt.MarketingGroupID = rep.MarketingGroupID
LEFT JOIN report_fallback AS rep_fb
  ON c.store_code = rep_fb.StoreCode
LEFT JOIN region_at_sale AS rg
  ON  c.store_code = rg.RegionID
  AND c.sale_date BETWEEN rg.StartDate AND rg.EndDate
LEFT JOIN region_manager_at_sale AS rgm
  ON  c.store_code = rgm.RegionID
  AND c.sale_date BETWEEN rgm.StartDate AND rgm.EndDate
LEFT JOIN director_at_sale AS dr
  ON  rg.DirectorID = dr.DirectorID
  AND c.sale_date BETWEEN dr.StartDate AND dr.EndDate
-- ทดลองตัด Segment ที่ไฟล์ BI ของ GB ไม่นับ (2026-09-23)
--   00221 = HITACHI (HOME PUMP) 3 รุ่น 16.47M · 00222 ยังไม่มีแถวของ GB
-- IFNULL: สินค้าที่ไม่มี Segment (SK -1) ต้องไม่หลุดไปด้วย
-- ponytail: ย้ายรายการไปไว้ที่ master รายการตัดออก (store_code, segment_id) เมื่อ BI ยืนยัน
WHERE NOT (c.store_code = 'GB' AND IFNULL(mkt.SegmentID, '') IN ('00221', '00222'))

pre_operations {}

post_operations {}
