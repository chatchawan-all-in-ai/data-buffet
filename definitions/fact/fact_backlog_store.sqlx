config {
    type: "table",
    schema: databuffet.FACT_TABLE,
    dependencies: ["dim_order", "dim_customer", "dim_product_master", "dim_company", "dim_store"],
    tags: [databuffet.TAG_FACT_DAILY],
    uniqueKey: ["FactBacklogStoreSK"],
    bigquery: {
        partitionBy: "sDate",
        clusterBy: ["FactBacklogStoreSK"]
    },
}

js {
    const DimOrderTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_order",
    };
    const DimOrderTableRef = `${DimOrderTable.database}.${DimOrderTable.schema}.${DimOrderTable.name}`;
    const MdsDataStatusControlMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_status_control_master",
    };
    const MdsDataStatusControlMasterTableRef = `${MdsDataStatusControlMasterTable.database}.${MdsDataStatusControlMasterTable.schema}.${MdsDataStatusControlMasterTable.name}`;
    const DimProductMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_master",
    };
    const DimProductMasterTableRef = `${DimProductMasterTable.database}.${DimProductMasterTable.schema}.${DimProductMasterTable.name}`;
    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;
    const DimCompanyTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_company",
    };
    const DimCompanyTableRef = `${DimCompanyTable.database}.${DimCompanyTable.schema}.${DimCompanyTable.name}`;
    const DimCustomerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_customer",
    };
    const DimCustomerTableRef = `${DimCustomerTable.database}.${DimCustomerTable.schema}.${DimCustomerTable.name}`;
    const DimStoreTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_store",
    };
    const DimStoreTableRef = `${DimStoreTable.database}.${DimStoreTable.schema}.${DimStoreTable.name}`;







}
SELECT
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(
    output_row.company_id AS company_id,
    output_row.mihYear AS mihYear,
    output_row.mihMonth AS mihMonth,
    output_row.mihDay AS mihDay,
    output_row.cpsVnosID AS cpsVnosID,
    output_row.cpsCusID AS cpsCusID,
    output_row.cpsStkID AS cpsStkID,
    ROW_NUMBER() OVER (
      PARTITION BY output_row.company_id, output_row.mihYear, output_row.mihMonth, output_row.mihDay, output_row.cpsVnosID, output_row.cpsCusID, output_row.cpsStkID
      ORDER BY TO_JSON_STRING(output_row)
    ) AS occ
  ))) AS FactBacklogStoreSK,
  output_row.*
FROM (
WITH cps_latest AS (
  SELECT cps.*
  FROM ${ref(databuffet.VALIDATED_MAC5, 'cps')} AS cps
  INNER JOIN (
    SELECT company_id, MAX(asatdate) AS max_asatdate
    FROM ${ref(databuffet.VALIDATED_MAC5, 'cps')}
    GROUP BY company_id
  ) AS m
    ON  cps.company_id = m.company_id
    AND cps.asatdate   = m.max_asatdate

), dim_order_dedup AS (
  SELECT ord.OrderSK, ord.CompanySK, ord.mihVnos
  FROM `${DimOrderTableRef}` as ord
  INNER JOIN `${MdsDataStatusControlMasterTableRef}` as mds
    on mds.is_active = true
    and mds.flagwarehouse = true
    and ord.CompanyID = mds.CompanyID
    and ord.mihStatus = mds.StatusID
  WHERE IFNULL(ord.mihDesc,'') NOT LIKE '%PO.วางบิล%'
    AND ord.mix_date >= DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 4 YEAR), YEAR)
  QUALIFY ROW_NUMBER() OVER(PARTITION BY ord.CompanySK, ord.mihVnos ORDER BY ord.OrderSK DESC) = 1

), dim_product_dedup AS (
  SELECT m.ProductSK, m.CompanySK, m.ProductCode, m.ProductGroupMAC5
  FROM `${DimProductMasterTableRef}` as m
  LEFT JOIN `${DimProductMktTableRef}` as mkt
    on m.ProductMktSK = mkt.ProductMktSK
  WHERE mkt.TypeMarketing not in ('Sourcing')
    and m.companyid in ('ag01', 'ab01')
  QUALIFY ROW_NUMBER() OVER(PARTITION BY m.CompanySK, m.ProductCode ORDER BY m.ProductSK) = 1

), mil_line_scope AS (
  SELECT DISTINCT mil.company_id, mil.milVnos, mil.milStk
  FROM ${ref(databuffet.CURATED_MAC5, 'curated_mil')} AS mil
  WHERE mil.milType = 'PS'
    AND mil.milstype not in (3)
    AND LEFT(mil.milstk,1) not in ('บ')
    AND mil.milstk NOT LIKE 'TEST%'

), source_data AS (
  SELECT
    dim_com.CompanySK,
    mih.company_id,
    SAFE.PARSE_DATE('%Y%m%d', CONCAT(mih.mihYear, FORMAT("%02d", mih.mihMonth), FORMAT("%02d", mih.mihDay))) AS sDate,
    mih.mihYear,
    mih.mihMonth,
    mih.mihDay,
    dim_ord.OrderSK,
    dim_cust.CustomerSK,
    dim_prod.ProductSK,
    IFNULL(dim_sto.StoreSK, -1) AS StoreSK,
    cps.cpsVnosID,
    cps.cpsCusID,
    cps.cpsStkID,
    cps.cpsSto,
    (CASE 
      WHEN cps.cpssumreq = 0.0 
        or dim_prod.ProductGroupMAC5 = '5000' 
        THEN 'Yes'
      ELSE 'No'
    END) as FlagFree,
    SUM(cps.cpsStkREQ)                        AS cpsStkREQ,
    SUM(cps.cpsStkCUT1)                       AS cpsStkCUT1,
    SUM(cps.cpsStkREQ) - SUM(cps.cpsStkCUT1)  AS qty
  FROM ${ref(databuffet.CURATED_MAC5, 'curated_mih')} AS mih
  INNER JOIN cps_latest AS cps
    ON  mih.company_id = cps.company_id
    AND mih.mihVnos    = cps.cpsVnosID
    AND mih.mihCus     = cps.cpsCusID
  LEFT JOIN `${DimCompanyTableRef}` AS dim_com
    ON mih.company_id = dim_com.companyID
  INNER JOIN dim_order_dedup AS dim_ord
    ON  dim_ord.CompanySK = dim_com.CompanySK
    AND dim_ord.mihVnos   = mih.mihVnos
  LEFT JOIN `${DimCustomerTableRef}` AS dim_cust
    ON  dim_cust.CompanySK = dim_com.CompanySK
    AND dim_cust.debcode   = mih.mihCus
  INNER JOIN dim_product_dedup AS dim_prod
    ON  dim_prod.CompanySK   = dim_com.CompanySK
    AND dim_prod.ProductCode = cps.cpsStkID
  INNER JOIN mil_line_scope AS mil_scope
    ON  mil_scope.company_id = mih.company_id
    AND mil_scope.milVnos    = cps.cpsVnosID
    AND mil_scope.milStk     = cps.cpsStkID
  LEFT JOIN `${DimStoreTableRef}` AS dim_sto
    ON  dim_sto.CompanySK = dim_com.CompanySK
    AND dim_sto.StoreCode = cps.cpsSto
  WHERE mih.mihType     = 'PS'
    AND mih.mihCancel   = 0
    AND mih.mihClearUM  = 0
    AND mih.mihExtraSUM = 0
    AND mih.company_id in ('ag01', 'ab01')
    AND IFNULL(mih.mihDesc,'') NOT LIKE '%PO.วางบิล%'
    AND LEFT(cps.cpsStkID,1) not in ('บ')
    AND SAFE.PARSE_DATE('%Y%m%d', CONCAT(mih.mihYear, FORMAT("%02d", mih.mihMonth), FORMAT("%02d", mih.mihDay))) >= DATE_TRUNC(DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL 4 YEAR), YEAR)
  GROUP BY
    CompanySK, company_id, sDate, mihYear, mihMonth, mihDay,
    OrderSK, CustomerSK, ProductSK, StoreSK,
    cpsVnosID, cpsCusID, cpsStkID, cpsSto, FlagFree
)

SELECT
  source_data.*,
FROM source_data
) AS output_row

pre_operations {}

post_operations {}
