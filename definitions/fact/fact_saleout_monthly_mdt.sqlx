config {
    type: "table",
    schema: databuffet.FACT_TABLE,
    dependencies: ["dim_sales_branch_mdt", "dim_product_mdt", "dim_product_mkt", "dim_report", "dim_region", "dim_region_manager", "dim_director"],
    // fact_daily ไม่ใช่ fact_monthly — ตารางนี้สร้างใหม่ทุกวันเพราะต้นทาง
    // curated_saleout_monthly_mdt เปลี่ยนทุกวัน · แท็ก fact_monthly ไม่มีใครเรียกเลย
    // ทำให้ตารางค้างขณะที่ต้นทางเดินหน้าไปแล้ว (เจอ 2026-10-06 รอบอัตโนมัติรอบแรก)
    tags: [databuffet.TAG_FACT_DAILY, databuffet.TAG_SALEOUT_DAILY],
    uniqueKey: ["month_date", "store_code", "branch_code", "sales_channel", "product_code"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["store_code", "branch_sk", "product_mdt_sk"]
    },
}

/*
  ยอดขายออกรายเดือนที่ห้างส่งมาเอง — ไว้เทียบกับ fact_saleout_mdt ที่มาจากฟีดรายวัน
  1 แถว = 1 ห้าง x 1 สาขา x 1 ช่องทางขาย x 1 สินค้า x 1 เดือน
  ที่มาของแต่ละห้าง / ข้อจำกัด / กับดัก: document/how-to/saleout-monthly-fact-design.md
*/

js {
    // ต้นทางอยู่ใน Dataform แล้วตั้งแต่ 2026-10-05 — เลิกใช้ onetime.saleout_monthly_mdt
    // ที่ปั้นด้วยมือและสร้างใหม่จากโค้ดไม่ได้ · ตัวใหม่เลือกแหล่งเองต่อ (เดือน, ห้าง):
    // ไฟล์ปิดงวดจากห้าง > ไฟล์ BI > ยุบจากฟีดรายวัน — ดู curated_saleout_monthly_mdt.sqlx
    const DimSalesBranchMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_sales_branch_mdt",
    };
    const DimSalesBranchMdtTableRef = `${DimSalesBranchMdtTable.database}.${DimSalesBranchMdtTable.schema}.${DimSalesBranchMdtTable.name}`;
    const DimProductMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mdt",
    };
    const DimProductMdtTableRef = `${DimProductMdtTable.database}.${DimProductMdtTable.schema}.${DimProductMdtTable.name}`;
    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;
    const DimReportTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_report",
    };
    const DimReportTableRef = `${DimReportTable.database}.${DimReportTable.schema}.${DimReportTable.name}`;
    const DimRegionTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region",
    };
    const DimRegionTableRef = `${DimRegionTable.database}.${DimRegionTable.schema}.${DimRegionTable.name}`;
    const DimRegionManagerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_region_manager",
    };
    const DimRegionManagerTableRef = `${DimRegionManagerTable.database}.${DimRegionManagerTable.schema}.${DimRegionManagerTable.name}`;
    const DimDirectorTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_director",
    };
    const DimDirectorTableRef = `${DimDirectorTable.database}.${DimDirectorTable.schema}.${DimDirectorTable.name}`;

}

WITH branch_lookup AS (

  -- TRIM เพราะไฟล์ TW ส่งชื่อสาขามาพร้อมช่องว่างท้าย — ไม่ TRIM จับได้ 0%
  SELECT TRIM(StoreCode) AS store_code, TRIM(BranchCode) AS branch_code,
         ANY_VALUE(BranchMdtSK) AS BranchMdtSK, ANY_VALUE(ZoneMdtSK) AS ZoneMdtSK
  FROM `${DimSalesBranchMdtTableRef}`
  GROUP BY 1, 2

), mkt_group AS (

  SELECT ProductMktSK, MarketingGroupID
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY ProductMktSK ORDER BY MarketingGroupID) = 1
), waiting_mkt AS (

  -- แถว 999 Waiting Master · หาด้วย MarketingGroupID ไม่ใช่ฮาร์ดโค้ด SK เพราะ SK เปลี่ยนทุกวัน
  SELECT ANY_VALUE(ProductMktSK) AS WaitingMktSK
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01' AND MarketingGroupID = '999'

), report_exact AS (

  -- dim_report.RegionID ฝั่ง MDT คือรหัสห้าง ไม่ใช่ภูมิภาค (เหมือน fact_saleout_mdt)
  SELECT RegionID AS store_code, MarketingGroupID, ReportSK
  FROM `${DimReportTableRef}` WHERE companyID = 'ag01' AND MarketingGroupID IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, MarketingGroupID ORDER BY companyID, ReportID, RegionID, MarketingGroupID) = 1

), report_fallback AS (

  -- แถว Other ของแต่ละห้าง — แยก CTE เพราะ join ด้วย NULL = NULL ไม่เป็นจริง
  SELECT RegionID AS store_code, ReportSK
  FROM `${DimReportTableRef}` WHERE companyID = 'ag01' AND MarketingGroupID IS NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID ORDER BY companyID, ReportID, RegionID, MarketingGroupID) = 1

), product_lookup AS (

  SELECT ProductCode,
         ANY_VALUE(ProductMdtSK) AS ProductMdtSK,
         ANY_VALUE(ProductSK)    AS ProductSK,
         ANY_VALUE(ProductMktSK) AS ProductMktSK
  FROM `${DimProductMdtTableRef}`
  GROUP BY 1

), region_at_month AS (
  -- ภาค ณ เดือนนั้น · dim เปลี่ยนค่าเฉพาะวันที่ 1 ของเดือน จึง lookup ด้วย s.month_date ได้เลย
  SELECT RegionID, SubRegionID, RegionSK, DirectorID, StartDate, EndDate
  FROM `${DimRegionTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, StartDate ORDER BY SubRegionID, companyID, RegionID, StartDate, EndDate) = 1

), region_manager_at_month AS (

  SELECT RegionID, RegionManagerSK, StartDate, EndDate
  FROM `${DimRegionManagerTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, StartDate ORDER BY SubRegionID, companyID, RegionID, StartDate, EndDate) = 1

), director_at_month AS (
  -- ต้องผ่าน dim_region ก่อนเพราะ DirectorID อยู่ที่นั่น ไม่ได้อยู่กับ store_code
  SELECT DirectorID, DirectorSK, StartDate, EndDate
  FROM `${DimDirectorTableRef}`
  WHERE companyID = 'ag01'
  QUALIFY ROW_NUMBER() OVER(PARTITION BY DirectorID, StartDate ORDER BY companyID, DirectorID, StartDate, EndDate) = 1

)

SELECT
  -- ⚠️ เกรนผสม เดือนเดินอยู่=รายวัน เดือนปิดแล้ว=ก้อนเดียว · query ต้อง group ด้วย DATE_TRUNC
  s.month_date,
  s.store_code,
  s.branch_code,
  s.sales_channel,
  s.product_code,
  s.product_name,

  IFNULL(b.BranchMdtSK,  -1) AS branch_sk,
  IFNULL(b.ZoneMdtSK,    -1) AS zone_sk,
  IFNULL(p.ProductMdtSK, -1) AS product_mdt_sk,
  IFNULL(p.ProductSK,    -1) AS product_sk,
  -- NULLIF จับทั้งสองกรณี: สินค้าที่ไม่มีในทะเบียนเลย (NULL) และที่มีแต่ยังไม่ได้จัดกลุ่ม (-1)
  IFNULL(NULLIF(p.ProductMktSK, -1), IFNULL((SELECT WaitingMktSK FROM waiting_mkt), -1)) AS product_mkt_sk,
  COALESCE(rep.ReportSK, rep_fb.ReportSK, -1) AS report_sk,
  IFNULL(rg.RegionSK,         -1) AS region_sk,
  IFNULL(rgm.RegionManagerSK, -1) AS region_manager_sk,
  IFNULL(dr.DirectorSK,       -1) AS director_sk,

  s.sale_qty,
  s.sale_amount,

  CURRENT_DATE('Asia/Bangkok') AS asatdate
FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_saleout_monthly_mdt")} AS s
LEFT JOIN branch_lookup AS b
  ON  b.store_code  = s.store_code
  AND b.branch_code = TRIM(s.branch_code)
-- ตัด 0 นำหน้าก่อน join เหมือน fact_saleout_mdt — TW ส่งรหัสพร้อม 0 นำหน้าทุกตัว
LEFT JOIN product_lookup AS p
  ON p.ProductCode = LTRIM(s.product_code, '0')
  LEFT JOIN mkt_group AS mkt
  ON mkt.ProductMktSK = p.ProductMktSK
LEFT JOIN report_exact AS rep
  ON  rep.store_code = s.store_code AND rep.MarketingGroupID = mkt.MarketingGroupID
LEFT JOIN report_fallback AS rep_fb
  ON rep_fb.store_code = s.store_code

LEFT JOIN region_at_month AS rg
  ON  rg.RegionID = s.store_code
  AND s.month_date BETWEEN rg.StartDate AND rg.EndDate
LEFT JOIN region_manager_at_month AS rgm
  ON  rgm.RegionID = s.store_code
  AND s.month_date BETWEEN rgm.StartDate AND rgm.EndDate
LEFT JOIN director_at_month AS dr
  ON  dr.DirectorID = rg.DirectorID
  AND s.month_date BETWEEN dr.StartDate AND dr.EndDate

