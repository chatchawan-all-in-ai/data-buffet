config {
    type: "table",
    schema: databuffet.FACT_TABLE,
    dependencies: ["dim_sales_branch_mdt", "dim_product_mdt", "dim_product_mkt", "dim_report"],
    tags: [databuffet.TAG_FACT_MONTHLY],
    uniqueKey: ["month_date", "store_code", "branch_code", "sales_channel", "product_code"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["store_code", "branch_sk", "product_mdt_sk"]
    },
}

/*
  ยอดขายออกรายเดือนที่ห้างส่งมาเอง — ไว้เทียบกับ fact_saleout_mdt ที่มาจากฟีดรายวัน
  1 แถว = 1 ห้าง x 1 สาขา x 1 ช่องทางขาย x 1 สินค้า x 1 เดือน
  ที่มาของแต่ละห้าง / ข้อจำกัด / กับดัก: document/how-to/saleout-monthly-fact-design.md
*/

js {
    // ต้นทางชั่วคราว — สลับเป็น validated เมื่อไฟล์ขึ้น GCS แล้ว (ดูเอกสาร §สิ่งที่ยังขาด)
    const SourceRef = `${databuffet.DATABASE}.onetime.saleout_monthly_mdt`;
    const DimBranchRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_sales_branch_mdt`;
    const DimProductRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_product_mdt`;
    const DimProductMktRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_product_mkt`;
    const DimReportRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_report`;
}

WITH branch_lookup AS (

  -- TRIM เพราะไฟล์ TW ส่งชื่อสาขามาพร้อมช่องว่างท้าย — ไม่ TRIM จับได้ 0%
  SELECT TRIM(StoreCode) AS store_code, TRIM(BranchCode) AS branch_code,
         ANY_VALUE(BranchMdtSK) AS BranchMdtSK, ANY_VALUE(ZoneMdtSK) AS ZoneMdtSK
  FROM `${DimBranchRef}`
  GROUP BY 1, 2

), mkt_group AS (

  SELECT ProductMktSK, ANY_VALUE(MarketingGroupID) AS MarketingGroupID
  FROM `${DimProductMktRef}` WHERE CompanyID = 'ag01' GROUP BY 1

), report_exact AS (

  -- dim_report.RegionID ฝั่ง MDT คือรหัสห้าง ไม่ใช่ภูมิภาค (เหมือน fact_saleout_mdt)
  SELECT RegionID AS store_code, MarketingGroupID, ReportSK
  FROM `${DimReportRef}` WHERE companyID = 'ag01' AND MarketingGroupID IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID, MarketingGroupID ORDER BY ReportSK) = 1

), report_fallback AS (

  -- แถว Other ของแต่ละห้าง — แยก CTE เพราะ join ด้วย NULL = NULL ไม่เป็นจริง
  SELECT RegionID AS store_code, ReportSK
  FROM `${DimReportRef}` WHERE companyID = 'ag01' AND MarketingGroupID IS NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY RegionID ORDER BY ReportSK) = 1

), product_lookup AS (

  SELECT ProductCode,
         ANY_VALUE(ProductMdtSK) AS ProductMdtSK,
         ANY_VALUE(ProductSK)    AS ProductSK,
         ANY_VALUE(ProductMktSK) AS ProductMktSK
  FROM `${DimProductRef}`
  GROUP BY 1

)

SELECT
  s.month_date,
  s.store_code,
  s.branch_code,
  s.sales_channel,
  s.product_code,
  s.product_name,

  IFNULL(b.BranchMdtSK,  -1) AS branch_sk,
  IFNULL(b.ZoneMdtSK,    -1) AS zone_sk,
  IFNULL(p.ProductMdtSK, -1) AS product_mdt_sk,
  IFNULL(p.ProductSK,    -1) AS product_sk,
  IFNULL(p.ProductMktSK, -1) AS product_mkt_sk,
  COALESCE(rep.ReportSK, rep_fb.ReportSK, -1) AS report_sk,

  s.sale_qty,
  s.sale_amount,

  CURRENT_DATE('Asia/Bangkok') AS asatdate
FROM `${SourceRef}` AS s
LEFT JOIN branch_lookup AS b
  ON  b.store_code  = s.store_code
  AND b.branch_code = TRIM(s.branch_code)
-- ตัด 0 นำหน้าก่อน join เหมือน fact_saleout_mdt — TW ส่งรหัสพร้อม 0 นำหน้าทุกตัว
LEFT JOIN product_lookup AS p
  ON p.ProductCode = LTRIM(s.product_code, '0')
  LEFT JOIN mkt_group AS mkt
  ON mkt.ProductMktSK = p.ProductMktSK
LEFT JOIN report_exact AS rep
  ON  rep.store_code = s.store_code AND rep.MarketingGroupID = mkt.MarketingGroupID
LEFT JOIN report_fallback AS rep_fb
  ON rep_fb.store_code = s.store_code

