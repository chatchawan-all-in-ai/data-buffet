config {
    type: "incremental",
    schema: databuffet.VALIDATED_MASTER_SKU,
    dependencies: ["validated_schema_master_sku", "create_all_table_raw_master_sku"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["product_id", "sales_channel_id", "business_unit_id", "effective_date"],
    bigquery: {
        partitionBy : "asatdate",
        clusterBy: ["product_id", "sales_channel_id", "business_unit_id", "effective_date"]
    },
}

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MASTER_SKU,
        name: name(),
    };

    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;
    const pk_key = ["product_id", "sales_channel_id", "business_unit_id", "effective_date"]
    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY asatdate DESC, updated_at DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;
    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
  IFNULL(${databuffet.functionData.cleanString('product_id')}, '') AS product_id,
  IFNULL(${databuffet.functionData.cleanString('sales_channel_id')}, '') AS sales_channel_id,
  IFNULL(${databuffet.functionData.cleanString('business_unit_id')}, '') AS business_unit_id,
  ${databuffet.functionData.castInt64('normal_discount_percent')} AS normal_discount_percent,
  ${databuffet.functionData.castInt64('special_discount_percent_1')} AS special_discount_percent_1,
  ${databuffet.functionData.castInt64('special_discount_percent_2')} AS special_discount_percent_2,
  ${databuffet.functionData.castInt64('special_discount_percent_3')} AS special_discount_percent_3,
  ${databuffet.functionData.castFloat64('minimum_price')} AS minimum_price,
  ${databuffet.functionData.castFloat64('minimum_discount')} AS minimum_discount,
  ${databuffet.functionData.castFloat64('marketing_price')} AS marketing_price,
  IFNULL(${databuffet.functionData.cleanString('effective_date')}, '') AS effective_date,
  ${databuffet.functionData.cleanString('expiration_date')} AS expiration_date,
  ${databuffet.functionData.cleanString('status')} AS status,
  ${databuffet.functionData.parseFlexibleUtcDatetime('created_at')} AS created_at,
  ${databuffet.functionData.cleanString('created_by')} AS created_by,
  ${databuffet.functionData.parseFlexibleUtcDatetime('updated_at')} AS updated_at,
  ${databuffet.functionData.cleanString('updated_by')} AS updated_by,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,
FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
