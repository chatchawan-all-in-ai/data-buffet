config {
    type: "incremental",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "mirtype","mirvnos","mirlistno"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["company_id", "mirtype", "mirvnos", "mircus"]
    },
}

js {
    const pk_key = ["company_id", "mirtype","mirvnos","mirlistno"]

    const doc_key = ["company_id", "mirtype", "mirvnos"]
    const temp_table = "new_data_mir";

    const doc_match = doc_key.map(k => k === "company_id"
        ? `b.company_id = t.company_id`
        : `IFNULL(b.${k}, '') = IFNULL(t.${k}, '')`).join("\n      AND ");

    const delete_statement = `
    DELETE FROM ${self()} AS t
    WHERE EXISTS (
      SELECT 1
      FROM ${temp_table} AS b
      WHERE ${doc_match}
    );`;

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY mirbinvdate desc, mirdesc desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
    const MirAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "mir",
    };
    const MirAg01TableRef = `${MirAg01Table.database}.${MirAg01Table.schema}.${MirAg01Table.name}`;

    const MirAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "mir",
    };
    const MirAa05TableRef = `${MirAa05Table.database}.${MirAa05Table.schema}.${MirAa05Table.name}`;

    const MirAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "mir",
    };
    const MirAb01TableRef = `${MirAb01Table.database}.${MirAb01Table.schema}.${MirAb01Table.name}`;

    const MirAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "mir",
    };
    const MirAc02TableRef = `${MirAc02Table.database}.${MirAc02Table.schema}.${MirAc02Table.name}`;

    const MirAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "mir",
    };
    const MirAk02TableRef = `${MirAk02Table.database}.${MirAk02Table.schema}.${MirAk02Table.name}`;
}

SELECT * FROM new_data_mir

pre_operations {
  CREATE OR REPLACE TEMP TABLE new_data_mir AS
  WITH all_sources AS (
  SELECT 'ag01' AS company_id,
    ${databuffet.functionData.castInt64('mirday')} as mirday,
    ${databuffet.functionData.castInt64('mirmonth')} as mirmonth,
    ${databuffet.functionData.castInt64('miryear')} as miryear,
    ${databuffet.functionData.cleanString('mirtype')} as mirtype,
    ${databuffet.functionData.cleanString('mirvnos')} as mirvnos,
    ${databuffet.functionData.cleanString('mircus')} as mircus,
    ${databuffet.functionData.castInt64('mirlistno')} as mirlistno,
    ${databuffet.functionData.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.functionData.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.functionData.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.functionData.cleanString('mirdesc')} as mirdesc,
    ${databuffet.functionData.castFloat64('mircog')} as mircog,
    ${databuffet.functionData.castFloat64('mirvat')} as mirvat,
    ${databuffet.functionData.castFloat64('mirsum')} as mirsum,
    ${databuffet.functionData.castInt64('mircurc')} as mircurc,
    ${databuffet.functionData.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.functionData.castInt64('mirtag')} as mirtag,
    ${databuffet.functionData.cleanString('mirnotes')} as mirnotes,
    ${databuffet.functionData.cleanString('miraccount')} as miraccount,
    ${databuffet.functionData.parseAsatDate()} as asatdate

  FROM `${MirAg01TableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL
  SELECT 'aa05' AS company_id,
    ${databuffet.functionData.castInt64('mirday')} as mirday,
    ${databuffet.functionData.castInt64('mirmonth')} as mirmonth,
    ${databuffet.functionData.castInt64('miryear')} as miryear,
    ${databuffet.functionData.cleanString('mirtype')} as mirtype,
    ${databuffet.functionData.cleanString('mirvnos')} as mirvnos,
    ${databuffet.functionData.cleanString('mircus')} as mircus,
    ${databuffet.functionData.castInt64('mirlistno')} as mirlistno,
    ${databuffet.functionData.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.functionData.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.functionData.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.functionData.cleanString('mirdesc')} as mirdesc,
    ${databuffet.functionData.castFloat64('mircog')} as mircog,
    ${databuffet.functionData.castFloat64('mirvat')} as mirvat,
    ${databuffet.functionData.castFloat64('mirsum')} as mirsum,
    ${databuffet.functionData.castInt64('mircurc')} as mircurc,
    ${databuffet.functionData.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.functionData.castInt64('mirtag')} as mirtag,
    ${databuffet.functionData.cleanString('mirnotes')} as mirnotes,
    ${databuffet.functionData.cleanString('miraccount')} as miraccount,
    ${databuffet.functionData.parseAsatDate()} as asatdate

  FROM `${MirAa05TableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL
  SELECT 'ab01' AS company_id,
    ${databuffet.functionData.castInt64('mirday')} as mirday,
    ${databuffet.functionData.castInt64('mirmonth')} as mirmonth,
    ${databuffet.functionData.castInt64('miryear')} as miryear,
    ${databuffet.functionData.cleanString('mirtype')} as mirtype,
    ${databuffet.functionData.cleanString('mirvnos')} as mirvnos,
    ${databuffet.functionData.cleanString('mircus')} as mircus,
    ${databuffet.functionData.castInt64('mirlistno')} as mirlistno,
    ${databuffet.functionData.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.functionData.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.functionData.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.functionData.cleanString('mirdesc')} as mirdesc,
    ${databuffet.functionData.castFloat64('mircog')} as mircog,
    ${databuffet.functionData.castFloat64('mirvat')} as mirvat,
    ${databuffet.functionData.castFloat64('mirsum')} as mirsum,
    ${databuffet.functionData.castInt64('mircurc')} as mircurc,
    ${databuffet.functionData.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.functionData.castInt64('mirtag')} as mirtag,
    ${databuffet.functionData.cleanString('mirnotes')} as mirnotes,
    ${databuffet.functionData.cleanString('miraccount')} as miraccount,
    ${databuffet.functionData.parseAsatDate()} as asatdate

  FROM `${MirAb01TableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL
  SELECT 'ac02' AS company_id,
    ${databuffet.functionData.castInt64('mirday')} as mirday,
    ${databuffet.functionData.castInt64('mirmonth')} as mirmonth,
    ${databuffet.functionData.castInt64('miryear')} as miryear,
    ${databuffet.functionData.cleanString('mirtype')} as mirtype,
    ${databuffet.functionData.cleanString('mirvnos')} as mirvnos,
    ${databuffet.functionData.cleanString('mircus')} as mircus,
    ${databuffet.functionData.castInt64('mirlistno')} as mirlistno,
    ${databuffet.functionData.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.functionData.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.functionData.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.functionData.cleanString('mirdesc')} as mirdesc,
    ${databuffet.functionData.castFloat64('mircog')} as mircog,
    ${databuffet.functionData.castFloat64('mirvat')} as mirvat,
    ${databuffet.functionData.castFloat64('mirsum')} as mirsum,
    ${databuffet.functionData.castInt64('mircurc')} as mircurc,
    ${databuffet.functionData.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.functionData.castInt64('mirtag')} as mirtag,
    ${databuffet.functionData.cleanString('mirnotes')} as mirnotes,
    ${databuffet.functionData.cleanString('miraccount')} as miraccount,
    ${databuffet.functionData.parseAsatDate()} as asatdate

  FROM `${MirAc02TableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  UNION ALL
  SELECT 'ak02' AS company_id,
    ${databuffet.functionData.castInt64('mirday')} as mirday,
    ${databuffet.functionData.castInt64('mirmonth')} as mirmonth,
    ${databuffet.functionData.castInt64('miryear')} as miryear,
    ${databuffet.functionData.cleanString('mirtype')} as mirtype,
    ${databuffet.functionData.cleanString('mirvnos')} as mirvnos,
    ${databuffet.functionData.cleanString('mircus')} as mircus,
    ${databuffet.functionData.castInt64('mirlistno')} as mirlistno,
    ${databuffet.functionData.cleanString('mirbinvno')} as mirbinvno,
    ${databuffet.functionData.parseFlexibleDatetime('mirbinvdate')} AS mirbinvdate,
    ${databuffet.functionData.cleanString('mirbinvtype')} as mirbinvtype,
    ${databuffet.functionData.cleanString('mirdesc')} as mirdesc,
    ${databuffet.functionData.castFloat64('mircog')} as mircog,
    ${databuffet.functionData.castFloat64('mirvat')} as mirvat,
    ${databuffet.functionData.castFloat64('mirsum')} as mirsum,
    ${databuffet.functionData.castInt64('mircurc')} as mircurc,
    ${databuffet.functionData.castFloat64('mirexchg')} as mirexchg,
    ${databuffet.functionData.castInt64('mirtag')} as mirtag,
    ${databuffet.functionData.cleanString('mirnotes')} as mirnotes,
    ${databuffet.functionData.cleanString('miraccount')} as miraccount,
    ${databuffet.functionData.parseAsatDate()} as asatdate

  FROM `${MirAk02TableRef}`
  ${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }

  )
  SELECT * FROM all_sources
  ${partition_statement}
  ;

  ${ when(incremental(), delete_statement) }
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
