config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "stgcode"],
    bigquery: {
        clusterBy: ["company_id", "stgcode"]
    },
}

js {
    const pk_key = ["company_id", "stgcode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY stgdesct desc, stgdesce desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }

    const StgAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "stg",
    };
    const StgAg01TableRef = `${StgAg01Table.database}.${StgAg01Table.schema}.${StgAg01Table.name}`;

    const StgAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "stg",
    };
    const StgAa05TableRef = `${StgAa05Table.database}.${StgAa05Table.schema}.${StgAa05Table.name}`;

    const StgAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "stg",
    };
    const StgAb01TableRef = `${StgAb01Table.database}.${StgAb01Table.schema}.${StgAb01Table.name}`;

    const StgAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "stg",
    };
    const StgAc02TableRef = `${StgAc02Table.database}.${StgAc02Table.schema}.${StgAc02Table.name}`;

    const StgAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "stg",
    };
    const StgAk02TableRef = `${StgAk02Table.database}.${StgAk02Table.schema}.${StgAk02Table.name}`;
}
WITH stgacc AS (
    SELECT stgcode, gacccode, gaccname
    FROM ${ref(databuffet.VALIDATED_MAC5, "stgacc")} as stgacc
    LEFT JOIN ${ref(databuffet.VALIDATED_MAC5, "stg_report")} as stg_report
        ON stgacc.gacccode = stg_report.stgacccode
    QUALIFY row_number() over(partition by stgcode order by gacccode desc) = 1
),
all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.cleanCode('stg.stgcode', "r'[\\n\\r\\t-.]'")} as stgcode,
    ${databuffet.functionData.cleanString('stg.stgdesct')} as stgdesct,
    ${databuffet.functionData.cleanString('stg.stgdesce')} as stgdesce,

    ${databuffet.functionData.cleanString('stgacc.gacccode')} as gacccode,
    ${databuffet.functionData.cleanString('stgacc.gaccname')} as gaccname
  FROM `${StgAg01TableRef}` as stg
  LEFT JOIN stgacc as stgacc ON stg.stgcode = stgacc.stgcode

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.cleanCode('stg.stgcode', "r'[\\n\\r\\t-.]'")} as stgcode,
    ${databuffet.functionData.cleanString('stg.stgdesct')} as stgdesct,
    ${databuffet.functionData.cleanString('stg.stgdesce')} as stgdesce,

    ${databuffet.functionData.cleanString('stgacc.gacccode')} as gacccode,
    ${databuffet.functionData.cleanString('stgacc.gaccname')} as gaccname
  FROM `${StgAa05TableRef}` as stg
  LEFT JOIN stgacc as stgacc ON stg.stgcode = stgacc.stgcode

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.cleanCode('stg.stgcode', "r'[\\n\\r\\t-.]'")} as stgcode,
    ${databuffet.functionData.cleanString('stg.stgdesct')} as stgdesct,
    ${databuffet.functionData.cleanString('stg.stgdesce')} as stgdesce,

    ${databuffet.functionData.cleanString('stgacc.gacccode')} as gacccode,
    ${databuffet.functionData.cleanString('stgacc.gaccname')} as gaccname
  FROM `${StgAb01TableRef}` as stg
  LEFT JOIN stgacc as stgacc ON stg.stgcode = stgacc.stgcode

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.cleanCode('stg.stgcode', "r'[\\n\\r\\t-.]'")} as stgcode,
    ${databuffet.functionData.cleanString('stg.stgdesct')} as stgdesct,
    ${databuffet.functionData.cleanString('stg.stgdesce')} as stgdesce,

    ${databuffet.functionData.cleanString('stgacc.gacccode')} as gacccode,
    ${databuffet.functionData.cleanString('stgacc.gaccname')} as gaccname
  FROM `${StgAc02TableRef}` as stg
  LEFT JOIN stgacc as stgacc ON stg.stgcode = stgacc.stgcode

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.cleanCode('stg.stgcode', "r'[\\n\\r\\t-.]'")} as stgcode,
    ${databuffet.functionData.cleanString('stg.stgdesct')} as stgdesct,
    ${databuffet.functionData.cleanString('stg.stgdesce')} as stgdesce,

    ${databuffet.functionData.cleanString('stgacc.gacccode')} as gacccode,
    ${databuffet.functionData.cleanString('stgacc.gaccname')} as gaccname
  FROM `${StgAk02TableRef}` as stg
  LEFT JOIN stgacc as stgacc ON stg.stgcode = stgacc.stgcode
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
