config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "ar_scode"],
    bigquery: {
        clusterBy: ["company_id", "ar_scode"]
    },
}

js {
    const pk_key = ["company_id", "ar_scode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ar_snamet desc, ar_snamee desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
    const ArSAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "ar_s",
    };
    const ArSAg01TableRef = `${ArSAg01Table.database}.${ArSAg01Table.schema}.${ArSAg01Table.name}`;

    const ArSAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "ar_s",
    };
    const ArSAa05TableRef = `${ArSAa05Table.database}.${ArSAa05Table.schema}.${ArSAa05Table.name}`;

    const ArSAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "ar_s",
    };
    const ArSAb01TableRef = `${ArSAb01Table.database}.${ArSAb01Table.schema}.${ArSAb01Table.name}`;

    const ArSAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "ar_s",
    };
    const ArSAc02TableRef = `${ArSAc02Table.database}.${ArSAc02Table.schema}.${ArSAc02Table.name}`;

    const ArSAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "ar_s",
    };
    const ArSAk02TableRef = `${ArSAk02Table.database}.${ArSAk02Table.schema}.${ArSAk02Table.name}`;
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.castInt64('ar_scode')} as ar_scode,
    ${databuffet.functionData.cleanString('ar_snamet')} as ar_snamet,
    ${databuffet.functionData.cleanString('ar_snamee')} as ar_snamee,
    ${databuffet.functionData.castInt64('ar_scolf')} as ar_scolf,
    ${databuffet.functionData.castInt64('ar_scolb')} as ar_scolb
  FROM `${ArSAg01TableRef}`

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.castInt64('ar_scode')} as ar_scode,
    ${databuffet.functionData.cleanString('ar_snamet')} as ar_snamet,
    ${databuffet.functionData.cleanString('ar_snamee')} as ar_snamee,
    ${databuffet.functionData.castInt64('ar_scolf')} as ar_scolf,
    ${databuffet.functionData.castInt64('ar_scolb')} as ar_scolb
  FROM `${ArSAa05TableRef}`

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.castInt64('ar_scode')} as ar_scode,
    ${databuffet.functionData.cleanString('ar_snamet')} as ar_snamet,
    ${databuffet.functionData.cleanString('ar_snamee')} as ar_snamee,
    ${databuffet.functionData.castInt64('ar_scolf')} as ar_scolf,
    ${databuffet.functionData.castInt64('ar_scolb')} as ar_scolb
  FROM `${ArSAb01TableRef}`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.castInt64('ar_scode')} as ar_scode,
    ${databuffet.functionData.cleanString('ar_snamet')} as ar_snamet,
    ${databuffet.functionData.cleanString('ar_snamee')} as ar_snamee,
    ${databuffet.functionData.castInt64('ar_scolf')} as ar_scolf,
    ${databuffet.functionData.castInt64('ar_scolb')} as ar_scolb
  FROM `${ArSAc02TableRef}`

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.castInt64('ar_scode')} as ar_scode,
    ${databuffet.functionData.cleanString('ar_snamet')} as ar_snamet,
    ${databuffet.functionData.cleanString('ar_snamee')} as ar_snamee,
    ${databuffet.functionData.castInt64('ar_scolf')} as ar_scolf,
    ${databuffet.functionData.castInt64('ar_scolb')} as ar_scolb
  FROM `${ArSAk02TableRef}`
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
