config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "ap_scode"],
    bigquery: {
        clusterBy: ["company_id", "ap_scode"]
    },
}

js {
    const pk_key = ["company_id", "ap_scode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ap_snamet desc, ap_snamee desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
    const ApSAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "ap_s",
    };
    const ApSAg01TableRef = `${ApSAg01Table.database}.${ApSAg01Table.schema}.${ApSAg01Table.name}`;

    const ApSAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "ap_s",
    };
    const ApSAa05TableRef = `${ApSAa05Table.database}.${ApSAa05Table.schema}.${ApSAa05Table.name}`;

    const ApSAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "ap_s",
    };
    const ApSAb01TableRef = `${ApSAb01Table.database}.${ApSAb01Table.schema}.${ApSAb01Table.name}`;

    const ApSAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "ap_s",
    };
    const ApSAc02TableRef = `${ApSAc02Table.database}.${ApSAc02Table.schema}.${ApSAc02Table.name}`;

    const ApSAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "ap_s",
    };
    const ApSAk02TableRef = `${ApSAk02Table.database}.${ApSAk02Table.schema}.${ApSAk02Table.name}`;
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.castInt64('ap_scode')} as ap_scode,
    ${databuffet.functionData.cleanString('ap_snamet')} as ap_snamet,
    ${databuffet.functionData.cleanString('ap_snamee')} as ap_snamee,
    ${databuffet.functionData.castInt64('ap_scolf')} as ap_scolf,
    ${databuffet.functionData.castInt64('ap_scolb')} as ap_scolb
  FROM `${ApSAg01TableRef}`

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.castInt64('ap_scode')} as ap_scode,
    ${databuffet.functionData.cleanString('ap_snamet')} as ap_snamet,
    ${databuffet.functionData.cleanString('ap_snamee')} as ap_snamee,
    ${databuffet.functionData.castInt64('ap_scolf')} as ap_scolf,
    ${databuffet.functionData.castInt64('ap_scolb')} as ap_scolb
  FROM `${ApSAa05TableRef}`

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.castInt64('ap_scode')} as ap_scode,
    ${databuffet.functionData.cleanString('ap_snamet')} as ap_snamet,
    ${databuffet.functionData.cleanString('ap_snamee')} as ap_snamee,
    ${databuffet.functionData.castInt64('ap_scolf')} as ap_scolf,
    ${databuffet.functionData.castInt64('ap_scolb')} as ap_scolb
  FROM `${ApSAb01TableRef}`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.castInt64('ap_scode')} as ap_scode,
    ${databuffet.functionData.cleanString('ap_snamet')} as ap_snamet,
    ${databuffet.functionData.cleanString('ap_snamee')} as ap_snamee,
    ${databuffet.functionData.castInt64('ap_scolf')} as ap_scolf,
    ${databuffet.functionData.castInt64('ap_scolb')} as ap_scolb
  FROM `${ApSAc02TableRef}`

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.castInt64('ap_scode')} as ap_scode,
    ${databuffet.functionData.cleanString('ap_snamet')} as ap_snamet,
    ${databuffet.functionData.cleanString('ap_snamee')} as ap_snamee,
    ${databuffet.functionData.castInt64('ap_scolf')} as ap_scolf,
    ${databuffet.functionData.castInt64('ap_scolb')} as ap_scolb
  FROM `${ApSAk02TableRef}`
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
