config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "depcode"],
    bigquery: {
        clusterBy: ["company_id", "depcode"]
    },
}

js {
    const pk_key = ["company_id", "depcode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY depeditdt desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
    const DepAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "dep",
    };
    const DepAg01TableRef = `${DepAg01Table.database}.${DepAg01Table.schema}.${DepAg01Table.name}`;

    const DepAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "dep",
    };
    const DepAa05TableRef = `${DepAa05Table.database}.${DepAa05Table.schema}.${DepAa05Table.name}`;

    const DepAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "dep",
    };
    const DepAb01TableRef = `${DepAb01Table.database}.${DepAb01Table.schema}.${DepAb01Table.name}`;

    const DepAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "dep",
    };
    const DepAc02TableRef = `${DepAc02Table.database}.${DepAc02Table.schema}.${DepAc02Table.name}`;

    const DepAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "dep",
    };
    const DepAk02TableRef = `${DepAk02Table.database}.${DepAk02Table.schema}.${DepAk02Table.name}`;
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.cleanString('depcode')} as depcode,
    ${databuffet.functionData.cleanString('depgroup')} as depgroup,
    ${databuffet.functionData.cleanString('depdesct')} as depdesct,
    ${databuffet.functionData.cleanString('depdesce')} as depdesce,
    ${databuffet.functionData.castInt64('dephide')} as dephide,
    ${databuffet.functionData.castInt64('deplock')} as deplock,
    ${databuffet.functionData.parseFlexibleDatetime('depeditdt')} AS depeditdt,
    ${databuffet.functionData.cleanString('depeditmf')} as depeditmf
  FROM `${DepAg01TableRef}`

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.cleanString('depcode')} as depcode,
    ${databuffet.functionData.cleanString('depgroup')} as depgroup,
    ${databuffet.functionData.cleanString('depdesct')} as depdesct,
    ${databuffet.functionData.cleanString('depdesce')} as depdesce,
    ${databuffet.functionData.castInt64('dephide')} as dephide,
    ${databuffet.functionData.castInt64('deplock')} as deplock,
    ${databuffet.functionData.parseFlexibleDatetime('depeditdt')} AS depeditdt,
    ${databuffet.functionData.cleanString('depeditmf')} as depeditmf
  FROM `${DepAa05TableRef}`

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.cleanString('depcode')} as depcode,
    ${databuffet.functionData.cleanString('depgroup')} as depgroup,
    ${databuffet.functionData.cleanString('depdesct')} as depdesct,
    ${databuffet.functionData.cleanString('depdesce')} as depdesce,
    ${databuffet.functionData.castInt64('dephide')} as dephide,
    ${databuffet.functionData.castInt64('deplock')} as deplock,
    ${databuffet.functionData.parseFlexibleDatetime('depeditdt')} AS depeditdt,
    ${databuffet.functionData.cleanString('depeditmf')} as depeditmf
  FROM `${DepAb01TableRef}`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.cleanString('depcode')} as depcode,
    ${databuffet.functionData.cleanString('depgroup')} as depgroup,
    ${databuffet.functionData.cleanString('depdesct')} as depdesct,
    ${databuffet.functionData.cleanString('depdesce')} as depdesce,
    ${databuffet.functionData.castInt64('dephide')} as dephide,
    ${databuffet.functionData.castInt64('deplock')} as deplock,
    ${databuffet.functionData.parseFlexibleDatetime('depeditdt')} AS depeditdt,
    ${databuffet.functionData.cleanString('depeditmf')} as depeditmf
  FROM `${DepAc02TableRef}`

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.cleanString('depcode')} as depcode,
    ${databuffet.functionData.cleanString('depgroup')} as depgroup,
    ${databuffet.functionData.cleanString('depdesct')} as depdesct,
    ${databuffet.functionData.cleanString('depdesce')} as depdesce,
    ${databuffet.functionData.castInt64('dephide')} as dephide,
    ${databuffet.functionData.castInt64('deplock')} as deplock,
    ${databuffet.functionData.parseFlexibleDatetime('depeditdt')} AS depeditdt,
    ${databuffet.functionData.cleanString('depeditmf')} as depeditmf
  FROM `${DepAk02TableRef}`
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
