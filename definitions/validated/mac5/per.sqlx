config {
    type: "table",
    schema: databuffet.VALIDATED_MAC5,
    dependencies: ["validated_schema_mac5", "create_all_table_raw_mac5", "create_all_table_raw_mac5_aa05", "create_all_table_raw_mac5_ab01", "create_all_table_raw_mac5_ac02", "create_all_table_raw_mac5_ak02"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["company_id", "percode"],
    bigquery: {
        clusterBy: ["company_id", "percode"]
    },
}

js {
    const pk_key = ["company_id", "percode"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY perbdate desc, pernamet desc, pernamee desc) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
    const PerAg01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AG01,
        name: "per",
    };
    const PerAg01TableRef = `${PerAg01Table.database}.${PerAg01Table.schema}.${PerAg01Table.name}`;

    const PerAa05Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AA05,
        name: "per",
    };
    const PerAa05TableRef = `${PerAa05Table.database}.${PerAa05Table.schema}.${PerAa05Table.name}`;

    const PerAb01Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AB01,
        name: "per",
    };
    const PerAb01TableRef = `${PerAb01Table.database}.${PerAb01Table.schema}.${PerAb01Table.name}`;

    const PerAc02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AC02,
        name: "per",
    };
    const PerAc02TableRef = `${PerAc02Table.database}.${PerAc02Table.schema}.${PerAc02Table.name}`;

    const PerAk02Table = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_MAC5_AK02,
        name: "per",
    };
    const PerAk02TableRef = `${PerAk02Table.database}.${PerAk02Table.schema}.${PerAk02Table.name}`;
}

WITH all_sources AS (
  SELECT
    'ag01' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    ${databuffet.functionData.cleanString('perzone')} as perzone
  FROM `${PerAg01TableRef}`

  UNION ALL

  SELECT
    'aa05' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    CAST(NULL AS STRING) as perzone
  FROM `${PerAa05TableRef}`

  UNION ALL

  SELECT
    'ab01' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    CAST(NULL AS STRING) as perzone
  FROM `${PerAb01TableRef}`

  UNION ALL

  SELECT
    'ac02' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    CAST(NULL AS STRING) as perzone
  FROM `${PerAc02TableRef}`

  UNION ALL

  SELECT
    'ak02' AS company_id,
    ${databuffet.functionData.cleanString('percode')} as percode,
    ${databuffet.functionData.cleanString('perdep')} as perdep,
    ${databuffet.functionData.cleanString('pertaxnos')} as pertaxnos,
    ${databuffet.functionData.cleanString('pernamet')} as pernamet,
    ${databuffet.functionData.cleanString('pernamee')} as pernamee,
    ${databuffet.functionData.parseFlexibleDatetime('perbdate')} AS perbdate,
    ${databuffet.functionData.parseFlexibleDatetime('perworks')} AS perworks,
    ${databuffet.functionData.parseFlexibleDatetime('perworkf')} AS perworkf,
    ${databuffet.functionData.cleanString('peradd1')} as peradd1,
    ${databuffet.functionData.cleanString('peradd2')} as peradd2,
    ${databuffet.functionData.cleanString('peradd3')} as peradd3,
    ${databuffet.functionData.cleanString('pertel')} as pertel,
    ${databuffet.functionData.cleanString('perpositn')} as perpositn,
    ${databuffet.functionData.castInt64('perstatus')} as perstatus,
    ${databuffet.functionData.castInt64('pernchild')} as pernchild,
    ${databuffet.functionData.castInt64('percisstudy')} as percisstudy,
    ${databuffet.functionData.castInt64('pernotstudy')} as pernotstudy,
    ${databuffet.functionData.castFloat64('persalary')} as persalary,
    ${databuffet.functionData.castInt64('perhide')} as perhide,
    ${databuffet.functionData.castInt64('perlock')} as perlock,
    ${databuffet.functionData.cleanString('permemo')} as permemo,
    ${databuffet.functionData.parseFlexibleDatetime('pereditlk')} AS pereditlk,
    ${databuffet.functionData.cleanString('perrefwe')} as perrefwe,
    ${databuffet.functionData.parseFlexibleDatetime('pereditdt')} AS pereditdt,
    ${databuffet.functionData.cleanString('pereditmf')} as pereditmf,
    CAST(NULL AS STRING) as perzone
  FROM `${PerAk02TableRef}`
)

SELECT * FROM all_sources
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
