config {
  type: "incremental",
  schema: databuffet.VALIDATED_DERP,
  dependencies: ["validated_schema_derp", "create_all_table_raw_derp"],
  tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
  uniqueKey: ["formula_versions_id"],
  bigquery: {
    partitionBy: "asatdate",
    clusterBy: ["formula_versions_id"]
  },
}

js {
  const sourceTable = {
    database: databuffet.DATABASE,
    schema: databuffet.RAW_DERP,
    name: name(),
  };

  const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

  const pk_key = ["formula_versions_id"]

  let partition_statement, post_operations_statement;

  if (pk_key && pk_key.length > 0) {
    partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY updated_datetime DESC, created_datetime DESC, asatdate DESC) = 1`;
    post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;
  } else {
    partition_statement = "";
    post_operations_statement = "";
  }
}

SELECT
  IFNULL(${databuffet.functionData.cleanString('formula_versions_id')}, '') AS formula_versions_id,
  ${databuffet.functionData.cleanString('id')} AS id,
  ${databuffet.functionData.cleanString('manufactured_item_number')} AS manufactured_item_number,
  ${databuffet.functionData.cleanString('formula_id')} AS formula_id,
  ${databuffet.functionData.cleanString('production_site_id')} AS production_site_id,
  ${databuffet.functionData.cleanString('product_configuration_id')} AS product_configuration_id,
  ${databuffet.functionData.cleanString('product_color_id')} AS product_color_id,
  ${databuffet.functionData.cleanString('product_size_id')} AS product_size_id,
  ${databuffet.functionData.cleanString('product_style_id')} AS product_style_id,
  ${databuffet.functionData.cleanString('product_version_id')} AS product_version_id,
  ${databuffet.functionData.cleanString('is_active')} = 'Y' AS is_active,
  ${databuffet.functionData.parseFlexibleDate(databuffet.functionData.cleanString('valid_from_date'))} AS valid_from_date,
  ${databuffet.functionData.castFloat64('from_quantity')} AS from_quantity,
  ${databuffet.functionData.cleanString('bulk_item_number')} AS bulk_item_number,
  ${databuffet.functionData.castFloat64('catch_weight_size')} AS catch_weight_size,
  ${databuffet.functionData.cleanString('is_selected_for_designer')} = 'Yes' AS is_selected_for_designer,
  ${databuffet.functionData.cleanString('version_name')} AS version_name,
  ${databuffet.functionData.parseFlexibleDate(databuffet.functionData.cleanString('changed_date'))} AS changed_date,
  ${databuffet.functionData.castFloat64('formula_batch_size_multiples')} AS formula_batch_size_multiples,
  ${databuffet.functionData.cleanString('is_co_product_quantity_variation_allowed')} = 'Yes' AS is_co_product_quantity_variation_allowed,
  ${databuffet.functionData.castFloat64('from_catch_weight_quantity')} AS from_catch_weight_quantity,
  ${databuffet.functionData.castFloat64('yield_percentage')} AS yield_percentage,
  ${databuffet.functionData.cleanString('approver_personnel_number')} AS approver_personnel_number,
  ${databuffet.functionData.castFloat64('formula_batch_size')} AS formula_batch_size,
  ${databuffet.functionData.cleanString('is_approved')} = 'Yes' AS is_approved,
  ${databuffet.functionData.cleanString('will_cost_calculation_include_version')} = 'Yes' AS will_cost_calculation_include_version,
  ${databuffet.functionData.parseFlexibleDate(databuffet.functionData.cleanString('valid_to_date'))} AS valid_to_date,
  ${databuffet.functionData.cleanString('is_total_cost_allocation_used')} = 'Yes' AS is_total_cost_allocation_used,
  ${databuffet.functionData.cleanString('ivzs_bom_accessories')} = 'Yes' AS ivzs_bom_accessories,
  ${databuffet.functionData.cleanString('remarks')} AS remarks,
  ${databuffet.functionData.parseFlexibleUtcDatetime('created_datetime')} AS created_datetime,
  ${databuffet.functionData.cleanString('created_by')} AS created_by,
  ${databuffet.functionData.parseFlexibleUtcDatetime('updated_datetime')} AS updated_datetime,
  ${databuffet.functionData.cleanString('updated_by')} AS updated_by,
  ${databuffet.functionData.cleanString('product_id')} AS product_id,
  ${databuffet.functionData.cleanString('site_id')} AS site_id,
  ${databuffet.functionData.parseAsatDate()} AS asatdate,
FROM
  `${sourceTableRef}` ${when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`)} ${partition_statement}

pre_operations {
}

post_operations {
  ${when(!incremental(), post_operations_statement)}
}
