config {
    type: "incremental",
    schema: databuffet.VALIDATED_DERP,
    dependencies: ["validated_schema_derp", "create_all_table_raw_derp"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["quotation_sale_id"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["quotation_sale_id"]
    },
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.RAW_DERP,
        name: name(),
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // Keep existing logic
    const pk_key = ["quotation_sale_id"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY updated_at DESC, asatdate DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

-- วันเวลาใน raw เป็นเวลาไทยอยู่แล้ว (ไม่ใช่ UTC) → parseFlexibleDatetime
-- quotation_date ส่งมาเป็น 'YYYY-MM-DD 00:00:00' เสมอ → เก็บเป็น DATE
SELECT
    IFNULL(${databuffet.functionData.cleanString('quotation_sale_id')}, '') AS quotation_sale_id,
    ${databuffet.functionData.cleanString('quotation_id')} AS quotation_id,
    ${databuffet.functionData.cleanString('quotation_no')} AS quotation_no,
    DATE(${databuffet.functionData.parseFlexibleDatetime('quotation_date')}) AS quotation_date,
    ${databuffet.functionData.castInt64('sales_seq')} AS sales_seq,
    ${databuffet.functionData.cleanString('sales_id')} AS sales_id,
    ${databuffet.functionData.cleanString('sales_code')} AS sales_code,
    ${databuffet.functionData.cleanString('sales_name')} AS sales_name,
    ${databuffet.functionData.castFloat64('sales_amount')} AS sales_amount,
    ${databuffet.functionData.castFloat64('sales_amount_pct')} AS sales_amount_pct,
    ${databuffet.functionData.castFloat64('commission_pct')} AS commission_pct,
    ${databuffet.functionData.castInt64('order_sort')} AS order_sort,
    ${databuffet.functionData.cleanString('path_id')} AS path_id,
    ${databuffet.functionData.cleanString('path_code')} AS path_code,
    ${databuffet.functionData.cleanString('path_name')} AS path_name,
    ${databuffet.functionData.cleanString('status')} AS status,
    ${databuffet.functionData.cleanString('created_by')} AS created_by,
    ${databuffet.functionData.cleanString('updated_by')} AS updated_by,
    ${databuffet.functionData.parseFlexibleDatetime('created_at')} AS created_at,
    ${databuffet.functionData.parseFlexibleDatetime('updated_at')} AS updated_at,
    ${databuffet.functionData.cleanString('created_by_name')} AS created_by_name,
    ${databuffet.functionData.cleanString('updated_by_name')} AS updated_by_name,
    ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
