config {
    type: "incremental",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL, databuffet.TAG_SALEOUT_DAILY],
    uniqueKey: ["branch", "article_id", "distribution_channel", "end_date"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["branch", "article_id", "end_date"]
    },
}

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     name(),
    };
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    const pk_key = ["branch", "article_id", "distribution_channel", "end_date"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.functionData.cleanString('BRANCH')} AS branch,
    ${databuffet.functionData.cleanString('ARTICLE_ID')} AS article_id,


    CASE ${databuffet.functionData.cleanString('DISTRIBUTION_CHANNEL')}
        WHEN 'Website' THEN 'Web'
        ELSE ${databuffet.functionData.cleanString('DISTRIBUTION_CHANNEL')}
    END AS distribution_channel,

    -- ช่วงที่ยอดสะสมครอบ: start_date เป็นวันที่ 1 ของเดือนเสมอ
    -- end_date คือวันสุดท้ายที่ยอดนับถึง ไม่ใช่วันที่ขายล่าสุด
    PARSE_DATE('%Y/%m/%d', ${databuffet.functionData.cleanString('START_DATE')}) AS start_date,
    PARSE_DATE('%Y/%m/%d', ${databuffet.functionData.cleanString('END_DATE')}) AS end_date,

    -- ค่าสะสมตั้งแต่ต้นเดือน (MTD) ไม่ใช่ยอดของวัน — ห้าม SUM ข้ามวัน
    -- ยอดรายวันคำนวณที่ชั้น curated ด้วย LAG ดู project_wiki/validated/validated-layer.md
    ${databuffet.functionData.castFloat64('NET_INC_TAX')} AS net_inc_tax_mtd,
    ${databuffet.functionData.castInt64('SALE_QTY')} AS sale_qty_mtd,
    ${databuffet.functionData.castFloat64('SALE_SQM')} AS sale_sqm_mtd,

    ${databuffet.functionData.cleanString('ARTICLE_NAME_TH')} AS article_name_th,
    ${databuffet.functionData.cleanString('BRAND')} AS brand,
    ${databuffet.functionData.cleanString('FLAG_PROJECT')} AS flag_project,
    ${databuffet.functionData.cleanString('ITEM_FLAG')} AS item_flag,
    ${databuffet.functionData.cleanString('MCH3')} AS mch3,
    ${databuffet.functionData.cleanString('MCH2')} AS mch2,

    ${databuffet.functionData.castInt64('YEAR_DATE_ID')} AS year_date_id,
    ${databuffet.functionData.cleanString('MONTH_DATE_ID')} AS month_date_id,

    ${databuffet.functionData.cleanString('VENDOR_ID')} AS vendor_id,
    ${databuffet.functionData.cleanString('VENDOR_NAME')} AS vendor_name,

    ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
