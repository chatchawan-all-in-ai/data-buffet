config {
    type: "table",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["Store", "SKU", "Last_Sold_Date"]
    },
}


SELECT
    ${databuffet.functionData.cleanString('Store')} as Store,
    ${databuffet.functionData.cleanString('Cat')} as Cat,
    ${databuffet.functionData.cleanString('Sub_Cat')} as Sub_Cat,
    ${databuffet.functionData.cleanString('Brand')} as Brand,
    ${databuffet.functionData.cleanString('SKU')} as SKU,
    ${databuffet.functionData.cleanString('Barcode')} as Barcode,
    ${databuffet.functionData.cleanString('Description')} as Description,
    ${databuffet.functionData.cleanString('Product_Type')} as Product_Type,
    CAST(Sales_Amount as FLOAT64) as Sales_Amount,
    CAST(Sales_Qty as INT64) as Sales_Qty,
    CAST(Stock_On_Hand as FLOAT64) as Stock_On_Hand,
    CAST(Stock_On_Order as INT64) as Stock_On_Order,
    ${databuffet.functionData.parseDateDash('TRIM(Last_Sold_Date)')} as Last_Sold_Date,
    ${databuffet.functionData.parseDateDash('TRIM(Last_Receive_Date)')} as Last_Receive_Date,
    ${databuffet.functionData.parseAsatDate()} as ASATDATE,
FROM `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.report_sale_subscription`

pre_operations {
}

post_operations {
}