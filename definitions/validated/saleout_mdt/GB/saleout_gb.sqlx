config {
    type: "incremental",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED],
    uniqueKey: ["sale_no", "sale_date", "branch_code", "product_code"],
    bigquery: {
        partitionBy: "asatdate",
                clusterBy: ["sale_date", "branch_code", "product_code", "sale_no"]
    },
}

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "saleout_gb",
    };
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;
    const pk_key = ["sale_no", "sale_date", "branch_code", "product_code"]
    const datePart = (i) => `CAST(SPLIT(TRIM(Sale_Date), '/')[SAFE_OFFSET(${i})] AS INT64)`;
    const saleDateExpr = `IF(${datePart(2)} >= 2500,
        SAFE.DATE(${datePart(2)} - 543, ${datePart(1)}, ${datePart(0)}),
        SAFE.DATE(${datePart(2)},       ${datePart(0)}, ${datePart(1)}))`;

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    ${databuffet.functionData.cleanString('No_')} AS row_no,
    ${databuffet.functionData.cleanString('Sale_No_')} AS sale_no,
    ${saleDateExpr} AS sale_date,
    ${databuffet.functionData.cleanString('Branch_Code')} AS branch_code,
    ${databuffet.functionData.cleanString('Branch_Name')} AS branch_name,
    ${databuffet.functionData.cleanString('Branch_Short_Name')} AS branch_short_name,
    ${databuffet.functionData.cleanString('Product_Code')} AS product_code,
    ${databuffet.functionData.cleanString('Product_Name')} AS product_name,
    ${databuffet.functionData.castInt64('Sale_Quantity')} AS sale_quantity,
    CAST(REGEXP_REPLACE(TRIM(Sale_Amount), r"[,\']", '') AS FLOAT64) AS sale_amount,
    ${databuffet.functionData.cleanString('Type')} AS type,
    ${databuffet.functionData.cleanString('Reference_No_')} AS reference_no,
    ${databuffet.functionData.cleanString('Deposit_No_')} AS deposit_no,
    ${databuffet.functionData.parseAsatDate()} as ASATDATE,
FROM `${sourceTableRef}`
WHERE Sale_Date IS NOT NULL AND TRIM(Sale_Date) <> ''
${ when(incremental(), `AND ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}


pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
