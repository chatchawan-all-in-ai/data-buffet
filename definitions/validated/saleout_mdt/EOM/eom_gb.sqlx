config {
    type: "table",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_FULL],
    uniqueKey: ["month_date", "branch_code", "product_code", "doc_type"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["branch_code", "product_code"]
    },
}

/*
  ยอดปิดรายเดือนที่โกลบอลเฮ้าส์ส่งมาเอง (โฟลเดอร์ SO_MDT_EOM)
  คนละชุดกับ saleout_gb ซึ่งเป็นฟีดรายวัน — ตัวนี้คือ "ยอดที่ห้างแจ้ง" ไว้เทียบว่าเราเก็บหายไปเท่าไร

  type: "table" เพราะห้างส่งไฟล์แก้ย้อนหลังได้ และ ASATDATE เป็นวันที่ DAG รัน ไม่ใช่งวด
  หน้าต่าง incremental จึงใช้ไม่ได้ — ดู known-issues 2026-10-05
*/

js {
    const sourceTableRef = `${databuffet.DATABASE}.${databuffet.RAW_SALEOUT_MDT}.eom_gb`;

    // ปั๊มน้ำ Hitachi — พี่กุ้งสั่งตัดออกจากยอด GB (2026-10-05)
    // ชุดเดียวกับที่ตัดใน curated_saleout_mdt ฝั่งรายวัน ต้องแก้ทั้งสองที่เสมอ
    // ไม่ตัด 8859738138040 'DOS ถังเก็บน้ำคู่ปั๊ม +ปั๊มhitachi' เพราะเป็นสินค้าของเรา
    const HITACHI_PUMPS = `'8850207702816', '8850207702830', '8850207700430'`;
}

WITH src AS (

    SELECT
        -- งวดอยู่ในคอลัมน์ Sale_Date ของทุกแถว ไม่ต้องพึ่งหัวไฟล์หรือ ASATDATE
        -- ⚠️ ห้ามใช้ ASATDATE เป็นงวด — มันคือวันที่ DAG รัน ไฟล์ ส.ค. กับ ก.ย. อยู่พาร์ทิชันเดียวกัน
        DATE_TRUNC(PARSE_DATE('%m/%d/%Y', TRIM(Sale_Date)), MONTH) AS month_date,

        ${databuffet.functionData.cleanCode('Branch_Code')}    AS branch_code,
        ${databuffet.functionData.cleanString('Branch_Name')}  AS branch_name,
        ${databuffet.functionData.cleanCode('Product_Code')}   AS product_code,
        ${databuffet.functionData.cleanString('Product_Name')} AS product_name,
        ${databuffet.functionData.cleanCode('Type')}           AS doc_type,

        -- Sale_Quantity เป็น INT64 อยู่แล้วจาก AVRO จึงใช้ได้ตรง ๆ
        Sale_Quantity AS sale_qty,

        -- Sale_Amount ยังเป็น STRING และสกปรก 2 แบบ ต้องล้างทั้งคู่ก่อน cast
        --   แถวขาย  "1,120"   จุลภาคคั่นหลักพัน
        --   แถวคืน  '-750     อัญประกาศเดี่ยวนำหน้า (Excel ใส่กันค่าถูกตีเป็นสูตร)
        -- ⚠️ ถ้าลบแต่จุลภาค SAFE_CAST จะคืน NULL ให้แถวคืน 85 จาก 96 แถว แล้ว SUM ข้ามไปเงียบ ๆ
        --    ยอดจะเกินไปเท่ากับมูลค่าการคืนพอดี (วัด 2026-10-05: ส.ค. เกิน 274,170.00)
        --    อาการเดียวกับบั๊กเครื่องหมายคืนของ onetime.saleout_monthly_mdt ที่แก้ไปเมื่อเช้า
        SAFE_CAST(REPLACE(REPLACE(TRIM(Sale_Amount), "'", ''), ',', '') AS FLOAT64) AS sale_amount,

        ${databuffet.functionData.parseAsatDate()} AS asatdate,

        -- ไว้ตัดงวดที่ถูกส่งซ้ำ ต้องใช้ค่าดิบเพราะ parseAsatDate แปลงเป็น DATE แล้ว
        ASATDATE AS asat_raw

    FROM `${sourceTableRef}`

    -- ⚠️ ไฟล์ของ GB มีแถวผลรวมต่อท้าย 1 แถวต่อไฟล์ ทุกคอลัมน์เป็น NULL ยกเว้นยอด
    --    วัด 2026-10-05: 2 แถว รวม 40,130,486.81 = ยอดทั้งสองเดือนพอดี
    --    ไม่กรองทิ้งยอดจะเบิ้ลสองเท่าเป๊ะ
    WHERE Sale_No_ IS NOT NULL
      AND Sale_Date IS NOT NULL
      AND Branch_Code IS NOT NULL

      -- ฟีดรายวันมีกฎนี้อยู่แล้ว ใส่ให้ตรงกัน: รหัสที่ไม่ใช่ตัวเลขคือ 'รายได้ค่าขนส่ง' ไม่ใช่การขายสินค้า
      AND (Product_Code IS NULL OR REGEXP_CONTAINS(TRIM(Product_Code), r'^[0-9]+$'))

      AND TRIM(Product_Code) NOT IN (${HITACHI_PUMPS})

), latest AS (

    -- ⚠️ งวดเดียวกันถูกส่งซ้ำได้ (ห้างส่งไฟล์เดิมอีกรอบ) แล้วไปอยู่คนละพาร์ทิชัน ASATDATE
    -- ถ้าไม่ตัด GROUP BY ข้างล่างจะบวกรวมทุกพาร์ทิชัน ยอดเบิ้ลตามจำนวนครั้งที่ส่ง
    -- วัด 2026-10-08: ก.ย. มาถึง 4 พาร์ทิชัน (05/06/07/08) ยอดเป็น 4 เท่าพอดี
    --   ของจริง 15,638,676.75 กลายเป็น 62,554,707.00
    -- ตัดข้ามพาร์ทิชันโดยตั้งใจ (ไม่ใส่ asat_raw ใน PARTITION BY) — เหมือน eom_hp/eom_tw/eom_bt
    -- GB ไม่มีคอลัมน์เวลาสร้างไฟล์แบบ CRDATE ของ HP จึงใช้ ASATDATE เป็นตัวตัด
    SELECT * FROM src
    QUALIFY asat_raw = MAX(asat_raw) OVER (PARTITION BY month_date)

)

-- รวมเป็นเกรนรายเดือน · ห้างส่งมาเป็นรายบรรทัดบิล ต้องยุบ
SELECT
    month_date,
    'GB'                      AS store_code,
    branch_code,
    ANY_VALUE(branch_name)    AS branch_name,
    product_code,
    ANY_VALUE(product_name)   AS product_name,
    doc_type,
    SUM(sale_qty)             AS sale_qty,
    SUM(sale_amount)          AS sale_amount,
    MAX(asatdate)             AS asatdate
FROM latest
GROUP BY month_date, branch_code, product_code, doc_type