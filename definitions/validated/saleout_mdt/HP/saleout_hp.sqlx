config {
    type: "incremental",
    schema: databuffet.VALIDATED_SALEOUT_MDT,
    dependencies: ["validated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_VALIDATED, databuffet.TAG_VALIDATED_INCREMENTAL],
    uniqueKey: ["siteno", "artno", "sale_date"],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["siteno", "artno"]
    },
}

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "saleout_hp",
    };
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // ห้างส่งค่าครอบด้วย ="..." และย้ายคอลัมน์ที่ครอบได้ (เกิดจริง 2-4 ส.ค. 2026)
    // จึงแกะทุกคอลัมน์ข้อความ ไม่เลือกคอลัมน์
    const UNQUOTE = String.raw`r'^="|"$'`;
    const c = (col) => databuffet.functionData.cleanCode(col, UNQUOTE);

    const pk_key = ["siteno", "artno", "sale_date"]

    let partition_statement, post_operations_statement;

    if (pk_key && pk_key.length > 0) {
        partition_statement = `QUALIFY ROW_NUMBER() OVER(PARTITION BY ${pk_key} ORDER BY ASATDATE DESC, value DESC) = 1`;
        post_operations_statement = `
BEGIN
    DECLARE retry_count INT64 DEFAULT 0;
    DECLARE max_retries INT64 DEFAULT 10;
    DECLARE success BOOL DEFAULT FALSE;

    WHILE retry_count < max_retries AND NOT success DO
        BEGIN
            ALTER TABLE ${self()} DROP PRIMARY KEY IF EXISTS;
            ALTER TABLE ${self()} ADD PRIMARY KEY (${pk_key}) NOT ENFORCED;
            SET success = TRUE;
        EXCEPTION WHEN ERROR THEN
            SET retry_count = retry_count + 1;
        END;
    END WHILE;
END;`;

    } else {
        partition_statement = "";
        post_operations_statement = "";
    }
}

SELECT
    -- วันขาย: ห้างให้มาที่ PERIODDATE รูปแบบ วัน/เดือน/ค.ศ. เท่ากับ CRDATE ลบ 1 วัน
    PARSE_DATE('%d/%m/%Y', ${c('PERIODDATE')}) AS sale_date,

    -- ไฟล์เดียวมี 2 ห้าง แยกด้วยตัวอักษรแรกของ SITENO
    -- prefix อื่นได้ NULL โดยเจตนา เพื่อให้ตรวจเจอว่ามีห้างใหม่เข้ามา
    CASE
        WHEN ${c('SITENO')} IN ('M888', 'CS01', 'EX99') THEN 'HP'
        WHEN LEFT(${c('SITENO')}, 1) = 'S' THEN 'HP'
        WHEN LEFT(${c('SITENO')}, 1) = 'M' THEN 'MH'
    END AS store_code,

    ${c('SITENO')} AS siteno,
    ${databuffet.functionData.cleanString('SITENAME')} AS sitename,

    ${c('ARTNO')} AS artno,
    ${databuffet.functionData.cleanString('ARTDESC')} AS artdesc,

    -- VDARTNO เป็นบาร์โค้ด GS1 (ขึ้นต้น 885) ใช้จับคู่กับ dim_product_master.Barcode
    ${c('VDARTNO')} AS vdartno,
    ${databuffet.functionData.cleanString('VDARTDESC')} AS vdartdesc,

    -- ARTEAN เป็นบาร์โค้ดภายในร้าน (ขึ้นต้น 24) เก็บไว้สืบกลับ ห้ามใช้จับคู่สินค้า
    ${c('ARTEAN')} AS artean,

    ${c('ITEMNO')} AS itemno,
    ${databuffet.functionData.cleanString('MCH3')} AS mch3,
    ${databuffet.functionData.cleanString('MCH2DESC')} AS mch2desc,
    ${databuffet.functionData.cleanString('MCH1DESC')} AS mch1desc,

    ${c('VENDORNO')} AS vendorno,
    ${databuffet.functionData.cleanString('VENDORNAME')} AS vendorname,

    ${databuffet.functionData.castInt64('QTY')} AS qty,
    ${databuffet.functionData.castFloat64('VALUE')} AS value,
    ${databuffet.functionData.castInt64('QTY')} < 0 AS is_return,

    ${databuffet.functionData.cleanString('PERIODTYPE')} AS periodtype,
    SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M', ${c('CRDATE')}) AS crdate,

    ${databuffet.functionData.parseAsatDate()} AS asatdate,

FROM
  `${sourceTableRef}`
${ when(incremental(), `WHERE ASATDATE >= FORMAT_DATE("%Y%m%d", DATE_SUB(CURRENT_DATE(\'Asia/Bangkok\'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY))`) }
${partition_statement}

pre_operations {
}

post_operations {
    ${ when(!incremental(), post_operations_statement) }
}
