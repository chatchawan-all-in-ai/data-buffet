config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL, databuffet.TAG_SALEOUT_DAILY],
    uniqueKey: ["month_date", "branch_code", "product_code"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["branch_code", "product_code"]
    },
}
-- ใช้ PERIOD จากหัวไฟล์เพราะ ASATDATE คือวันรัน ไม่ใช่งวด

js {
    const EomTwTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "eom_tw",
    };
    const EomTwTableRef = `${EomTwTable.database}.${EomTwTable.schema}.${EomTwTable.name}`;
}

WITH src AS (

    SELECT
        ${databuffet.functionData.parseFlexibleDate("CONCAT(TRIM(PERIOD), '-01')")} AS month_date,

        -- TW ใช้สตริงเต็ม `60001-CRC Thai Watsadu ...` เป็นรหัสสาขา เหมือนฟีดรายวัน
        ${databuffet.functionData.cleanString('Store')} AS branch_code,

        -- ตัดศูนย์นำหน้าให้ตรงกับ product_code ของ curated (LTRIM(SKU,'0'))
        -- ไม่ตัดแล้วเทียบกับฟีดรายวันไม่ติดสักแถว
        LTRIM(${databuffet.functionData.cleanCode('SKU')}, '0') AS product_code,
        ${databuffet.functionData.cleanString('Description')}   AS product_name,
        ${databuffet.functionData.cleanCode('Barcode')}         AS barcode_match,

        Sales_Qty    AS sale_qty,
        Sales_Amount AS sale_amount,

        ${databuffet.functionData.parseAsatDate()} AS asatdate,
        ASATDATE AS asat_raw

    FROM `${EomTwTableRef}`

    WHERE PERIOD IS NOT NULL
      AND Store IS NOT NULL AND TRIM(Store) <> ''
      AND NOT STARTS_WITH(TRIM(Store), 'Count of Rows')
      AND SKU IS NOT NULL

      -- ไฟล์เป็นรายงานสต็อก+ยอดขาย แถวที่ไม่มีการขายเลยคือรายการสต็อกเฉย ๆ ไม่ใช่ยอดปิดงวด
      -- เก็บแถวที่ qty เป็น 0 แต่มียอดเงิน (และกลับกัน) ไว้ เพราะเป็นการขายจริงที่ผิดปกติ ต้องเห็น
      AND NOT (IFNULL(Sales_Qty, 0) = 0 AND IFNULL(Sales_Amount, 0) = 0)

), file_version AS (

    -- แต่ละ (งวด, เวอร์ชันไฟล์) ซ้ำทั้งยวงหรือเปล่า · min_dup >= 2 = ทุกแถวซ้ำ คือไฟล์ค้างในโฟลเดอร์
    -- ต้องดูเป็นรายงวด ไม่ใช่รวมทั้งตาราง — งวดหนึ่งเบิ้ลแต่อีกงวดปกติ เป็นเรื่องที่เกิดจริง
    SELECT month_date, asat_raw, MIN(c) AS min_dup
    FROM (SELECT month_date, asat_raw, COUNT(*) AS c FROM src AS t GROUP BY 1, 2, TO_JSON_STRING(t))
    GROUP BY 1, 2

), chosen AS (

    -- เวอร์ชันใหม่สุดที่ไม่ซ้ำทั้งยวง — ข้ามไฟล์ค้างไปใช้ของก่อนหน้าแทน ยอดจะได้ไม่เบิ้ล
    SELECT month_date, MAX(asat_raw) AS asat_raw
    FROM file_version
    WHERE min_dup < 2
    GROUP BY 1

), latest AS (

    SELECT s.* FROM src AS s
    INNER JOIN chosen USING (month_date, asat_raw)

), dup_guard AS (

    -- เหลืองวดที่ไม่มีเวอร์ชันดีเลย = ทุกไฟล์ของงวดนั้นค้างซ้ำหมด เลือกให้ไม่ได้ ต้องหยุด
    SELECT IF(COUNT(*) = 0, 0, ERROR(FORMAT(
        'curated_eom_tw: งวด %t ซ้ำทุกเวอร์ชัน ไม่มีไฟล์ดีให้ใช้ — เช็คไฟล์ค้างใน SaleOut_MDT/SO_MDT_EOM/TW', ANY_VALUE(month_date)
    ))) AS ok
    FROM (SELECT month_date FROM src GROUP BY 1
          EXCEPT DISTINCT
          SELECT month_date FROM chosen)

)

SELECT
    month_date,
    'TW'                      AS store_code,
    branch_code,
    product_code,
    ANY_VALUE(product_name)   AS product_name,
    ANY_VALUE(barcode_match)  AS barcode_match,
    SUM(sale_qty)             AS sale_qty,
    SUM(sale_amount)          AS sale_amount,
    MAX(asatdate)             AS asatdate
FROM latest
CROSS JOIN dup_guard
WHERE dup_guard.ok = 0
GROUP BY month_date, branch_code, product_code
