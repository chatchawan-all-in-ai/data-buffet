config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL],
    uniqueKey: ["month_date", "store_code", "branch_code", "product_code"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["store_code", "branch_code", "product_code"]
    },
}

/*
  ยอดปิดรายเดือนที่โฮมโปร/เมกาโฮมส่งมาเอง (โฟลเดอร์ SO_MDT_EOM/HP)
  คนละชุดกับ saleout_hp ซึ่งเป็นฟีดรายวัน — ตัวนี้คือ "ยอดที่ห้างแจ้ง" ไว้เทียบว่าเราเก็บหายไปเท่าไร
  ไฟล์เป็น CSV หน้าตาเดียวกับฟีดรายวันเป๊ะ ต่างแค่ PERIODTYPE = 'M' และ PERIODDATE เป็น เดือน/ปี

  type: "table" เพราะ ASATDATE เป็นวันที่ DAG รัน ไม่ใช่งวด — หน้าต่าง incremental ใช้ไม่ได้
  ตารางเล็ก (หลักพันแถวต่อเดือน) อ่านเต็มทุกรอบไม่แพง · ดู known-issues 2026-10-05
*/

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "eom_hp",
    };
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

    // ห้างส่งค่าครอบด้วย ="..." กันเลขศูนย์นำหาย — แกะทุกคอลัมน์ข้อความเหมือนฟีดรายวัน
    const UNQUOTE = String.raw`r'^="|"$'`;
    const c = (col) => databuffet.functionData.cleanCode(col, UNQUOTE);
}

WITH src AS (

    SELECT
        -- งวดอยู่ที่ PERIODDATE รูปแบบ เดือน/ปี (เช่น 09/2026) ไม่มีวัน
        -- ⚠️ ห้ามใช้ ASATDATE เป็นงวด — มันคือวันที่ DAG รัน ไฟล์หลายงวดอยู่พาร์ทิชันเดียวกันได้
        PARSE_DATE('%m/%Y', ${c('PERIODDATE')}) AS month_date,

        -- ไฟล์เดียวมี 2 ห้าง แยกด้วย SITENO · ใช้กฎเดียวกับ saleout_hp เป๊ะ
        -- prefix อื่นได้ NULL โดยเจตนา เพื่อให้ตรวจเจอว่ามีห้างใหม่เข้ามา
        CASE
            WHEN ${c('SITENO')} IN ('M888', 'CS01', 'EX99') THEN 'HP'
            WHEN LEFT(${c('SITENO')}, 1) = 'S' THEN 'HP'
            WHEN LEFT(${c('SITENO')}, 1) = 'M' THEN 'MH'
        END AS store_code,

        ${c('SITENO')}                                      AS branch_code,
        ${databuffet.functionData.cleanString('SITENAME')}   AS branch_name,

        -- ARTNO คือรหัสสินค้าที่ฟีดรายวันใช้เป็นคีย์ ต้องใช้ตัวเดียวกันถึงจะเทียบกันได้
        ${c('ARTNO')}                                        AS product_code,
        ${databuffet.functionData.cleanString('ARTDESC')}    AS product_name,

        -- VDARTNO เป็นบาร์โค้ด GS1 (ขึ้นต้น 885) ใช้จับคู่ dim_product_master.Barcode
        -- ARTEAN เป็นบาร์โค้ดภายในร้าน (ขึ้นต้น 24) ห้ามใช้จับคู่สินค้า
        ${c('VDARTNO')}                                      AS vdartno,

        ${databuffet.functionData.castInt64('QTY')}          AS sale_qty,
        ${databuffet.functionData.castFloat64('VALUE')}      AS sale_amount,

        SAFE.PARSE_DATETIME('%d/%m/%Y %H:%M', ${c('CRDATE')}) AS crdate,
        ${databuffet.functionData.parseAsatDate()}            AS asatdate

    FROM `${sourceTableRef}`
    WHERE PERIODDATE IS NOT NULL AND SITENO IS NOT NULL

), latest AS (

    -- ⚠️ หนึ่งพาร์ทิชันมีหลายงวด และงวดเดียวกันมีหลายเวอร์ชัน
    -- DAG รวมทุกไฟล์ในโฟลเดอร์เป็น AVRO ก้อนเดียวต่อวันที่รัน ไฟล์เก่าที่ยังไม่ถูก archive จึงติดมาด้วย
    -- วัด 2026-10-05: 6 ไฟล์ = 7,173 แถว · งวด 09 มาจาก 3 ไฟล์ (23.77M / 24.19M / 27.04M)
    --
    -- เลือกเวอร์ชันล่าสุดต่องวดด้วย CRDATE ซึ่งห้างประทับมาในทุกแถว — เชื่อถือได้กว่าชื่อไฟล์
    -- ตัดข้ามพาร์ทิชันโดยตั้งใจ (ไม่ใส่ ASATDATE ใน PARTITION BY) เพราะงวดเดิมถูกส่งซ้ำวันหลังได้
    -- ไม่ตัดซ้ำยอดเดือน 9 จะเบิ้ลเป็น 75M
    SELECT * FROM src
    QUALIFY crdate = MAX(crdate) OVER (PARTITION BY month_date)

)

-- ยุบเป็นเกรนรายเดือน · วัด 2026-10-05 คีย์ไม่ซ้ำอยู่แล้ว (2,232 แถว = 2,232 คีย์)
-- แต่ GROUP BY ไว้กันห้างส่งรายการแตกบรรทัดในอนาคต
SELECT
    month_date,
    store_code,
    branch_code,
    ANY_VALUE(branch_name)  AS branch_name,
    product_code,
    ANY_VALUE(product_name) AS product_name,
    ANY_VALUE(vdartno)      AS vdartno,
    SUM(sale_qty)           AS sale_qty,
    SUM(sale_amount)        AS sale_amount,
    MAX(crdate)             AS crdate,
    MAX(asatdate)           AS asatdate
FROM latest
GROUP BY month_date, store_code, branch_code, product_code
