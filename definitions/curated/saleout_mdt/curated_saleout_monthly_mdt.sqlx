config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL],
    uniqueKey: ["month_date", "store_code", "branch_code", "product_code"],  // month_date = รายวันในเดือนปัจจุบัน · วันสิ้นเดือนสำหรับเดือนที่ปิดแล้ว
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["store_code", "branch_code", "product_code"]
    },
}

/*
  ยอดขาย Sales Out รายเดือน — ตัวที่ fact_saleout_monthly_mdt ควรอ่าน
  แทนที่ onetime.saleout_monthly_mdt ซึ่งปั้นด้วยมือ สร้างใหม่จากโค้ดไม่ได้ และเคยพังมาแล้ว
  (สคริปต์แปลงไฟล์เดือน 8 คูณ -1 ซ้ำ ทำให้รายการคืนของ GB กลายเป็นบวก เกิน 548,340 บาท
   สคริปต์ตัวนั้นอยู่ใน scratchpad ที่ถูกลบไปแล้ว ไล่กลับไม่ได้ — ดู known-issues 2026-10-05)

  เกรน: เดือน + ห้าง + สาขา + สินค้า  (month_date = วันแรกของเดือน)
  fact ครอบ LAST_DAY() เองอยู่แล้ว ชั้นนี้จึงใช้วันแรกให้สม่ำเสมอ

  เลือกแหล่งต่อ 1 เดือน ต่อ 1 ห้าง ตามลำดับความน่าเชื่อถือ — ตัวแรกที่มีข้อมูลชนะ
    1 CHAIN_FILE    ไฟล์ปิดงวดที่ห้างส่งมาเอง (ชั้น EOM)      ส.ค. 2026 เป็นต้นมา
    2 BI            ไฟล์ที่ทีม BI ส่งให้ตอนตั้งระบบ            2022-01 ถึง 2026-07
    3 DAILY_ROLLUP  ยุบจากฟีดรายวัน                          เดือนที่กำลังเดินอยู่

  ช่วงเวลาแทบไม่ทับกัน — BI จบ ก.ค. 2026 พอดีตรงที่ EOM เริ่ม ส.ค. 2026
  ที่ทับคือเดือนที่ห้างยังไม่ปิดงวด ซึ่ง DAILY_ROLLUP รับไปจนกว่าไฟล์ปิดงวดจะเข้า แล้วสลับเอง

  ⚠️ ห้ามยุบ 3 แหล่งเข้าด้วยกันแบบ SUM เด็ดขาด — มันคือยอดเดียวกันคนละแหล่ง บวกกันคือเบิ้ล
*/

js {
    const LastYearMonthlyRef = `${databuffet.DATABASE}.${databuffet.ONETIME}.saleout_lastyear_monthly`;
}

WITH eom AS (

    -- ⚠️ เอาเฉพาะงวดที่ปิดแล้ว — eom_hp มีงวดเดือนปัจจุบันติดมาด้วยเพราะห้าง export
    --    ถ้าไม่กรอง เดือนปัจจุบันจะถูกตีเป็น CHAIN_FILE ทั้งที่เป็นยอดไม่ครบเดือน
    SELECT * FROM (
        SELECT LAST_DAY(month_date) AS month_date, store_code, branch_code, branch_name,
               product_code, product_name, sale_qty, sale_amount
        FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "eom_gb")}
        UNION ALL
        SELECT LAST_DAY(month_date), store_code, branch_code, branch_name,
               product_code, product_name, sale_qty, sale_amount
        FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "eom_hp")}
        UNION ALL
        -- TW กับ BT ไม่ส่งชื่อสาขาแยกมา ปล่อย NULL ให้ตรงกับที่ onetime เคยเป็น
        SELECT LAST_DAY(month_date), store_code, branch_code, CAST(NULL AS STRING),
               product_code, product_name, sale_qty, sale_amount
        FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "eom_tw")}
        UNION ALL
        SELECT LAST_DAY(month_date), store_code, branch_code, CAST(NULL AS STRING),
               product_code, product_name, sale_qty, sale_amount
        FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "eom_bt")}
    )
    WHERE DATE_TRUNC(month_date, MONTH) < DATE_TRUNC(CURRENT_DATE('Asia/Bangkok'), MONTH)

), bi AS (

    -- ไฟล์ที่ทีม BI ให้มาตอนตั้งระบบ เป็นแหล่งเดียวที่มีประวัติก่อนฟีดรายวันจะเริ่ม
    -- ⚠️ สร้างใหม่จากฟีดรายวันไม่ได้ (ตรงกันแค่ 23 จาก 55 เดือน) จึงยังต้องพึ่ง onetime อยู่จุดเดียว
    -- ⚠️ สาขา DH To go ในไฟล์นี้ไม่มี `_TG` ต่อท้าย แต่ master กับฟีดรายวันใช้ `_TG` ทั้งคู่
    --    ถ้าไม่เติมกลับ จะจับ dim ไม่ได้ แล้ว dim_sales_branch_mdt จะสร้างสาขาซ้ำขึ้นมาเอง
    --    ทำให้ Branch ID / Zone ID ว่างในรายงาน · `KN` ยังจับไม่ได้แม้เติม ต้องให้ทีม master เพิ่ม
    SELECT
        LAST_DAY(month_date) AS month_date,   -- ต้นทางใช้วันสุดท้ายของเดือนอยู่แล้ว ย้ำให้ชัด
        store_code,
        IF(store_code = 'DH' AND REGEXP_CONTAINS(branch_code, r'^M[0-9]+$'),
           CONCAT(branch_code, '_TG'),
           branch_code) AS branch_code,
        branch_name,
        product_code, product_name, sale_qty, sale_amount
    FROM `${LastYearMonthlyRef}`

), daily AS (

    -- ยุบฟีดรายวัน · รับเดือนที่ยังไม่มีไฟล์ปิดงวด และเดือนที่กำลังเดินอยู่
    -- ยอดจะโตขึ้นทุกวันที่รัน จนกว่าไฟล์ปิดงวดจะเข้ามาทับ
    SELECT
        -- เดือนที่กำลังเดินอยู่ = เก็บรายวัน ให้ BI เห็นว่าแต่ละวันขายได้เท่าไร
        -- เดือนที่ปิดแล้ว = ยุบเป็นก้อนเดียวติดป้ายวันสิ้นเดือน (และไฟล์ปิดงวดจะมาทับอยู่แล้ว)
        IF(DATE_TRUNC(sale_date, MONTH) = DATE_TRUNC(CURRENT_DATE('Asia/Bangkok'), MONTH),
           sale_date,
           LAST_DAY(sale_date)) AS month_date,
        store_code,
        branch_code,
        ANY_VALUE(branch_name)  AS branch_name,
        product_code,
        ANY_VALUE(product_name) AS product_name,
        SUM(sale_qty)           AS sale_qty,
        SUM(sale_amount)        AS sale_amount
    FROM ${ref(databuffet.CURATED_SALEOUT_MDT, "curated_saleout_mdt")}
    WHERE store_code IS NOT NULL AND branch_code IS NOT NULL
    GROUP BY month_date, store_code, branch_code, product_code

), all_src AS (

    SELECT 1 AS prio, 'CHAIN_FILE'   AS source_type, DATE_TRUNC(month_date, MONTH) AS period, * FROM eom
    UNION ALL
    SELECT 2, 'BI',           DATE_TRUNC(month_date, MONTH), * FROM bi
    UNION ALL
    SELECT 3, 'DAILY_ROLLUP', DATE_TRUNC(month_date, MONTH), * FROM daily

), winner AS (

    -- แหล่งที่ดีที่สุดที่มีจริงของแต่ละ (เดือน, ห้าง)
    -- ตัดสินที่ระดับห้าง ไม่ใช่ระดับสาขาหรือสินค้า — ไม่งั้นเดือนเดียวจะผสมแหล่งกันจนเทียบไม่ได้
    -- ⚠️ เทียบที่ period (เดือน) ไม่ใช่ month_date — เพราะ DAILY_ROLLUP ของเดือนปัจจุบัน
    -- มี month_date หลายค่า (วันละค่า) ส่วน CHAIN_FILE/BI มีค่าเดียวต่อเดือน
    SELECT period, store_code, MIN(prio) AS prio
    FROM all_src
    GROUP BY period, store_code

)

SELECT
    s.month_date,
    s.store_code,
    s.branch_code,
    s.branch_name,
    '-'           AS sales_channel,   -- เกรนนี้ไม่มีช่องทาง เก็บไว้ให้ schema ตรงกับตัวเดิม
    s.product_code,
    s.product_name,
    s.sale_qty,
    s.sale_amount,
    s.source_type
FROM all_src AS s
INNER JOIN winner AS w
  ON  s.period     = w.period
  AND s.store_code = w.store_code
  AND s.prio       = w.prio
