config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL],
    bigquery: {
        partitionBy: "stock_date",
        clusterBy: ["store_code", "branch_code", "product_code"]
    },
}

WITH bt AS (

    -- บุญถาวร — ไฟล์สต็อกแยกต่างหาก วันสต็อกอยู่ที่ end_date
    -- บางวันส่งซ้ำ 2 ไฟล์ จึงเลือกไฟล์ล่าสุดต่อ (สาขา, สินค้า, วันสต็อก)
    SELECT
        end_date               AS stock_date,
        'BT'                   AS store_code,
        branch                 AS branch_code,   -- BT ใช้ชื่อไทยเป็นรหัสสาขา
        article_id             AS product_code,
        article_name_th        AS product_name,
        ur_qty                 AS onhand_qty,
        ur_cost_amt            AS onhand_amt,    -- ต้นทุน ไม่ใช่ราคาขาย
        CAST(NULL AS INT64)    AS onorder_qty,   -- BT ไม่ส่งของที่กำลังสั่งมา
        asatdate
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "stock_by_branch")}
    WHERE end_date IS NOT NULL
      AND branch IS NOT NULL
      AND article_id IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY branch, article_id, end_date ORDER BY asatdate DESC
    ) = 1

), tw AS (

    -- ไทวัสดุ — สต็อกอยู่ในไฟล์เดียวกับยอดขาย ไม่มีคอลัมน์บอกวันสต็อก
    -- ⚠️ วันสต็อก = วันไฟล์ − 1 ให้ตรงกติกาเดียวกับ BT ซึ่งส่ง end_date = วันไฟล์ − 1 มาตรง ๆ
    --    (ข้อมูลในไฟล์ TW ตามหลังวันไฟล์ 1-2 วันตลอด) ยังไม่ได้ยืนยันกับห้าง
    -- ⚠️ ตัดศูนย์นำหน้ารหัสสินค้า เหมือนบล็อก tw ของ curated_saleout_mdt
    --    ไม่งั้นรหัสไม่ตรงกับ dim_product_mdt และกับยอดขายของตัวเอง
    -- ⚠️ ทิ้งแถวที่ Stock_On_Hand ว่าง — ไม่รู้ว่าเหลือเท่าไหร่ ต่างจากศูนย์ที่แปลว่าของหมด
    -- สาขาต้นทางมีมากกว่าที่จับกับ dim ได้ ส่วนเกินเป็นสาขาเก่าที่ปิดแล้ว ตกเป็น -1 ในชั้น fact ตามดีไซน์
    SELECT
        DATE_SUB(asatdate, INTERVAL 1 DAY) AS stock_date,
        'TW'                         AS store_code,
        Store                        AS branch_code,   -- สตริงเต็ม `60001-CRC Thai Watsadu ...`
        LTRIM(SKU, '0')              AS product_code,
        Description                  AS product_name,
        CAST(Stock_On_Hand AS INT64) AS onhand_qty,
        CAST(NULL AS FLOAT64)        AS onhand_amt,    -- TW ไม่ส่งมูลค่าสต็อกมา
        Stock_On_Order               AS onorder_qty,
        asatdate
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "report_sale_subscription")}
    WHERE Store IS NOT NULL
      AND SKU IS NOT NULL
      AND Stock_On_Hand IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY asatdate, Store, LTRIM(SKU, '0')
        ORDER BY Last_Sold_Date DESC NULLS LAST, Stock_On_Hand DESC
    ) = 1

)
SELECT * FROM bt
UNION ALL
SELECT * FROM tw

pre_operations {
}

post_operations {
}