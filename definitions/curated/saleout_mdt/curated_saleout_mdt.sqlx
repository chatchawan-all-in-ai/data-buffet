config {
    type: "incremental",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_INCREMENTAL],
    uniqueKey: ["sale_date", "store_code", "branch_code", "product_code", "doc_type"],
    bigquery: {
        partitionBy: "sale_date",
        clusterBy: ["store_code", "branch_code", "product_code"]
    },
}


WITH hp AS (

    SELECT
        sale_date,
        store_code,                                 -- 'HP' หรือ 'MH' · NULL = ไม่ใช่สาขาขายปลีก (CS01/EX99)
        siteno      AS branch_code,
        sitename    AS branch_name,
        artno       AS product_code,
        artdesc     AS product_name,
        vdartno     AS barcode_match,               -- บาร์โค้ด GS1 ใช้จับคู่ dim_product_master.Barcode
        qty         AS sale_qty,
        value       AS sale_amount,
        IF(is_return, 'RETURN', 'SALE') AS doc_type,
        'DERIVED'   AS doc_type_source,
        1           AS days_covered,
        FALSE       AS date_is_estimated,
        
        asatdate
    -- ต้องระบุ dataset เพราะชื่อ saleout_hp มีทั้งใน raw_saleout_mdt (external) และ validated_saleout_mdt
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_hp")}
    WHERE sale_date IS NOT NULL
    
        AND (qty <> 0 OR value <> 0)                 
      -- กรองที่ต้นทาง เพราะ validated partition ด้วย asatdate — วางไว้ข้างนอกจะไม่ตัดพาร์ทิชัน
      ${ when(incremental(), `AND asatdate >= DATE_SUB(CURRENT_DATE('Asia/Bangkok'), INTERVAL ${databuffet.BACKFILL_DAYS} DAY)`) }

), bt_feed_gap AS (

    -- ช่วงห่างระหว่าง snapshot ที่ห้างส่งมาจริง — ยอดที่กระโดดระหว่าง 2 snapshot เกิดในช่วงนี้
    -- ต้องวัดจากวันที่ไฟล์มี ไม่ใช่จากช่วงในกลุ่มสินค้า เพราะสินค้าจะโผล่ในไฟล์ครั้งแรก
    -- ก็ตอนที่มันขายแล้ว วันก่อนนั้นไม่มีแถวเลย (MTD = 0 ไม่ถูกส่งมา)
    -- วัด 2026-09-11: ห่าง 1 วัน 149 ครั้ง · 2 วัน 11 ครั้ง · 3 วัน 1 ครั้ง
    --                 ห่าง 10 วัน 1 ครั้ง (ไฟล์แรกของ ก.พ.) · 18 วัน 1 ครั้ง (ไฟล์แรกของ มี.ค.)
    SELECT
        end_date,
        DATE_DIFF(
            end_date,
            IFNULL(
                LAG(end_date) OVER (PARTITION BY DATE_TRUNC(end_date, MONTH) ORDER BY end_date),
                DATE_SUB(month_start, INTERVAL 1 DAY)
            ),
            DAY
        ) AS days_covered
    FROM (
        -- MIN กัน fan-out: ถ้า end_date เดียวมี start_date หลายค่า การ JOIN จะคูณแถว
        SELECT end_date, MIN(start_date) AS month_start
        FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "sale_by_branch_detail")}
        WHERE end_date IS NOT NULL
        GROUP BY end_date
    )

), bt_daily AS (

    -- บุญถาวรส่งยอด "สะสมตั้งแต่ต้นเดือน" (MTD) มาใหม่ทุกวัน ไม่ใช่ยอดของวัน
    -- 1 การขายถูกส่งซ้ำทุกวันจนสิ้นเดือน — วัด 2026-09-11: 12,756 แถว มีการขายจริงแค่ 1,370
    -- ยอดของวัน = MTD ของวันนี้ − MTD ของแถวก่อนหน้า รีเซ็ตทุกต้นเดือน
    --
    -- ⚠️ ห้ามใส่ filter asatdate ในบล็อกนี้ — LAG ต้องเห็นแถวของวันก่อนหน้า
    --    ถ้าอ่านแค่ 1 วัน แถวแรกจะไม่มี LAG แล้วยอดสะสมทั้งเดือนจะถูกนับเป็นยอดของวันเดียว
    --    ต้นทาง 12,756 แถว / 0.3 MB — อ่านทั้งก้อนทุกคืนถูกกว่าเขียนโค้ดกันพลาด
    -- ponytail: ถ้าวันหน้าตารางนี้โตเกินหลักล้านแถว เปลี่ยนเป็นอ่านย้อน 2 เดือนปฏิทิน
    --    ต้องเป็นเดือนเต็ม ไม่ใช่ N วัน เพราะการรีเซ็ตผูกกับต้นเดือน
    SELECT
        s.end_date,
        s.branch,
        s.article_id,
        s.article_name_th,
        s.asatdate,
        g.days_covered,
        s.net_inc_tax_mtd - IFNULL(LAG(s.net_inc_tax_mtd) OVER w, 0) AS sale_amount,
        s.sale_qty_mtd    - IFNULL(LAG(s.sale_qty_mtd)    OVER w, 0) AS sale_qty
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "sale_by_branch_detail")} AS s
    JOIN bt_feed_gap AS g USING (end_date)
    WHERE s.end_date IS NOT NULL
    WINDOW w AS (
        PARTITION BY s.branch, s.article_id, s.distribution_channel, DATE_TRUNC(s.end_date, MONTH)
        ORDER BY s.end_date
    )

), bt AS (

    -- ยุบช่องทาง (Showroom / Anyhome / Web) รวมกัน เพราะเกรนของ curated ไม่มีช่องทาง
    -- แต่แยกตามชนิดเอกสาร — ช่องทางหนึ่งขายอีกช่องทางคืน จะได้ไม่หักกลบจนมองไม่เห็น
    -- ⚠️ ต้นทางไม่มีคอลัมน์ชนิดเอกสาร เราเดาจากยอดสะสม MTD ที่ลดลง
    SELECT
        end_date                   AS sale_date,
        'BT'                       AS store_code,
        branch                     AS branch_code,   -- BT ใช้ชื่อไทยเป็นรหัสสาขา จับคู่ dim ได้ 16/16
        branch                     AS branch_name,
        article_id                 AS product_code,
        ANY_VALUE(article_name_th) AS product_name,
        CAST(NULL AS STRING)       AS barcode_match, -- BT ไม่ส่งบาร์โค้ดมา
        SUM(sale_qty)              AS sale_qty,
        SUM(sale_amount)           AS sale_amount,
        IF(sale_amount < 0, 'RETURN', 'SALE') AS doc_type,
        'DERIVED'                  AS doc_type_source,
        MAX(days_covered)          AS days_covered,
        MAX(days_covered) > 1      AS date_is_estimated, -- ครอบหลายวัน = ไม่รู้วันขายจริง
        
        MAX(asatdate)              AS asatdate
    FROM bt_daily
    WHERE sale_amount <> 0 OR sale_qty <> 0
    GROUP BY sale_date, store_code, branch_code, branch_name, product_code, doc_type

), gb_lines AS (

    -- ห้างส่งไฟล์ซ้ำ และ No_ ไม่คงที่ข้ามไฟล์ คีย์ของ validated จึงตัดซ้ำไม่ออก
    -- เก็บแต่ละบิลจากไฟล์ล่าสุดเท่านั้น · วัด 2026-09-23: 206 บิล / 2.15M ถูกนับซ้ำ
    -- ponytail: ที่ถูกจริงคือ purge ระดับบิลใน validated แบบ mih/mil/mir ทำเมื่อมีห้างอื่นอ่าน saleout_gb ด้วย
    SELECT * FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_gb")}
    WHERE sale_date IS NOT NULL
      -- GB ใช้บาร์โค้ดตัวเลขเป็นรหัสสินค้า รหัสที่ไม่ใช่ตัวเลขมีตัวเดียวคือ GP530217-000003 'รายได้ค่าขนส่ง'
      -- ไม่ใช่การขายสินค้า ไฟล์ BI ก็ไม่นับ · วัด 2026-09-23: 4,206 แถว / 2.39M (18-20 มี.ค. 2026)
      -- รหัสที่เป็น NULL ปล่อยผ่าน ให้ไปโผล่เป็น SK -1 ใน fact ดีกว่าหายไปเงียบ ๆ
      AND (product_code IS NULL OR REGEXP_CONTAINS(product_code, r'^[0-9]+$'))
    QUALIFY DENSE_RANK() OVER (PARTITION BY sale_no, sale_date, branch_code ORDER BY asatdate DESC) = 1

), gb AS (

    -- โกลบอลเฮ้าส์ — ห้างเดียวที่ส่งชนิดเอกสารกับเลขบิลอ้างอิงมาเอง
    -- ต้นทาง 24,011 แถว / 102,548,396.70 / 2026-02-09 ถึง 2026-07-05 (วัด 2026-09-13)
    --
    -- เกรนของ curated ไม่มีเลขบิล ต้องยุบหลายบรรทัดเข้าแถวเดียว
    -- วัด: 24,011 แถว -> 16,233 กลุ่ม (ยุบ 7,778 แถว) · เลขบิลทั้งหมด 19,777 ใบ
    --      กลุ่มที่มีบิลใบเดียว 13,970 (86.1%) เก็บเลขบิลได้ · อีก 2,263 กลุ่มมีหลายใบ
    --      มากสุด 39 ใบในกลุ่มเดียว
    -- เก็บเลขบิลเฉพาะตอนที่ไม่กำกวม — ถ้ามีหลายใบใส่ NULL ดีกว่าหยิบมาใบเดียวมั่ว ๆ
    --
    -- reference_no = บิลที่ถูกคืน · 357 แถวคืนมีครบ 100% · 325 ค่าที่ไม่ซ้ำ
    -- ตามกลับไปเจอบิลขายจริง 247 (76%) · ที่เหลือเป็นบิลก่อน 2026-02-09 ซึ่งอยู่นอกฟีด
    -- กลุ่มการคืน 326 กลุ่ม มี reference_no ค่าเดียว 305 (93.6%) · หลายค่า 21 กลุ่ม (มากสุด 4)
    --
    -- ⚠️ ฟีดค้าง — วันขายล่าสุด 5 ก.ค. 2026 แต่ไฟล์เข้าถึงปัจจุบัน ต้องถามห้าง
    SELECT
        sale_date,
        'GB'                      AS store_code,
        branch_code,
        ANY_VALUE(branch_name)    AS branch_name,
        product_code,
        ANY_VALUE(product_name)   AS product_name,
        product_code              AS barcode_match,  -- GB ใช้บาร์โค้ด 13 หลักเป็นรหัสสินค้าอยู่แล้ว
        SUM(sale_quantity)        AS sale_qty,
        SUM(sale_amount)          AS sale_amount,
        type                      AS doc_type,       -- ห้างส่งมาเอง SALE / RETURN
        'SOURCE'                  AS doc_type_source,
        1                         AS days_covered,   -- วันขายแม่นยำ ไม่ใช่ค่าประมาณ
        FALSE                     AS date_is_estimated,
        MAX(asatdate)             AS asatdate
    FROM gb_lines 
    
    GROUP BY sale_date, store_code, branch_code, product_code, doc_type

), tw_dedup AS (

    SELECT Store, SKU, Barcode, Description, Last_Sold_Date, Sales_Amount, Sales_Qty, asatdate
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "report_sale_subscription")}
    WHERE Last_Sold_Date IS NOT NULL
      AND Store IS NOT NULL
      AND (Sales_Amount <> 0 OR Sales_Qty <> 0)
      -- ก่อนวันนี้ใช้ไฟล์ Excel แทน ดูบล็อก lastyear
      AND Last_Sold_Date >= DATE '2026-05-13'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY Store, SKU, Last_Sold_Date ORDER BY asatdate DESC
    ) = 1

), tw_full_days AS (

    -- วันที่ฟีด TW มาครบ = มีสาขาส่งยอดมาอย่างน้อย 30 สาขา
    -- ⚠️ ถ้าไฟล์ของวันนั้นไม่มา (ปกติมาถึงวันที่ D+2) วันนั้นจะเหลือแค่แถวเศษที่หลงมาจากไฟล์อื่น
    --    (ส่วนใหญ่เป็นการคืนสินค้า) ถ้ายังนับเป็นวันที่มีฟีด feed_days จะไม่ให้ไฟล์ BI มาเติม
    --    แล้วยอดของทั้งวันหายไปเงียบ ๆ
    --    วัด 2026-09-24 (13 พ.ค.-23 ส.ค.): เจอ 16 วัน ฟีดได้ไม่ถึง 2% ของ BI ในวันนั้น
    --    วันปกติมี 63-83 สาขา · วันที่ไฟล์ไม่มามี 1-23 สาขา ไม่มีวันไหนอยู่ระหว่างนั้น
    -- แถวเศษของวันที่ไม่ครบถูกทิ้งด้วย เพื่อให้วันหนึ่งมีข้อมูลจากแหล่งเดียว (ฟีด หรือ ไฟล์ BI)
    -- ponytail: เกณฑ์ตายตัว 30 สาขา ถ้า TW เพิ่มหรือลดสาขามากให้ปรับ หรือเปลี่ยนเป็น % ของค่ากลางย้อนหลัง
    SELECT Last_Sold_Date
    FROM tw_dedup
    GROUP BY Last_Sold_Date
    HAVING COUNT(DISTINCT Store) >= 30

), tw AS (

    SELECT
        Last_Sold_Date         AS sale_date,
        'TW'                   AS store_code,
        Store                  AS branch_code,   -- TW ใช้สตริงเต็ม `60001-CRC Thai Watsadu ...`
        Store                  AS branch_name,
        LTRIM(SKU, '0')        AS product_code,
        ANY_VALUE(Description) AS product_name,
        ANY_VALUE(Barcode)     AS barcode_match, -- TW ส่งบาร์โค้ดมาแยกคอลัมน์
        SUM(Sales_Qty)         AS sale_qty,
        SUM(Sales_Amount)      AS sale_amount,
        IF(Sales_Amount < 0, 'RETURN', 'SALE') AS doc_type,
        'DERIVED'              AS doc_type_source,
        1                      AS days_covered,
        FALSE                  AS date_is_estimated, -- วันขายมาจากต้นทาง ไม่ได้เดา
        MAX(asatdate)          AS asatdate
    FROM tw_dedup
    JOIN tw_full_days USING (Last_Sold_Date) 
    GROUP BY sale_date, store_code, branch_code, branch_name, product_code, doc_type
), hp_all_days AS (

    -- (ห้าง, วัน) ทั้งหมดที่ HP/MH เคยส่งมา — อ่าน validated ตรง ๆ ไม่ผ่าน CTE hp
    -- ⚠️ ทำไมต้องมี CTE นี้: CTE `hp` ด้านบนติดกรอง asatdate ตอนรันแบบ incremental
    --    จึงเหลือแค่วันล่าสุดวันเดียว ถ้าเอา `hp` ไปทำ feed_days แถวย้อนหลังของ HP/MH
    --    จะไม่ถูกกัน แล้วไฟล์ lastyear จะเข้ามาซ้อนกับยอดจากฟีดรายวัน
    --    วัด 2026-09-23: ซ้อนแล้ว 320 (ห้าง,วัน) · 13,301 แถว · 157.48 ล้านบาท
    --    gb/bt/tw ไม่มีปัญหานี้เพราะ CTE ของมันอ่านเต็มทุกรอบอยู่แล้ว
    -- เงื่อนไข WHERE ต้องเหมือน CTE `hp` เป๊ะ (ตัดเฉพาะบรรทัด incremental) ไม่งั้นกันคนละชุดวัน
    SELECT DISTINCT store_code, sale_date
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_hp")}
    WHERE sale_date IS NOT NULL
      AND (qty <> 0 OR value <> 0)
), feed_days AS (

    -- (ห้าง, วัน) ที่ฟีดรายวันส่งมาจริง — ใช้เป็นตัวกันไม่ให้ไฟล์ย้อนหลังนับซ้ำ
    -- ต้องอยู่หลัง CTE ของทั้ง 4 ห้าง และก่อน lastyear
    -- DH ไม่อยู่ในนี้เพราะยังไม่มีฟีด -> ไฟล์ย้อนหลังของ DH จึงเข้าทั้งหมดเอง
    -- วันที่ DH มีฟีดแล้ว แค่เพิ่ม dh เข้า UNION ตรงนี้ **ไม่ต้องตั้งวันตัด**
    -- นับเฉพาะวันหลังวันตัด เพื่อให้ไฟล์ลูกค้าผ่าน anti-join ได้ทั้งหมดในช่วงก่อนหน้า
    SELECT DISTINCT store_code, sale_date FROM hp_all_days
        -- แถว BT ครอบหลายวันได้ (days_covered) ต้องกันทุกวันในช่วง ไม่ใช่แค่วันสุดท้าย
    -- วัด 2026-09-23: 14 แถว ครอบ 39 วัน โดนไฟล์ BI ซ้อน 2.87M
    UNION DISTINCT SELECT DISTINCT store_code, d AS sale_date
    FROM bt, UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(sale_date, INTERVAL days_covered - 1 DAY), sale_date)) AS d
    UNION DISTINCT SELECT DISTINCT store_code, sale_date FROM gb
    UNION DISTINCT SELECT DISTINCT store_code, sale_date FROM tw

), bi_end AS (

    -- ============================================================================
    -- เติมยอดจากไฟล์ BI แบบ "เฉพาะส่วนที่ขาด" ราย (ห้าง, สาขา, สินค้า, เดือน)   (แก้ 2026-09-24)
    -- ============================================================================
    -- ⚠️ ทำไมไม่เติมทีละวันแบบเดิม: ไฟล์ BI ลงวันที่ไม่ตรงกับวันขายจริง รายการเดียวกัน
    --    ฟีดลงวันหนึ่ง BI ลงอีกวัน ผลในระดับสินค้าจึงผิดสองทาง
    --      เบิ้ล — ฟีดมีรายการนี้ + BI ลงไว้ในวันที่ฟีดไม่มี  -> นับสองครั้ง
    --      หาย  — ฟีดไม่มีรายการนี้ + BI ลงไว้ในวันที่ฟีดมี    -> ไม่นับเลย
    --    วัด 2026-09-24: เบิ้ลราว 29.5M (GB 14.6 · HP 6.9 · TW 5.1 · MH 2.2 · BT 0.7)
    --    ยอดรวมยังใกล้ BI เพราะเบิ้ลกับหายหักกันเอง แต่รายสินค้า/รายสาขาผิด
    --    ตัวอย่างที่ BI เจอ: HP 1000630 ก.พ. สาขา S046/S053 นับสองครั้ง · S017 หาย
    -- กติกาใหม่ ต่อ (ห้าง, เดือน) นับถึงวันสุดท้ายของไฟล์ BI:
    --    ฟีดครบทุกวัน   -> ใช้ฟีดอย่างเดียว
    --    ไม่มีฟีดเลย    -> ใช้แถวรายวันของ BI (เดิม)
    --    มีฟีดบางวัน    -> ใช้ฟีด + เติมจาก BI เท่าที่ฟีดยังขาด ราย (สาขา, สินค้า) ทั้งเดือน
    --                     เติม = max(0, BI ทั้งเดือน − ฟีดทั้งเดือน) · ลงไว้วันสุดท้ายของเดือนที่ฟีดไม่มีข้อมูล
    -- วันสุดท้ายที่ไฟล์ BI มีข้อมูล (ตอนนี้ 2026-08-23) — ถ้า BI ส่งไฟล์ใหม่ ช่วงเติมจะขยายเอง
    SELECT MAX(sale_date) AS d
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_lastyear")}

), month_cov AS (

    -- (ห้าง, เดือน) ที่มีฟีด: มีฟีดกี่วัน เทียบกับจำนวนวันในเดือน (ตัดที่ bi_end)
    SELECT f.store_code,
           DATE_TRUNC(f.sale_date, MONTH) AS m,
           COUNT(DISTINCT f.sale_date)    AS fed_days,
           ANY_VALUE(DATE_DIFF(LEAST(LAST_DAY(f.sale_date), e.d), DATE_TRUNC(f.sale_date, MONTH), DAY) + 1) AS window_days
    FROM feed_days AS f
    CROSS JOIN bi_end AS e
    WHERE f.sale_date <= e.d
    GROUP BY 1, 2

), partial_months AS (

    -- เดือนที่ฟีดมีบางวันแต่ไม่ครบ = เดือนที่ต้องเติมแบบเฉพาะส่วนที่ขาด
    -- ⚠️ ไม่รวมเดือนที่ไฟล์ BI จบกลางเดือน (ตอนนี้ ส.ค. 2026) — ของที่ BI ลงวันที่ก่อนวันจบ แต่ฟีดลงหลังวันจบ
    --    จะถูกนับว่า "ขาด" แล้วเติมซ้ำ (วัด 2026-09-24: HP ส.ค. +10% · MH +8%) เดือนนั้นใช้แบบรายวันเดิมไปก่อน
    -- ⚠️ GB ใช้แบบรายวันเดิม (ตัดสินใจ 2026-09-24) — ฟีด GB สูงกว่า BI ราว 8% ในวันที่มีข้อมูล
    --    วิธีเติมเฉพาะส่วนที่ขาดจึงเห็นว่า "ไม่ขาด" แล้วไม่เติมวันที่หาย ยอด ก.พ.-ก.ค. ต่ำกว่า BI 6.6%
    --    (แบบรายวัน GB +4.3% แต่ยังมีเบิ้ล/หายราย สินค้า ~14.6M — รู้แล้ว ยอมรับไว้ก่อน)
    SELECT c.store_code, c.m
    FROM month_cov AS c
    CROSS JOIN bi_end AS e
    WHERE c.fed_days < c.window_days
      AND LAST_DAY(c.m) <= e.d
      AND c.store_code <> 'GB'

), topup_day AS (

    -- วันที่ใช้ลงยอดเติม = วันสุดท้ายของเดือนที่ฟีดไม่มีข้อมูล
    -- เลือกวันที่ฟีดไม่มี เพื่อไม่ให้ชนคีย์ (sale_date, store, branch, product, doc_type) กับแถวของฟีด
    SELECT p.store_code, p.m, MAX(d) AS d, COUNT(*) AS gap_days
    FROM partial_months AS p
    CROSS JOIN bi_end AS e
    CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(p.m, LEAST(LAST_DAY(p.m), e.d))) AS d
    LEFT JOIN feed_days AS f
      ON  f.store_code = p.store_code
      AND f.sale_date  = d
    WHERE f.sale_date IS NULL
    GROUP BY 1, 2

), feed_rows AS (

    -- แถวฟีดทุกห้าง ย้อนหลังทั้งหมด (ใช้หายอดฟีดทั้งเดือน)
    -- HP/MH อ่าน validated ตรง ๆ เพราะ CTE hp ติดกรอง incremental (เหตุผลเดียวกับ hp_all_days)
    SELECT sale_date, store_code, siteno AS branch_code, artno AS product_code, qty AS sale_qty, value AS sale_amount
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_hp")}
    WHERE sale_date IS NOT NULL
      AND (qty <> 0 OR value <> 0)
    UNION ALL SELECT sale_date, store_code, branch_code, product_code, sale_qty, sale_amount FROM bt
    UNION ALL SELECT sale_date, store_code, branch_code, product_code, sale_qty, sale_amount FROM gb
    UNION ALL SELECT sale_date, store_code, branch_code, product_code, sale_qty, sale_amount FROM tw

), feed_items AS (

    -- ยอดฟีดทั้งเดือน ราย (ห้าง, สาขา, สินค้า) เฉพาะเดือนที่ไม่ครบ · ตัด 0 นำหน้ารหัสให้จับคู่กับไฟล์ BI ได้
    SELECT r.store_code, r.branch_code, LTRIM(r.product_code, '0') AS pc, p.m,
           SUM(r.sale_qty) AS q, SUM(r.sale_amount) AS a
    FROM feed_rows AS r
    JOIN partial_months AS p
      ON  p.store_code = r.store_code
      AND p.m = DATE_TRUNC(r.sale_date, MONTH)
    CROSS JOIN bi_end AS e
    WHERE r.sale_date <= e.d
    GROUP BY 1, 2, 3, 4

), bi_items AS (

    -- ยอด BI ทั้งเดือน ราย (ห้าง, สาขา, สินค้า) เฉพาะเดือนที่ไม่ครบ
    SELECT ly.store_code, ly.branch_code, LTRIM(ly.product_code, '0') AS pc, p.m,
           ANY_VALUE(ly.product_code) AS product_code,
           ANY_VALUE(ly.branch_name)  AS branch_name,
           ANY_VALUE(ly.product_name) AS product_name,
           SUM(ly.sale_qty) AS q, SUM(ly.sale_amount) AS a,
           MAX(ly.asatdate) AS asatdate
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_lastyear")} AS ly
    JOIN partial_months AS p
      ON  p.store_code = ly.store_code
      AND p.m = DATE_TRUNC(ly.sale_date, MONTH)
    GROUP BY 1, 2, 3, 4

), topup_item AS (

    -- ส่วนที่ฟีดยังขาด ราย (สาขา, สินค้า) — ถ้าฟีดมีเท่ากับหรือมากกว่า BI = ไม่เติม
    SELECT b.*,
           GREATEST(b.a - IFNULL(f.a, 0), 0) AS fill_a,
           GREATEST(b.q - IFNULL(f.q, 0), 0) AS fill_q
    FROM bi_items AS b
    LEFT JOIN feed_items AS f
      ON  f.store_code  = b.store_code
      AND f.branch_code = b.branch_code
      AND f.pc          = b.pc
      AND f.m           = b.m

), feed_store AS (

    SELECT store_code, m, SUM(a) AS a FROM feed_items GROUP BY 1, 2

), topup_scale AS (

    -- เพดานต่อ (ห้าง, เดือน): เติมรวมทั้งห้างต้องไม่เกิน ยอด BI ของห้าง − ยอดฟีดของห้าง
    -- กันยอดรวมเกิน BI จากสองเรื่อง: รหัสสินค้าสองฝั่งไม่ตรงกัน และสินค้าที่ BI บังเอิญสูงกว่าฟีด
    --    (สินค้าที่ฟีดสูงกว่า BI ไม่ได้ถูกหักออก ถ้าไม่มีเพดาน ผลรวมของส่วนที่ "ขาด" จะสูงเกินจริง)
    -- ใช้ระดับห้าง ไม่ใช่ระดับสาขา — ระดับสาขาตึงเกิน สาขาที่ฟีดสูงกว่า BI จะไม่ได้เติมเลยทั้งที่มีวันหาย
    --    (เจอ HP 1000630 สาขา S054 ก.ค. ยังหาย) · วัด 2026-09-24: รหัสสินค้าตรงกัน 99%+ ทุกห้าง
    SELECT t.store_code, t.m,
           IFNULL(LEAST(1, SAFE_DIVIDE(GREATEST(SUM(t.a) - IFNULL(ANY_VALUE(fs.a), 0), 0), SUM(t.fill_a))), 0) AS scale
    FROM topup_item AS t
    LEFT JOIN feed_store AS fs
      ON  fs.store_code = t.store_code
      AND fs.m          = t.m
    GROUP BY 1, 2

), lastyear_topup AS (

    -- แถวเติม — วันที่เป็นวันประมาณ (date_is_estimated = TRUE) ครอบทุกวันที่ฟีดไม่มีในเดือนนั้น
    -- ponytail: ถ้าวันหลังห้างส่งไฟล์ย้อนหลังมาเติมวันที่หาย วันที่ของแถวเติมจะเลื่อน
    --    แถวเติมเก่าจะค้างในตาราง (MERGE ไม่ลบ) ต้อง full refresh หลังโหลดไฟล์ย้อนหลังทุกครั้ง
    SELECT
        d.d                                  AS sale_date,
        t.store_code,
        t.branch_code,
        t.branch_name,
        t.product_code,
        t.product_name,
        CAST(NULL AS STRING)                 AS barcode_match,
        ROUND(t.fill_q * s.scale)            AS sale_qty,
        ROUND(t.fill_a * s.scale, 2)         AS sale_amount,
        'SALE'                               AS doc_type,
        'DERIVED'                            AS doc_type_source,
        d.gap_days                           AS days_covered,
        TRUE                                 AS date_is_estimated,
        t.asatdate
    FROM topup_item AS t
    JOIN topup_scale AS s
      ON  s.store_code = t.store_code
      AND s.m          = t.m
    JOIN topup_day AS d
      ON  d.store_code = t.store_code
      AND d.m          = t.m
    WHERE t.fill_a * s.scale > 0.005

), lastyear AS (

    SELECT
        ly.sale_date,
        ly.store_code,
        IF(ly.store_code = 'DH' AND REGEXP_CONTAINS(branch_code, r'^M[0-9]+$'),
           CONCAT(branch_code, '_TG'),
        branch_code)            AS branch_code,
        ANY_VALUE(branch_name)  AS branch_name,
        product_code,
        ANY_VALUE(product_name) AS product_name,
        CAST(NULL AS STRING)    AS barcode_match,  -- ไฟล์ไม่มีบาร์โค้ด
        SUM(sale_qty)           AS sale_qty,
        SUM(sale_amount)        AS sale_amount,
        IF(sale_amount < 0, 'RETURN', 'SALE') AS doc_type,
        'DERIVED'               AS doc_type_source,
        1                       AS days_covered,
        FALSE                   AS date_is_estimated,
        MAX(asatdate)           AS asatdate

        
    FROM ${ref(databuffet.VALIDATED_SALEOUT_MDT, "saleout_lastyear")} AS ly
    -- เอาเฉพาะ (ห้าง, วัน) ที่ฟีดรายวัน **ไม่มี** ข้อมูล — anti-join
    -- ⚠️ ห้ามใช้ NOT EXISTS ที่อ้าง CTE ข้ามกัน — Dataform ห่อ incremental เป็น script
    --    แล้ว BigQuery มองไม่เห็น CTE ในนั้น ฟ้อง "feed_days must be qualified with a dataset"
    --    (พังจริง 2026-09-18 ตาราง curated หายทั้งตัว ต้องรันใหม่)
    LEFT JOIN feed_days AS f
      ON  f.store_code = ly.store_code
      AND f.sale_date  = ly.sale_date
      -- เดือนที่ฟีดมีบางวัน ไม่ใช้แถวรายวันของ BI แล้ว — ใช้ lastyear_topup แทน (ดูคำอธิบายที่ bi_end)
    LEFT JOIN partial_months AS pm
      ON  pm.store_code = ly.store_code
      AND pm.m          = DATE_TRUNC(ly.sale_date, MONTH)
    WHERE ly.sale_date IS NOT NULL
      AND f.sale_date IS NULL
      AND pm.m IS NULL
    GROUP BY sale_date, store_code, branch_code, product_code, doc_type
)
SELECT * FROM hp
UNION ALL
SELECT * FROM bt
UNION ALL
SELECT * FROM gb
UNION ALL
SELECT * FROM tw
UNION ALL
SELECT * FROM lastyear
UNION ALL
SELECT * FROM lastyear_topup
pre_operations {
}

post_operations {
}