config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL],
    uniqueKey: ["month_date", "branch_code", "product_code"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["branch_code", "product_code"]
    },
}

/*
  ยอดปิดรายเดือนที่บุญถาวรส่งมาเอง (โฟลเดอร์ SO_MDT_EOM/BT ชีต sale_by_branch_detail)

  ใช้ชีต detail ไม่ใช่ sales_by_branch เพราะอีกชีตเป็นยอดรวมระดับสาขา ไม่มีรายสินค้า
  เทียบกับ curated ที่เกรนเป็นรายสินค้าไม่ได้

  ต่างจากห้างอื่น 2 อย่าง
  - ไม่มีแถวสรุปต่อท้ายไฟล์ (GB กับ TW มี) จึงไม่ต้องกรอง
  - งวดอยู่ในทุกแถวที่ START_DATE/END_DATE ตรงไปตรงมา ไม่ต้องอ่านหัวไฟล์แบบ HP/TW

  type: "table" เพราะ ASATDATE เป็นวันที่ DAG รัน ไม่ใช่งวด · ดู known-issues 2026-10-05
*/

js {
    const sourceTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "eom_bt_sale_by_branch_detail",
    };
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;
}

WITH src AS (

    SELECT
        -- START_DATE เป็นวันแรกของงวดอยู่แล้ว (2026/08/01) DATE_TRUNC ไว้กันห้างส่งงวดคร่อมเดือน
        DATE_TRUNC(${databuffet.functionData.parseDateSlash('TRIM(START_DATE)')}, MONTH) AS month_date,

        -- BT ใช้ชื่อสาขาภาษาไทยเป็นรหัสสาขา เหมือนฟีดรายวัน (จับคู่ dim ได้ 16/16)
        ${databuffet.functionData.cleanString('BRANCH')}          AS branch_code,
        ${databuffet.functionData.cleanCode('ARTICLE_ID')}        AS product_code,
        ${databuffet.functionData.cleanString('ARTICLE_NAME_TH')} AS product_name,

        -- NET_INC_TAX คือยอดขายรวมภาษี ตรงกับที่ curated ใช้
        SALE_QTY     AS sale_qty,
        NET_INC_TAX  AS sale_amount,

        ${databuffet.functionData.parseAsatDate()} AS asatdate,
        ASATDATE AS asat_raw

    FROM `${sourceTableRef}`

    WHERE START_DATE IS NOT NULL
      AND BRANCH IS NOT NULL AND TRIM(BRANCH) <> ''
      AND ARTICLE_ID IS NOT NULL AND TRIM(ARTICLE_ID) <> ''

), latest AS (

    -- งวดเดียวกันถูกส่งซ้ำได้แล้วไปอยู่คนละพาร์ทิชัน ASATDATE
    -- BT ไม่มีคอลัมน์เวลาสร้างไฟล์แบบ CRDATE ของ HP จึงใช้ ASATDATE เป็นตัวตัด
    -- ตัดข้ามพาร์ทิชันโดยตั้งใจ (PARTITION BY month_date อย่างเดียว) ไม่งั้นงวดเดิมจะได้ 2 ชุด
    SELECT * FROM src
    QUALIFY asat_raw = MAX(asat_raw) OVER (PARTITION BY month_date)

)

-- ยุบช่องทางขาย (Showroom / Anyhome / Website) รวมกัน ให้เกรนตรงกับ eom ห้างอื่น
-- และตรงกับ curated ซึ่งยุบช่องทางเหมือนกัน — ไม่งั้นเอาไปเทียบกันไม่ได้
-- ⚠️ เครื่องหมายติดลบต้องคงไว้ งวด 09 มีรายการคืน 2 แถว
SELECT
    month_date,
    'BT'                    AS store_code,
    branch_code,
    product_code,
    ANY_VALUE(product_name) AS product_name,
    SUM(sale_qty)           AS sale_qty,
    SUM(sale_amount)        AS sale_amount,
    MAX(asatdate)           AS asatdate
FROM latest
GROUP BY month_date, branch_code, product_code
