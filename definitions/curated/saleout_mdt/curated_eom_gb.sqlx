config {
    type: "table",
    schema: databuffet.CURATED_SALEOUT_MDT,
    dependencies: ["curated_schema_saleout", "create_all_table_raw_saleout_mdt"],
    tags: [databuffet.TAG_CURATED, databuffet.TAG_CURATED_FULL, databuffet.TAG_SALEOUT_DAILY],
    uniqueKey: ["month_date", "branch_code", "product_code", "doc_type"],
    bigquery: {
        partitionBy: "month_date",
        clusterBy: ["branch_code", "product_code"]
    },
}
-- แยกยอดปิดรายเดือนจากฟีดรายวันเพื่อเทียบยอดที่ห้างแจ้ง

js {
    const EomGbTable = {
        database: databuffet.DATABASE,
        schema:   databuffet.RAW_SALEOUT_MDT,
        name:     "eom_gb",
    };
    const EomGbTableRef = `${EomGbTable.database}.${EomGbTable.schema}.${EomGbTable.name}`;

    // ปั๊มน้ำ Hitachi — พี่กุ้งสั่งตัดออกจากยอด GB (2026-10-05)
    // ชุดเดียวกับที่ตัดใน curated_saleout_mdt ฝั่งรายวัน ต้องแก้ทั้งสองที่เสมอ
    // ไม่ตัด 8859738138040 'DOS ถังเก็บน้ำคู่ปั๊ม +ปั๊มhitachi' เพราะเป็นสินค้าของเรา
    const HITACHI_PUMPS = `'8850207702816', '8850207702830', '8850207700430'`;
}

WITH src AS (

    SELECT
        -- งวดอยู่ในคอลัมน์ Sale_Date ของทุกแถว ไม่ต้องพึ่งหัวไฟล์หรือ ASATDATE
        -- ⚠️ ห้ามใช้ ASATDATE เป็นงวด — มันคือวันที่ DAG รัน ไฟล์ ส.ค. กับ ก.ย. อยู่พาร์ทิชันเดียวกัน
        DATE_TRUNC(PARSE_DATE('%m/%d/%Y', TRIM(Sale_Date)), MONTH) AS month_date,

        ${databuffet.functionData.cleanCode('Branch_Code')}    AS branch_code,
        ${databuffet.functionData.cleanString('Branch_Name')}  AS branch_name,
        ${databuffet.functionData.cleanCode('Product_Code')}   AS product_code,
        ${databuffet.functionData.cleanString('Product_Name')} AS product_name,
        ${databuffet.functionData.cleanCode('Type')}           AS doc_type,

        -- Sale_Quantity เป็น INT64 อยู่แล้วจาก AVRO จึงใช้ได้ตรง ๆ
        Sale_Quantity AS sale_qty,

        SAFE_CAST(REPLACE(REPLACE(TRIM(Sale_Amount), "'", ''), ',', '') AS FLOAT64) AS sale_amount,

        ${databuffet.functionData.parseAsatDate()} AS asatdate,

        -- ไว้ตัดงวดที่ถูกส่งซ้ำ ต้องใช้ค่าดิบเพราะ parseAsatDate แปลงเป็น DATE แล้ว
        ASATDATE AS asat_raw

    FROM `${EomGbTableRef}`

    WHERE Sale_No_ IS NOT NULL
      AND Sale_Date IS NOT NULL
      AND Branch_Code IS NOT NULL

      -- ฟีดรายวันมีกฎนี้อยู่แล้ว ใส่ให้ตรงกัน: รหัสที่ไม่ใช่ตัวเลขคือ 'รายได้ค่าขนส่ง' ไม่ใช่การขายสินค้า
      AND (Product_Code IS NULL OR REGEXP_CONTAINS(TRIM(Product_Code), r'^[0-9]+$'))

      AND TRIM(Product_Code) NOT IN (${HITACHI_PUMPS})

), file_version AS (

    -- แต่ละ (งวด, เวอร์ชันไฟล์) ซ้ำทั้งยวงหรือเปล่า · min_dup >= 2 = ทุกแถวซ้ำ คือไฟล์ค้างในโฟลเดอร์
    -- ต้องดูเป็นรายงวด ไม่ใช่รวมทั้งตาราง — งวดหนึ่งเบิ้ลแต่อีกงวดปกติ เป็นเรื่องที่เกิดจริง
    SELECT month_date, asat_raw, MIN(c) AS min_dup
    FROM (SELECT month_date, asat_raw, COUNT(*) AS c FROM src AS t GROUP BY 1, 2, TO_JSON_STRING(t))
    GROUP BY 1, 2

), chosen AS (

    -- เวอร์ชันใหม่สุดที่ไม่ซ้ำทั้งยวง — ข้ามไฟล์ค้างไปใช้ของก่อนหน้าแทน ยอดจะได้ไม่เบิ้ล
    SELECT month_date, MAX(asat_raw) AS asat_raw
    FROM file_version
    WHERE min_dup < 2
    GROUP BY 1

), latest AS (

    SELECT s.* FROM src AS s
    INNER JOIN chosen USING (month_date, asat_raw)

), dup_guard AS (

    -- เหลืองวดที่ไม่มีเวอร์ชันดีเลย = ทุกไฟล์ของงวดนั้นค้างซ้ำหมด เลือกให้ไม่ได้ ต้องหยุด
    SELECT IF(COUNT(*) = 0, 0, ERROR(FORMAT(
        'curated_eom_gb: งวด %t ซ้ำทุกเวอร์ชัน ไม่มีไฟล์ดีให้ใช้ — เช็คไฟล์ค้างใน SaleOut_MDT/SO_MDT_EOM/GB', ANY_VALUE(month_date)
    ))) AS ok
    FROM (SELECT month_date FROM src GROUP BY 1
          EXCEPT DISTINCT
          SELECT month_date FROM chosen)

)

-- รวมเป็นเกรนรายเดือน · ห้างส่งมาเป็นรายบรรทัดบิล ต้องยุบ
SELECT
    month_date,
    'GB'                      AS store_code,
    branch_code,
    ANY_VALUE(branch_name)    AS branch_name,
    product_code,
    ANY_VALUE(product_name)   AS product_name,
    doc_type,
    SUM(sale_qty)             AS sale_qty,
    SUM(sale_amount)          AS sale_amount,
    MAX(asatdate)             AS asatdate
FROM latest
CROSS JOIN dup_guard
WHERE dup_guard.ok = 0
GROUP BY month_date, branch_code, product_code, doc_type
