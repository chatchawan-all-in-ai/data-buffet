config {
    type: "operations",
    dependencies: ["curated_schema_master_sku"],
    tags: [databuffet.TAG_CURATED],
}

js {
    // Define table references
    const targetTable = {
        database: databuffet.DATABASE,
        schema: databuffet.CURATED_MASTER_SKU,
        name: "product_for_aisearch_v3",
    };

    // Build target table reference
    const targetTableRef = `${targetTable.database}.${targetTable.schema}.${targetTable.name}`;

    // AI search expects the old lower-case unit codes (mm/cm/m/inch/ft, kg/g, l/ml),
    // and no unit when the measurement itself is empty
    const unitCode = (valueColumn, codeExpression) =>
        `IF(${valueColumn} IS NULL, NULL, IF(${codeExpression} = 'IN', 'inch', LOWER(${codeExpression})))`;

    // first non-empty variant value with this label, in array order
    const specValue = (label) => `(SELECT ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")}
          FROM UNNEST(JSON_QUERY_ARRAY(product.specification_attributes)) AS attr WITH OFFSET AS pos
          WHERE JSON_VALUE(attr, '$.label') = '${label}'
            AND ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")} IS NOT NULL
          ORDER BY pos LIMIT 1)`;

    // master_sku appends the old free-text sales unit to the name: "... (แผ่น)"
    const nameSuffix = `NULLIF(TRIM(REGEXP_EXTRACT(product.name, r'\\(([^()]*)\\)$')), '')`;

}

DECLARE run_date DATE DEFAULT CURRENT_DATE('Asia/Bangkok');

BEGIN
  ------ CREATE TEMP TABLE
  CREATE OR REPLACE TEMP TABLE unit_vocab AS
  SELECT DISTINCT v
  FROM (
    SELECT ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")} AS v
    FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "products")}, UNNEST(JSON_QUERY_ARRAY(specification_attributes)) AS attr
    WHERE JSON_VALUE(attr, '$.label') = 'หน่วยขาย'
    UNION ALL
    SELECT name AS v FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")}
    WHERE type IN ('sales-unit', 'uom-general', 'uom-volume', 'uom-weight', 'uom-length')
  )
  WHERE v IS NOT NULL;

  CREATE OR REPLACE TEMP TABLE temp_product_for_aisearch_v3 AS
  SELECT
    run_date as asatdate,
    product.master_sku_code as id,
    STRUCT(
        product.name as product_name,
        product.master_sku_code as sku_code,
        IF(sales_unit.name = 'ชิ้น',
           COALESCE(IF(${nameSuffix} IN (SELECT v FROM unit_vocab), ${nameSuffix}, NULL),
                    ${specValue("หน่วยขาย")}, sales_unit.name),
           sales_unit.name) as sales_unit,
        product.tags as product_tags_json,
        product.universal_barcode as barcode,
        cate.name as cat_name,
        COALESCE(brand.name, vendor_brand.name) as brand_name,
        vendor.name as vd_name,
        (CASE
          WHEN product.product_status = 'Active' AND product.sales_status = 'Active' then 'Approve'
          ELSE 'Non-Approve'
        END) as product_status,
        TO_JSON_STRING(STRUCT(ARRAY(
          SELECT AS STRUCT JSON_VALUE(attr, '$.label') AS label, JSON_VALUE(attr, '$.value') AS value
          FROM UNNEST(JSON_QUERY_ARRAY(product.specification_attributes)) AS attr WITH OFFSET AS pos
          ORDER BY pos
        ) AS dimFeild)) as product_dimensions_json,
        IF(REGEXP_CONTAINS(TRIM(product.detail), r'^[A-Za-z0-9#_./\-]{4,40}$'), NULL, product.detail) as product_description,
        product.series as product_series,
        COALESCE(product.model, ${specValue("โมเดล")}, ${specValue("รุ่นสินค้า")}) as product_model,
        COALESCE(product.material, NULLIF(NULLIF(NULLIF(${specValue("วัสดุ")}, 'โปรดระบุ'), '-'), '0')) as product_material,
        product.package_shape as product_shape

        -- product.gross_width as package_width,
        -- ${unitCode("product.gross_width", "package_unit.code")} as package_width_unit,
        -- product.gross_length as package_length,
        -- ${unitCode("product.gross_length", "package_unit.code")} as package_length_unit,
        -- product.gross_height as package_height,
        -- ${unitCode("product.gross_height", "package_unit.code")} as package_height_unit,
        -- product.net_weight as product_weight_net,
        -- ${unitCode("product.net_weight", "COALESCE(weight_unit.code, volume_unit.code)")} as product_weight_net_unit,
        -- product.gross_weight as product_weight_gross,
        -- ${unitCode("product.gross_weight", "COALESCE(weight_unit.code, volume_unit.code)")} as product_weight_gross_unit,
        -- '{"SpeciFeild":[]}' as special_specifications_json
    ) as structData
  FROM (
    SELECT *
    FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "products")}
    WHERE master_sku_code IS NOT NULL
    QUALIFY ROW_NUMBER() OVER(PARTITION BY master_sku_code ORDER BY updated_at DESC) = 1
  ) as product

  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brands")} as brand
    ON product.brand_id = brand.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "categories")} as cate
    ON product.category_id = cate.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brand_vendors")} as brand_vendor
    ON product.brand_vendor_id = brand_vendor.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brands")} as vendor_brand
    ON brand_vendor.brand_id = vendor_brand.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "vendors")} as vendor
    ON brand_vendor.vendor_id = vendor.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as sales_unit
    ON product.uom_sales_id = sales_unit.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as package_unit
    ON product.length_package_unit_id = package_unit.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as weight_unit
    ON product.weight_unit_id = weight_unit.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as volume_unit
    ON product.volume_unit_id = volume_unit.id
  WHERE product.asatdate BETWEEN run_date - 1 AND run_date;

  ---- CREATE TARGET ON FIRST RUN
  CREATE TABLE IF NOT EXISTS `${targetTableRef}`
  PARTITION BY asatdate
  CLUSTER BY id
  AS SELECT * FROM temp_product_for_aisearch_v3 WHERE FALSE;

    BEGIN TRANSACTION;

    ---- DELETE DATA BEFOR INSERT
    DELETE FROM `${targetTableRef}`
    WHERE asatdate = run_date;

    ---- INSERT DATA
    INSERT INTO `${targetTableRef}`
    SELECT * FROM temp_product_for_aisearch_v3;

    COMMIT TRANSACTION;

  ---- DROP TEMP TABLE
  DROP TABLE IF EXISTS temp_product_for_aisearch_v3;
  DROP TABLE IF EXISTS unit_vocab;

END;
