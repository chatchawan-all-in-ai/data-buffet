config {
    type: "operations",
    dependencies: ["curated_schema_master_sku"],
    tags: [databuffet.TAG_CURATED],
}

js {
    // Define table references
    const sourceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.CURATED_MASTER_SKU,
        name: "product_for_aisearch_v3",
    };

    // Build source table reference
    const sourceTableRef = `${sourceTable.database}.${sourceTable.schema}.${sourceTable.name}`;

}

DECLARE run_date DATE DEFAULT CURRENT_DATE('Asia/Bangkok');
DECLARE is_first_load BOOL DEFAULT TRUE;

-- first run (target missing or empty) loads the whole catalog; later runs only D-1..D changes
BEGIN
  SET is_first_load = (SELECT COUNT(*) = 0 FROM `${sourceTableRef}`);
EXCEPTION WHEN ERROR THEN
  SET is_first_load = TRUE;
END;

BEGIN
  ------ CREATE TEMP TABLE
  CREATE OR REPLACE TEMP TABLE temp_product_for_aisearch_v3 AS
  SELECT
    run_date as asatdate,
    product.master_sku_code as id,
    STRUCT(
        product.name as product_name,
        product.master_sku_code as sku_code,
        sales_unit.name as sales_unit,
        -- wrapped in the old {"mypro_tag": [...]} shape so AI search parsing keeps working
        IF(product.tags IS NULL, NULL,
           TO_JSON_STRING(STRUCT(PARSE_JSON(product.tags) AS mypro_tag))) as product_tags_json,
        product.universal_barcode as barcode,
        cate.name as cat_name,
        brand.name as brand_name,
        vendor.name as vd_name,
        (CASE
          WHEN product.product_status = 'Active' then 'Approve'
          ELSE 'Non-Approve'
        END) as product_status,
        -- no counterpart in master_sku (old prdDiminsionData)
        CAST(NULL AS STRING) as product_dimensions_json,
        -- detail = old pd_detail; products.description is never filled
        product.detail as product_description,
        product.series as product_series,
        product.model as product_model,
        product.material as product_material,
        product.shape as product_shape,
        product.gross_width as package_width,
        package_unit.name as package_width_unit,
        product.gross_length as package_length,
        package_unit.name as package_length_unit,
        product.gross_height as package_height,
        package_unit.name as package_height_unit,
        product.net_weight as product_weight_net,
        weight_unit.name as product_weight_net_unit,
        product.gross_weight as product_weight_gross,
        weight_unit.name as product_weight_gross_unit,
        -- wrapped in the old {"SpeciFeild": [...]} shape; items are {id,label,value} objects
        IF(product.specification_attributes IS NULL, NULL,
           TO_JSON_STRING(STRUCT(PARSE_JSON(product.specification_attributes) AS SpeciFeild))) as special_specifications_json
    ) as structData
  FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "products")} as product

  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brands")} as brand
    ON product.brand_id = brand.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "categories")} as cate
    ON product.category_id = cate.id
  -- products has no vendor_id; the vendor comes through brand_vendors
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brand_vendors")} as brand_vendor
    ON product.brand_vendor_id = brand_vendor.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "vendors")} as vendor
    ON brand_vendor.vendor_id = vendor.id

  -- units live in common_codes (type sales-unit / uom-length / uom-weight)
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as sales_unit
    ON product.uom_sales_id = sales_unit.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as package_unit
    ON product.length_package_unit_id = package_unit.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} as weight_unit
    ON product.weight_unit_id = weight_unit.id

  -- ~26k placeholder rows have no master_sku_code (created_at 2000-01-01)
  WHERE product.master_sku_code IS NOT NULL
    AND (is_first_load OR product.asatdate between run_date-1 and run_date)
  -- id must be unique for AI search; master_sku_code is not a PK in products
  QUALIFY ROW_NUMBER() OVER(PARTITION BY product.master_sku_code ORDER BY product.updated_at DESC) = 1;

  ---- CREATE TARGET ON FIRST RUN
  CREATE TABLE IF NOT EXISTS `${sourceTableRef}`
  PARTITION BY asatdate
  CLUSTER BY id
  AS SELECT * FROM temp_product_for_aisearch_v3 WHERE FALSE;

  ---- DELETE DATA BEFOR INSERT
  DELETE FROM `${sourceTableRef}`
  WHERE asatdate = run_date;

  ---- INSERT DATA
  INSERT INTO `${sourceTableRef}`
  SELECT * FROM temp_product_for_aisearch_v3;

  ---- DROP TEMP TABLE
  DROP TABLE IF EXISTS temp_product_for_aisearch_v3;

END;
