config {
    type: "table",
    schema: databuffet.CURATED_MASTER_SKU,
    dependencies: ["curated_schema_master_sku"],
    tags: [databuffet.TAG_CURATED],
    bigquery: {
        partitionBy: "asatdate",
        clusterBy: ["prdSku", "prdUniversalBarcode", "prdVendorId", "prdBrandId"]
    }
}

-- Same 50 columns, in the same order, as curated_mastersku.curated_product, built from master_sku.
-- Daily rebuild: 1 row per master_sku_code, and brand/vendor lookups always current.
WITH p AS (
  SELECT *
  FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "products")}
  -- ~26k placeholder rows have no master_sku_code (created_at 2000-01-01)
  WHERE master_sku_code IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY master_sku_code ORDER BY updated_at DESC) = 1
),
-- first non-empty value per variant label, in array order
spec AS (
  SELECT p.id,
    ARRAY_AGG(IF(LOWER(lbl) IN ('ขนาด', 'size'), val, NULL) IGNORE NULLS ORDER BY pos LIMIT 1)[SAFE_OFFSET(0)] AS spec_size,
    ARRAY_AGG(IF(LOWER(lbl) IN ('สี', 'color'), val, NULL) IGNORE NULLS ORDER BY pos LIMIT 1)[SAFE_OFFSET(0)] AS spec_color,
    ARRAY_AGG(IF(lbl = 'โมเดล', val, NULL) IGNORE NULLS ORDER BY pos LIMIT 1)[SAFE_OFFSET(0)] AS spec_model,
    ARRAY_AGG(IF(lbl = 'รุ่นสินค้า', val, NULL) IGNORE NULLS ORDER BY pos LIMIT 1)[SAFE_OFFSET(0)] AS spec_variant_model,
    ARRAY_AGG(IF(lbl = 'หน่วยขาย', val, NULL) IGNORE NULLS ORDER BY pos LIMIT 1)[SAFE_OFFSET(0)] AS spec_sales_unit
  FROM p, UNNEST(JSON_QUERY_ARRAY(p.specification_attributes)) AS attr WITH OFFSET AS pos,
    UNNEST([STRUCT(
      JSON_VALUE(attr, '$.label') AS lbl,
      ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")} AS val
    )])
  GROUP BY p.id
),
-- words that really are a sales unit: every variant 'หน่วยขาย' value + unit names in common_codes
unit_vocab AS (
  SELECT DISTINCT ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")} AS v
  FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "products")}, UNNEST(JSON_QUERY_ARRAY(specification_attributes)) AS attr
  WHERE JSON_VALUE(attr, '$.label') = 'หน่วยขาย'
    AND ${databuffet.functionData.cleanString("JSON_VALUE(attr, '$.value')")} IS NOT NULL
  UNION DISTINCT
  SELECT name FROM ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")}
  WHERE type IN ('sales-unit', 'uom-general', 'uom-volume', 'uom-weight', 'uom-length')
    AND name IS NOT NULL
),
base AS (
  SELECT p.*, s.* EXCEPT(id),
    -- master_sku appends the old free-text unit to the name: "... (แผ่น)"; use it only over the generic default 'ชิ้น'
    IF(su.name = 'ชิ้น',
       COALESCE(IF(${databuffet.functionData.cleanString("REGEXP_EXTRACT(p.name, r'\\(([^()]*)\\)$')")} IN (SELECT v FROM unit_vocab),
                   ${databuffet.functionData.cleanString("REGEXP_EXTRACT(p.name, r'\\(([^()]*)\\)$')")}, NULL),
                s.spec_sales_unit, su.name),
       su.name) AS sales_unit_fixed
  FROM p
  LEFT JOIN spec AS s ON s.id = p.id
  LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} AS su ON p.uom_sales_id = su.id
)

SELECT
  b.id AS prdId,
  b.master_sku_code AS prdSku,
  b.name AS prdDescription,
  b.d365_code AS prdD365Sku,
  CAST(NULL AS STRING) AS prdItemText,
  b.mac5_code AS prdItemCode,
  CAST(NULL AS STRING) AS prdStoppedSate,
  CAST(NULL AS STRING) AS prdMadeToOrder,
  b.sales_unit_fixed AS prdSaleUnite,
  -- old feed never sent NULL: no tags = {"mypro_tag":[]}
  TO_JSON_STRING(STRUCT(IFNULL(JSON_VALUE_ARRAY(b.tags), []) AS mypro_tag)) AS prdTag,
  b.universal_barcode AS prdUniversalBarcode,
  b.internal_barcode AS prdInternalBarcode,
  b.category_id AS prdCatId,
  CAST(NULL AS STRING) AS prdFilter1,
  CAST(NULL AS STRING) AS prdFilter2,
  -- new brand ids (not the old mastersku ids); 52 products only have the brand on brand_vendors
  COALESCE(b.brand_id, bv.brand_id) AS prdBrandId,
  -- d365_size is zero-padded: 01000L -> 1000L
  COALESCE(b.spec_size, REGEXP_REPLACE(${databuffet.functionData.cleanString("b.d365_size")}, r'^0+([0-9])', r'\1')) AS prdSize,
  CAST(NULL AS STRING) AS prdLine,
  CASE WHEN REGEXP_CONTAINS(SPLIT(b.spec_color, ' ')[SAFE_OFFSET(0)], r'[ก-๙]')
       THEN ${databuffet.functionData.cleanString("REGEXP_EXTRACT(b.spec_color, r'^([ก-๙\\s]+)')")} END AS prdColorTH,
  CASE WHEN NOT REGEXP_CONTAINS(SPLIT(b.spec_color, ' ')[SAFE_OFFSET(0)], r'[ก-๙]') THEN ${databuffet.functionData.cleanString("b.spec_color")}
       ELSE ${databuffet.functionData.cleanString("REGEXP_REPLACE(b.spec_color, r'^([ก-๙\\s]+)', '')")} END AS prdColorEN,
  COALESCE(b.model, b.spec_model, b.spec_variant_model) AS prdModel,
  CAST(NULL AS STRING) AS prdDimension1,
  CAST(NULL AS STRING) AS prdDimension2,
  CAST(NULL AS STRING) AS prdDimension3,
  CAST(NULL AS STRING) AS prdDimension4,
  -- products has no vendor_id; the vendor comes through brand_vendors
  bv.vendor_id AS prdVendorId,
  b.product_status = 'Active' AS prdIsActive,
  b.sales_status = 'Active' AS prdIsUse,
  b.created_at AS prdCreatedDate,
  b.created_by AS prdCreatedBy,
  -- 10,657 rows carry the 2000-01-01 placeholder; product_status_date holds the real last change
  IF(b.updated_at < '2000-01-02', COALESCE(b.product_status_date, b.sales_status_date, b.updated_at), b.updated_at) AS prdUpdatedDate,
  b.updated_by AS prdUpdatedBy,
  -- specification_group_id matches the old pg id; product_group_id does not
  b.specification_group_id AS prdPgId,
  -- old product_status lookup ids: On / Off
  IF(b.product_status = 'Active', '5430ac8c-9904-4e5b-8aab-6c87850f0022', '7f5ac89b-3367-4ea9-8e13-f191732bb40f') AS prdPsId,
  CAST(NULL AS STRING) AS prdIdSource,
  CAST(NULL AS STRING) AS prdMcId,
  -- specification_attributes holds the variant values, kept in the {"dimFeild":[{label,value}]} shape
  TO_JSON_STRING(STRUCT(ARRAY(
    SELECT AS STRUCT JSON_VALUE(attr, '$.label') AS label, JSON_VALUE(attr, '$.value') AS value
    FROM UNNEST(JSON_QUERY_ARRAY(b.specification_attributes)) AS attr WITH OFFSET AS pos
    ORDER BY pos
  ) AS dimFeild)) AS prdDiminsionData,
  CAST(NULL AS STRING) AS prdPasId,
  b.universal_barcode AS prdBarcode,
  b.product_status_remark AS prdRejectRemark,
  CAST(NULL AS STRING) AS prdRefMpId,
  CAST(NULL AS BOOL) AS prdIsCombo,
  CAST(NULL AS FLOAT64) AS prdComboPrice,
  CAST(NULL AS BOOL) AS prdIsTime,
  CAST(NULL AS DATETIME) AS prdComboStart,
  CAST(NULL AS DATETIME) AS prdComboEnd,
  CAST(NULL AS FLOAT64) AS prdTotalComboPrice,
  CAST(NULL AS FLOAT64) AS prdTotalCostComboPrice,
  IF(bf.name = 'EAN13', 'GTIN-13 / EAN-13', bf.name) AS prdBarcodeFormat,
  b.asatdate AS asatdate
FROM base AS b
LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "brand_vendors")} AS bv
  ON b.brand_vendor_id = bv.id
LEFT JOIN ${ref(databuffet.VALIDATED_MASTER_SKU, "common_codes")} AS bf
  ON b.universal_barcode_format_id = bf.id
