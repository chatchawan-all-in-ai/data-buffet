config {
    type: "table",
    schema: databuffet.CURATED_DERP,
    dependencies: ["curated_schema_derp"],
    tags: [databuffet.TAG_CURATED],
    bigquery: {
        clusterBy: ["matchStatus", "mihVnos"],
    },
}

-- rebuild ทั้งตาราง (ไม่ใช่ incremental): journal กลับรายการเข้ามาหลังวันขายได้ ยอด invoice เก่าจึงเปลี่ยนย้อนหลัง
WITH header_base AS (
    SELECT
        journal_number,
        description,
        is_posted,
        posted_datetime,
        -- ใบรับคืนที่ขึ้นต้นด้วยวันที่ เลขเอกสารอยู่กลางข้อความ ไม่ได้อยู่ต้นข้อความ
        REGEXP_CONTAINS(description, r'^\s*\d{1,2}/\d{1,2}/\d{2,4}') AND STRPOS(description, 'คืน') > 0 AS is_dated_return
    FROM ${ref(databuffet.VALIDATED_DERP, "inventory_movement_journal_headers")}
    WHERE journal_name_id = 'IM-MAC-01'
),

header AS (
    SELECT
        journal_number,
        description,
        is_posted,
        posted_datetime,
        IF(
            is_dated_return,
            -- ใช้เลขใบรับคืน RT... ก่อน เพราะข้อความมักมีเลขใบเบิก CH-... ปนอยู่ด้วย
            COALESCE(
                REGEXP_EXTRACT(description, r'(RT[A-Za-z]*-[A-Za-z]+\d{6,})'),
                REGEXP_EXTRACT(description, r'((?:[A-Za-z]+(?:-[A-Za-z]+)?)?\d{6,})')
            ),
            -- ตัวอักษรนำหน้าเป็นส่วนของเลขเอกสาร (K6910000328 ≠ 6910000328) ห้ามตัดเหลือแต่ตัวเลข
            -- ยอมเฉพาะคำนำหน้าที่รู้จัก ไม่หาเลขทั้งข้อความ เพราะจะไปติดเบอร์โทรหรือเลข PO แทน
            REGEXP_EXTRACT(description, r'^\s*(?:รับคืน|อ้างอิงใบจ่าย|ใบจ่ายขายจาก(?:\s*MAC-5)?)?\s*((?:[A-Za-z]+(?:-[A-Za-z]+)?)?\d{6,})')
        ) AS doc_no,
        IF(is_dated_return, 'รับคืน', REGEXP_EXTRACT(description, r'^\s*(รับคืน|อ้างอิงใบจ่าย|ใบจ่ายขายจาก)')) AS doc_prefix
    FROM header_base
),

entry AS (
    SELECT
        journal_number,
        -SUM(cost_amount) AS journal_cost,
        COUNT(*) AS journal_lines
    FROM ${ref(databuffet.VALIDATED_DERP, "inventory_movement_journal_entries")}
    GROUP BY journal_number
),

invoice AS (
    SELECT
        mihVnos,
        ANY_VALUE(company_id) AS company_id,
        ANY_VALUE(mihType) AS mihType,
        COUNT(*) AS doc_count
    FROM ${ref(databuffet.CURATED_MAC5, "curated_mih")}
    GROUP BY mihVnos
)

SELECT
    header.journal_number AS journalNumber,
    header.description AS journalDescription,
    header.doc_no AS docNo,
    CASE
        WHEN header.doc_no IS NULL THEN 'NO_DOC_NO'
        WHEN invoice.mihVnos IS NULL THEN 'NOT_IN_MAC5'
        WHEN invoice.doc_count > 1 THEN 'AMBIGUOUS'
        -- รับคืนอ้างใบขายเดิม แยกไว้ไม่ให้ไปหักต้นทุนใบนั้น (ยอดขายใบเดิมยังเต็ม)
        WHEN header.doc_prefix = 'รับคืน' THEN 'RETURN'
        ELSE 'MATCHED'
    END AS matchStatus,
    IF(invoice.doc_count = 1, invoice.company_id, NULL) AS company_id,
    IF(invoice.doc_count = 1, invoice.mihType, NULL) AS mihType,
    IF(invoice.doc_count = 1, invoice.mihVnos, NULL) AS mihVnos,
    header.is_posted AS isPosted,
    header.posted_datetime AS postedDatetime,
    entry.journal_cost AS journalCost,
    IFNULL(entry.journal_lines, 0) AS journalLines
FROM header
LEFT JOIN entry
    ON entry.journal_number = header.journal_number
LEFT JOIN invoice
    ON invoice.mihVnos = header.doc_no
