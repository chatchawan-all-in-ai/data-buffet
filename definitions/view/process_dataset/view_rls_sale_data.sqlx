config {
  type: "view",
  schema: databuffet.PROCESS_DATASET,
  dependencies: ["view_rls_data", "rls_customer360"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const MdsDataOrgEmployeeMappingCenterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_org_employee_mapping_center",
    };
    const MdsDataOrgEmployeeMappingCenterTableRef = `${MdsDataOrgEmployeeMappingCenterTable.database}.${MdsDataOrgEmployeeMappingCenterTable.schema}.${MdsDataOrgEmployeeMappingCenterTable.name}`;

    const ViewRlsDataTable = {
        database: databuffet.DATABASE,
        schema: databuffet.PROCESS_DATASET,
        name: "view_rls_data",
    };
    const ViewRlsDataTableRef = `${ViewRlsDataTable.database}.${ViewRlsDataTable.schema}.${ViewRlsDataTable.name}`;

    const RlsCustomer360Table = {
        database: databuffet.DATABASE,
        schema: databuffet.PROCESS_DATASET,
        name: "rls_customer360",
    };
    const RlsCustomer360TableRef = `${RlsCustomer360Table.database}.${RlsCustomer360Table.schema}.${RlsCustomer360Table.name}`;
}

WITH emp_map AS (
  SELECT 
    TRIM(employeeid) AS employeeid, 
    TRIM(employeetype) AS employeetype,
    TRIM(employeename) AS employeename, 
    TRIM(employeeemail) AS employeeemail
  FROM `${MdsDataOrgEmployeeMappingCenterTableRef}` 
  WHERE is_active = TRUE
    AND LOWER(TRIM(employeetype)) = 'sales'
    AND employeeid IS NOT NULL
    AND employeeemail IS NOT NULL

), rls_data AS (
  SELECT DISTINCT 
    emp.employeeemail AS EmployeeEmail, 
    rls.LevelName,
    rls.LevelValue
  FROM `${ViewRlsDataTableRef}` AS rls
  INNER JOIN emp_map AS emp
    ON rls.EmployeeID = emp.employeeid

), rls_customer_raw AS (
  SELECT 
    milCus,
    SectionID
  FROM `${RlsCustomer360TableRef}`
  WHERE SectionID IS NOT NULL

), agg_rls_customer AS (
  SELECT 
    t2.EmployeeEmail, 
    t1.milCus
  FROM rls_customer_raw AS t1,
    UNNEST(SPLIT(t1.SectionID, '|')) AS split_section_id
  INNER JOIN rls_data AS t2
    ON split_section_id = t2.LevelValue 
    AND t2.LevelName = 'SectionID'
  WHERE t1.milCus IS NOT NULL

), rls_customer AS (
  SELECT DISTINCT
    EmployeeEmail,
    'CustomerID' AS LevelName,
    milCus AS LevelValue
  FROM agg_rls_customer

)
  SELECT * FROM rls_data
  UNION ALL
  SELECT * FROM rls_customer
  order by 1
