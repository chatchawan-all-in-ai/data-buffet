config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["fact_saleout_monthly_mdt", "dim_pc", "dim_product_mkt"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;

    const FactSaleoutMonthlyMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FACT_TABLE,
        name: "fact_saleout_monthly_mdt",
    };
    const FactSaleoutMonthlyMdtTableRef = `${FactSaleoutMonthlyMdtTable.database}.${FactSaleoutMonthlyMdtTable.schema}.${FactSaleoutMonthlyMdtTable.name}`;

    const DimPcTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_pc",
    };
    const DimPcTableRef = `${DimPcTable.database}.${DimPcTable.schema}.${DimPcTable.name}`;
}

WITH mkt_group AS (

  -- ProductMktSK -> MarketingGroupID เพราะ dim_pc มอบหมายที่ระดับกลุ่ม ไม่ใช่ SK
  SELECT ProductMktSK, ANY_VALUE(MarketingGroupID) AS MarketingGroupID
  FROM `${DimProductMktTableRef}`
  WHERE CompanyID = 'ag01'
  GROUP BY 1

), sale AS (

  SELECT f.*, m.MarketingGroupID
  FROM `${FactSaleoutMonthlyMdtTableRef}` AS f
  LEFT JOIN mkt_group AS m ON f.product_mkt_sk = m.ProductMktSK

), pc_per_month AS (

  -- 1 แถว = 1 PC ที่รับผิดชอบช่องนั้นในเดือนนั้น (ช่อง = สาขา + กลุ่มการตลาด)
  SELECT DISTINCT
    DATE_TRUNC(d, MONTH) AS month_date,
    BranchMdtSK, MarketingGroupID, PcSK
  FROM `${DimPcTableRef}`
  CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(StartDate, IFNULL(EndDate, DATE '2099-12-31'), INTERVAL 1 MONTH)) AS d
  WHERE PcSK <> -1 AND IsPlaceholder = FALSE

), pc_share AS (

  -- ช่องหนึ่งมี PC กี่คน = ตัวหารแบ่งยอด (ยอดรวมยังเท่าเดิมเมื่อบวกกลับ)
  SELECT *,
    COUNT(*) OVER(PARTITION BY month_date, BranchMdtSK, MarketingGroupID) AS pc_in_slot
  FROM pc_per_month

), exploded AS (

  SELECT
    s.month_date,
    s.store_code,
    s.branch_code,
    s.branch_sk,
    s.zone_sk,
    s.sales_channel,

    s.product_code,
    s.product_name,
    s.product_mdt_sk,
    s.product_sk,
    s.product_mkt_sk,
    s.MarketingGroupID,
    s.report_sk,
    s.region_sk,
    s.region_manager_sk,
    s.director_sk,

    p.PcSK AS pc_sk_list,

    -- หารเท่า ๆ กันตามจำนวน PC ของช่องนั้น · ไม่มี PC ก็คงยอดเต็มไว้ ไม่ให้ยอดขายหาย
    s.sale_qty    / IFNULL(p.pc_in_slot, 1) AS sale_qty,
    s.sale_amount / IFNULL(p.pc_in_slot, 1) AS sale_amount,
    s.asatdate,

    -- ธงนับหัว 1 บรรทัดต่อคนต่อเดือน · ต้อง DATE_TRUNC ไม่งั้นเดือนที่ยังไม่จบนับคนซ้ำทุกวัน
    ROW_NUMBER() OVER(
      PARTITION BY p.PcSK, DATE_TRUNC(s.month_date, MONTH)
      ORDER BY s.branch_code, s.product_code, s.month_date
    ) AS pc_row_in_month
  FROM sale AS s
  LEFT JOIN pc_share AS p
    -- ⚠️ สองฝั่งคนละวันในเดือน ต้องปรับให้ตรงก่อน join ไม่งั้น LEFT JOIN คืน NULL ทั้งตารางเงียบ ๆ
    ON  p.month_date       = DATE_TRUNC(s.month_date, MONTH)
    AND p.BranchMdtSK      = s.branch_sk
    AND p.MarketingGroupID = s.MarketingGroupID

)

SELECT
  * EXCEPT(pc_row_in_month),

  -- Yes = ไม่นับหัว · No = นับ · นับเฉพาะ PC ที่มียอดขาย คนที่ขายไม่ออกทั้งเดือนไม่ถูกนับ
  IF(pc_sk_list IS NULL OR pc_row_in_month > 1, 'Yes', 'No') AS fact_pc_not_count
FROM exploded
