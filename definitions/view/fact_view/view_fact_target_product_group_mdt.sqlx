config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["dim_target_product_group_by_sale_dayofwork"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimTargetTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_target_product_group_by_sale_dayofwork",
};
const DimTargetTableRef = `${DimTargetTable.database}.${DimTargetTable.schema}.${DimTargetTable.name}`;
}

SELECT
  Date,

  ProductMktSK,
  ReportSK,

  RegionSK,
  RegionManagerSK,
  DirectorSK,
  RegionSKLast,
  RegionManagerSKLast,
  DirectorSKLast,

  SUM(Amt_New) AS Amt_New,
  SUM(Qty_New) AS Qty_New
FROM `${DimTargetTableRef}`
WHERE ChannelTargetGroup = 'MDT'
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9
