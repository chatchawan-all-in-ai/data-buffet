config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["dim_target_product_group_by_sale_dayofwork"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimTargetRef =
        `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_target_product_group_by_sale_dayofwork`;
}

SELECT
  Date,

  ProductMktSK,
  ReportSK,

  RegionSK,
  RegionManagerSK,
  DirectorSK,
  RegionSKLast,
  RegionManagerSKLast,
  DirectorSKLast,

  SUM(Amt_New) AS Amt_New,
  SUM(Qty_New) AS Qty_New
FROM `${DimTargetRef}`
WHERE ChannelTargetGroup = 'MDT'
GROUP BY 1, 2, 3, 4, 5, 6, 7, 8, 9
