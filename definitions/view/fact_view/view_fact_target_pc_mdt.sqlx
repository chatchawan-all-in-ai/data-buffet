config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["fact_target_saleout_mdt", "dim_pc"],
  tags: [databuffet.TAG_VIEW],
}

js {
const DimPcTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_pc",
    };
    const DimPcTableRef = `${DimPcTable.database}.${DimPcTable.schema}.${DimPcTable.name}`;

const FactTargetSaleoutMdtTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FACT_TABLE,
        name: "fact_target_saleout_mdt",
    };
    const FactTargetSaleoutMdtTableRef = `${FactTargetSaleoutMdtTable.database}.${FactTargetSaleoutMdtTable.schema}.${FactTargetSaleoutMdtTable.name}`;

}

-- เป้ารายคน PC (หารเท่ากันตามจำนวน PC ในช่อง เป็นข้อตกลง ไม่ใช่ข้อเท็จจริง)
-- ที่มาและเงื่อนไข: document/project_wiki/view/view-layer.md

WITH pc_per_month AS (

  SELECT DISTINCT
    DATE_TRUNC(d, MONTH) AS month_date,
    BranchMdtSK, MarketingGroupID, PcSK
  FROM `${DimPcTableRef}`
  CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(StartDate, IFNULL(EndDate, DATE '2099-12-31'), INTERVAL 1 MONTH)) AS d
  WHERE PcSK <> -1 AND IsPlaceholder = FALSE

), pc_share AS (

  SELECT *,
    COUNT(*) OVER(PARTITION BY month_date, BranchMdtSK, MarketingGroupID) AS pc_in_slot
  FROM pc_per_month

)

SELECT
  t.target_date,
  t.store_code,
  t.branch_code,
  t.branch_sk,
  t.zone_sk,
  t.region_sk,
  t.region_manager_sk,
  t.director_sk,

  t.product_mkt_sk,
  t.marketing_group_id,
  t.marketing_group_name,
  t.sub_marketing_id,
  t.sub_marketing_name,
  t.segment_id,
  t.segment_name,

  p.PcSK AS pc_sk_list,

  -- หารเท่า ๆ กันตามจำนวน PC ของช่องนั้น · ไม่มี PC ก็คงเป้าเต็มไว้ ไม่ให้เป้าหาย
  t.target_amt / IFNULL(p.pc_in_slot, 1) AS target_amt,
  t.target_qty / IFNULL(p.pc_in_slot, 1) AS target_qty,

  t.target_year,
  t.target_month,
  t.days_in_month,
  -- เก็บไว้ให้คอลัมน์ครบเท่า fact เดิม จะได้สลับเข้าแทนในโมเดล BI ได้โดยไม่พัง
  t.mds_id
FROM `${FactTargetSaleoutMdtTableRef}` AS t
LEFT JOIN pc_share AS p
  -- เป้าเป็นรายวัน แต่การมอบหมาย PC เป็นรายเดือน ต้องยุบเป็นเดือนก่อน join
  ON  p.month_date       = DATE_TRUNC(t.target_date, MONTH)
  AND p.BranchMdtSK      = t.branch_sk
  AND p.MarketingGroupID = t.marketing_group_id
