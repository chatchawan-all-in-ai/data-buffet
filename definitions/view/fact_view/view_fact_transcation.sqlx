config {
  type: "view",
  schema: databuffet.FACT_VIEW,
  dependencies: ["dim_calendar", "dim_rebate", 
                  "dim_report", "fact_transcation", "dim_guarantee", 
                  "dim_section_last", "dim_section", "dim_sale_representative", 
                  "dim_channel", "dim_sale_representative_last", "dim_department_last", 
                  "dim_director_last", "dim_change_district", "dim_cost_stk", 
                  "dim_cost_group", "dim_stk_mkt", "dim_region_last", "dim_product_master", 
                  "fact_invoice", "view_dim_aging", "fact_order", "view_dim_invoice", 
                  "dim_region", "dim_company", "dim_director", "dim_region_manager", 
                  "dim_section_manager", "dim_pump_information",
                  "dim_customer_report_info"],
  tags: [databuffet.TAG_VIEW],
}

