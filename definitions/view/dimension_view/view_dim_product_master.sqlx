config {
  type: "view",
  schema: databuffet.DIMENSION_VIEW,
  dependencies: ["dim_product_master", "dim_product_mkt", "dim_rebate", "dim_waterpac"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimProductMasterTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_master",
    };
    const DimProductMasterTableRef = `${DimProductMasterTable.database}.${DimProductMasterTable.schema}.${DimProductMasterTable.name}`;

    const DimProductMktTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_product_mkt",
    };
    const DimProductMktTableRef = `${DimProductMktTable.database}.${DimProductMktTable.schema}.${DimProductMktTable.name}`;

    const DimRebateTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_rebate",
    };
    const DimRebateTableRef = `${DimRebateTable.database}.${DimRebateTable.schema}.${DimRebateTable.name}`;

    const DimWaterpacTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_waterpac",
    };
    const DimWaterpacTableRef = `${DimWaterpacTable.database}.${DimWaterpacTable.schema}.${DimWaterpacTable.name}`;
}

with final as (
  SELECT 
    pd.*,
    IFNULL(rebate.salesExc, 'No') as FlagSalesExc,
    IFNULL(rebate.accExc, 'No') as FlagAccExc,


    REGEXP_EXTRACT(ProductCode, r'/([PU][a-zA-Z0-9].*)$') AS WaterPac,
    REGEXP_EXTRACT(ProductCode1, r'/([PU][a-zA-Z0-9].*)$') AS WaterPac1,
    REGEXP_EXTRACT(ProductMac5Description, r'/([PU][a-zA-Z0-9].*)$') AS WaterPac2,

    pm.MarketingGroupID,
    pm.Segment,
    pm.SegmentID

  FROM `${DimProductMasterTableRef}` as pd
  LEFT JOIN `${DimProductMktTableRef}` as pm
    on pd.CompanySK = pm.CompanySK
    and pd.ProductMktSK = pm.ProductMktSK
  LEFT JOIN `${DimRebateTableRef}` as rebate
    on pd.ProductCode = rebate.rebate
    and pd.CompanySK = rebate.CompanySK
    and rebate.status = 'Product'

)
  SELECT
    pd.* except(MarketingGroupID, Segment, SegmentID, WaterPac, WaterPac1, WaterPac2),
    (CASE 
      WHEN pd.SegmentID in ('00111', '00112') THEN COALESCE(wp.WaterPacName, wp1.WaterPacName, wp2.WaterPacName, 'WaterPac')
      WHEN pd.MarketingGroupID = '002' THEN pd.Segment
      ELSE 'OTHERS'
    END) as PumpSegment
  FROM final as pd
  LEFT JOIN `${DimWaterpacTableRef}` as wp
    on pd.CompanySK = wp.CompanySK
    and UPPER(pd.WaterPac) = UPPER(wp.WaterPacCode)
  LEFT JOIN `${DimWaterpacTableRef}` as wp1
    on pd.CompanySK = wp1.CompanySK
    and UPPER(pd.WaterPac1) = UPPER(wp1.WaterPacCode)
  LEFT JOIN `${DimWaterpacTableRef}` as wp2
    on pd.CompanySK = wp2.CompanySK
    and UPPER(pd.WaterPac2) = UPPER(wp2.WaterPacCode)
