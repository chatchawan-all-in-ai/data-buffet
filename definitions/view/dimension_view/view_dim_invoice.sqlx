config {
  type: "view",
  schema: databuffet.DIMENSION_VIEW,
  dependencies: ["dim_invoice", "dim_aging", "view_dim_customer","dim_order","mec"],
  tags: [databuffet.TAG_VIEW],
}

js {
    const DimAgingTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_aging",
    };
    const DimAgingTableRef = `${DimAgingTable.database}.${DimAgingTable.schema}.${DimAgingTable.name}`;

    const DimInvoiceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_invoice",
    };
    const DimInvoiceTableRef = `${DimInvoiceTable.database}.${DimInvoiceTable.schema}.${DimInvoiceTable.name}`;

    const ViewDimCustomerTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_VIEW,
        name: "view_dim_customer",
    };
    const ViewDimCustomerTableRef = `${ViewDimCustomerTable.database}.${ViewDimCustomerTable.schema}.${ViewDimCustomerTable.name}`;

    const CleanCompanyPrefixTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FUNCTION_DATASET,
        name: "clean_company_prefix",
    };
    const CleanCompanyPrefixTableRef = `${CleanCompanyPrefixTable.database}.${CleanCompanyPrefixTable.schema}.${CleanCompanyPrefixTable.name}`;

    const FnFlagScgTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FUNCTION_DATASET,
        name: "fn_flag_scg",
    };
    const FnFlagScgTableRef = `${FnFlagScgTable.database}.${FnFlagScgTable.schema}.${FnFlagScgTable.name}`;

    const FnGetScgCustomerIdsTable = {
        database: databuffet.DATABASE,
        schema: databuffet.FUNCTION_DATASET,
        name: "fn_get_scg_customer_ids",
    };
    const FnGetScgCustomerIdsTableRef = `${FnGetScgCustomerIdsTable.database}.${FnGetScgCustomerIdsTable.schema}.${FnGetScgCustomerIdsTable.name}`;

    const MdsDataCrcShopNameRenameTable = {
        database: databuffet.DATABASE,
        schema: databuffet.MDS_DATASET,
        name: "mds_data_crc_shop_name_rename",
    };
    const MdsDataCrcShopNameRenameTableRef = `${MdsDataCrcShopNameRenameTable.database}.${MdsDataCrcShopNameRenameTable.schema}.${MdsDataCrcShopNameRenameTable.name}`;
    
    const DimOrderTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_order",
    };
    const DimOrderTableRef = `${DimOrderTable.database}.${DimOrderTable.schema}.${DimOrderTable.name}`;
       const MecTable = {
        database: databuffet.DATABASE,
        schema: databuffet.VALIDATED_MAC5,
        name: "mec",
    };
    const MecTableRef = `${MecTable.database}.${MecTable.schema}.${MecTable.name}`;

    // สยามโกลบอลเฮ้าส์ (GB) ใช้รหัสเดียวทุกสาขา — แยกสาขาจากส่วนขยาย / #D/S แบบเดียวกับบิล SCG
    const GbCustomerId = "154500002";
    // HomePro แยกรหัสตามสาขา (~300 รหัส) จึงจับจากชื่อลูกค้า — ต้องมี "เซ็นเตอร์" ไม่งั้นติดร้านชื่อคล้าย (ปทุมวัน/สินสิริ โฮมโปร)
    const HomeProNamePattern = "r'โฮม\\s*โปรดักส์\\s*เซ็น'";

}

with tab_main as (
  select 
    agi.AgingSK,
    inv.*,
    
    (CASE 
      WHEN inv.mihType in ('BS', 'AS') THEN inv_is.milLinkvcno
      ELSE inv.milLinkvcno
    END) as RefOrder,

    (CASE
      WHEN inv.mihCus in UNNEST(`${FnGetScgCustomerIdsTableRef}`()) or inv.mihCus = '${GbCustomerId}'
        or exists(
          select 1 from `${ViewDimCustomerTableRef}` as hp
          where hp.companyID = inv.companyID and hp.debcode = inv.mihCus
            and regexp_contains(hp.debnamet, ${HomeProNamePattern}))
        THEN `${CleanCompanyPrefixTableRef}`(
          (SELECT IF(CHAR_LENGTH(REGEXP_REPLACE(TRIM(v), r'\s', '')) >= 3, TRIM(v), NULL)
           FROM UNNEST([COALESCE(
             REGEXP_EXTRACT(REGEXP_REPLACE(inv.mihNotes, r'\*{2,3}', '##'), r'#D/S\s*\+?\s*(?:แ)?\s*([^\r\n#]+)'),
             REGEXP_EXTRACT(REGEXP_REPLACE(inv.mihNotes, r'\*{2,3}', '##'), r'#D/\s*\+?\s*(?:แ)?\s*([^S\r\n#][^\r\n#]*)'),
             REGEXP_EXTRACT(REGEXP_REPLACE(inv.mihNotes, r'\*{2,3}', '##'), r'#/S\s*\+?\s*(?:แ)?\s*([^\r\n#]+)'),
             REGEXP_EXTRACT(REGEXP_REPLACE(inv.mihNotes, r'\*{2,3}', '##'), r'#D\s+\+?\s*(?:แ)?\s*([^\r\n#]+)'),
             REGEXP_EXTRACT(REGEXP_REPLACE(inv.mihNotes, r'\*{2,3}', '##'), r'D/S\s*\+?\s*(?:แ)?\s*([^\r\n#]+)')
           )]) AS v)
        )
      ELSE NULL
    END) as CRCShopName,

  from `${DimInvoiceTableRef}` as inv
  left join `${DimInvoiceTableRef}` as inv_is
    on inv.milLinkVcno = inv_is.mihVnos
    and inv.companyID = inv_is.companyID
    and inv_is.mihType = 'IS'
  left join `${DimAgingTableRef}` as agi
    on agi.CFSvnosID = inv.mihvnos
    and inv.CompanySK = agi.CompanySK

  -- where mih2.mih2pos is not null
  qualify row_number() over(partition by InvoiceSK order by AgingSK) = 1

),
tab_name as (
  select
    COALESCE(dim_order.OrderSK, main.OrderSK) as OrderSK,
    main.* except(CRCShopName, OrderSK),
    `${FnFlagScgTableRef}`(main.RefOrder, main.mihCus) as FlagSCG,

    COALESCE(mds_crc.crc_shop_name_change, main.CRCShopName) as CRCShopName, 
    -- GB: ตัด " จ.<จังหวัด>" ท้ายชื่อ + ขีด/วรรคหลังชื่อห้าง → "สยามโกลบอลเฮ้าส์ สาขา…" ให้สาขาเดียวกันได้ชื่อเดียว
    (SELECT IF(main.mihCus = '${GbCustomerId}',
              TRIM(REGEXP_REPLACE(REGEXP_REPLACE(v, r'\s*จ\.\s*\S*$', ''), r'^(?:บมจ\.?\s*)?(สยามโกลบอลเฮ้าส์)\s*-?\s*', r'\1 ')),
              v)
     FROM UNNEST([CASE
      WHEN (`${FnFlagScgTableRef}`(main.RefOrder, main.mihCus) is not null or main.mihCus = '${GbCustomerId}'
            or regexp_contains(cust.debnamet, ${HomeProNamePattern}))
            and mecdesc is not null
        THEN `${CleanCompanyPrefixTableRef}`(mecdesc)
      WHEN COALESCE(mds_crc.crc_shop_name_change, main.CRCShopName) is not null
        THEN COALESCE(mds_crc.crc_shop_name_change, main.CRCShopName)
      ELSE `${CleanCompanyPrefixTableRef}`(cust.debnamet)
    END]) AS v) as CustomerReportName,
    mec.mecdesc,
    cust.FlagMDSNickName,
    cust.NicknameCustomer
    
  from tab_main as main
  left join `${ViewDimCustomerTableRef}` as cust
    on main.CompanySK = cust.CompanySK
    and main.mihCus = cust.debcode
  left join (
    select od.OrderSK, od.CompanySK, od.mihVnos 
    from `${DimOrderTableRef}` as od
    qualify row_number() over(partition by od.CompanySK, od.mihVnos order by od.OrderSK desc) = 1
  ) as dim_order
    on main.RefOrder = dim_order.mihVnos
    and main.CompanySK = dim_order.CompanySK
    and main.mihType in ('BS', 'AS')
    and main.OrderSK is null
  left join `${MecTableRef}` as mec
    on main.mihMec = mec.meccode
    and main.companyID = mec.company_id
  left join `${MdsDataCrcShopNameRenameTableRef}` as mds_crc
    on main.CRCShopName = mds_crc.crc_shop_name
    and main.CRCShopName is not null
    and mds_crc.is_active = true
  )
  -- MDS overrides run last and beat every rule-based name: nickname first, then CRC rename
  select
    nm.* except(CustomerReportName, FlagMDSNickName, NicknameCustomer),
    (CASE
      WHEN nm.FlagMDSNickName = True THEN nm.NicknameCustomer
      ELSE COALESCE(mds_crc.crc_shop_name_change, nm.CustomerReportName)
    END) as CustomerReportName
  from tab_name as nm
  left join `${MdsDataCrcShopNameRenameTableRef}` as mds_crc
    on nm.CustomerReportName = mds_crc.crc_shop_name
    and mds_crc.is_active = true
