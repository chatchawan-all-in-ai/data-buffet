config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_product_mkt"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_product_mkt: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_VIEW}.view_dim_product_mkt`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_view.view_dim_product_mkt (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = CompanyID, MarketingGroupID, SubMarketingID, SegmentID, TypeMarketingID.
WITH src AS (
  SELECT
    ProductMktSK,
    MarketingGroupID,
    MarketingGroup,
    SubMarketingID,
    SubMarketing,
    SegmentID,
    Segment,
    TypeMarketing,
    TypeMarketingID,
    CompanyID
  FROM `${SourceTableRef}`
)
SELECT
  s.ProductMktSK,
  s.MarketingGroupID,
  s.MarketingGroup,
  s.SubMarketingID,
  s.SubMarketing,
  s.SegmentID,
  s.Segment,
  s.TypeMarketing,
  s.TypeMarketingID,
  TO_JSON_STRING(STRUCT(s.CompanyID, s.MarketingGroupID, s.SubMarketingID, s.SegmentID, s.TypeMarketingID)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.ProductMktSK, s.MarketingGroupID, s.MarketingGroup, s.SubMarketingID, s.SubMarketing, s.SegmentID, s.Segment, s.TypeMarketing, s.TypeMarketingID))) AS row_hash
FROM src AS s
