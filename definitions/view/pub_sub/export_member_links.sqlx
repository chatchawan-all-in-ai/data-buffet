config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_link"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table member_links: one row = one PC to TA department link at one branch and start date; columns of the 2026-11-02 org sample plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterLinkTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_link",
};
const OrgCenterLinkTableRef = `${OrgCenterLinkTable.database}.${OrgCenterLinkTable.schema}.${OrgCenterLinkTable.name}`;
}

WITH link AS (
  SELECT
    company_id,
    link_type,
    pc_employee_id AS from_membership_id,
    department_id,
    branch_code AS site_id,
    CAST(NULL AS STRING) AS scope_unit_id,
    valid_from,
    IF(valid_to >= DATE '2066-12-31', CAST(NULL AS DATE), valid_to) AS valid_to,
    'mds' AS source,
    CAST(NULL AS STRING) AS source_row_id
  FROM `${OrgCenterLinkTableRef}`
)
SELECT
  l.*,
  TO_JSON_STRING(STRUCT(l.company_id, l.link_type, l.from_membership_id, l.department_id, l.site_id, l.valid_from)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(l)) AS row_hash
FROM link AS l
