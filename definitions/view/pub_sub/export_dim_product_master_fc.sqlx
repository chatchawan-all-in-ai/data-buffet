config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_product_master_fc"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_product_master_fc: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimProductMasterFcTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_product_master_fc",
};
const DimProductMasterFcTableRef = `${DimProductMasterFcTable.database}.${DimProductMasterFcTable.schema}.${DimProductMasterFcTable.name}`;
}

WITH src AS (
  SELECT
    Barcode,
    TM2Brand,
    TM3Series
  FROM `${DimProductMasterFcTableRef}`
)
SELECT
  s.Barcode,
  s.TM2Brand,
  s.TM3Series,
  TO_JSON_STRING(STRUCT(s.Barcode)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.Barcode, s.TM2Brand, s.TM3Series))) AS row_hash
FROM src AS s
