config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_unit"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table org_units: one row = one division / region / section of a company (company rows left out); columns of the 2026-11-02 org sample plus region_code, row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterUnitTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_unit",
};
const OrgCenterUnitTableRef = `${OrgCenterUnitTable.database}.${OrgCenterUnitTable.schema}.${OrgCenterUnitTable.name}`;
}

WITH unit AS (
  SELECT
    u.unit_id AS id,
    u.company_id,
    u.depth AS org_level_id,
    IF(p.unit_level = 'COMPANY', CAST(NULL AS STRING), u.parent_unit_id) AS parent_unit_id,
    u.unit_code AS code,
    u.unit_name AS name,
    u.valid_from,
    IF(u.valid_to >= DATE '2066-12-31', CAST(NULL AS DATE), DATE_ADD(u.valid_to, INTERVAL 1 DAY)) AS valid_to,
    CAST(NULL AS STRING) AS source_row_id,
    u.region_code
  FROM `${OrgCenterUnitTableRef}` AS u
  LEFT JOIN `${OrgCenterUnitTableRef}` AS p
    ON u.company_id = p.company_id
   AND u.parent_unit_id = p.unit_id
  WHERE u.unit_level != 'COMPANY'
)
SELECT
  u.*,
  TO_JSON_STRING(STRUCT(u.company_id, u.id)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(u)) AS row_hash
FROM unit AS u
