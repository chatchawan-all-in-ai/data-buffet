config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_price"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of every data column from dimension_table.dim_price, plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimPriceTable = {
        database: databuffet.DATABASE,
        schema: databuffet.DIMENSION_TABLE,
        name: "dim_price",
    };
    const DimPriceTableRef = `${DimPriceTable.database}.${DimPriceTable.schema}.${DimPriceTable.name}`;
}

WITH src AS (
  SELECT
    PriceSK,
    NdSdPriceID,
    ProductID,
    ProductCode,
    ProductBarcode,
    ProductSK,
    CompanySK,
    ProductMatchCount,
    CompanyResolutionStatus,
    ProductResolutionStatus,
    EffectiveFrom,
    ExpiryTo,
    Status,
    ListPriceInclVat,
    ListPriceExclVat,
    ListPriceVatRate,
    FloorPct,
    FloorPriceInclVat,
    FloorRateType,
    NdMinQty,
    NdMaxQty,
    Remark,
    SourceUpdatedAt,
    SourceDeletedAt,
    SourceAsatdate,
    asatdate
  FROM `${DimPriceTableRef}`
)
SELECT
  s.PriceSK,
  s.NdSdPriceID,
  s.ProductID,
  s.ProductCode,
  s.ProductBarcode,
  s.ProductSK,
  s.CompanySK,
  s.ProductMatchCount,
  s.CompanyResolutionStatus,
  s.ProductResolutionStatus,
  s.EffectiveFrom,
  s.ExpiryTo,
  s.Status,
  s.ListPriceInclVat,
  s.ListPriceExclVat,
  s.ListPriceVatRate,
  s.FloorPct,
  s.FloorPriceInclVat,
  s.FloorRateType,
  s.NdMinQty,
  s.NdMaxQty,
  s.Remark,
  s.SourceUpdatedAt,
  s.SourceDeletedAt,
  s.SourceAsatdate,
  s.asatdate,
  TO_JSON_STRING(STRUCT(s.NdSdPriceID)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(
    s.PriceSK,
    s.NdSdPriceID,
    s.ProductID,
    s.ProductCode,
    s.ProductBarcode,
    s.ProductSK,
    s.CompanySK,
    s.ProductMatchCount,
    s.CompanyResolutionStatus,
    s.ProductResolutionStatus,
    s.EffectiveFrom,
    s.ExpiryTo,
    s.Status,
    s.ListPriceInclVat,
    s.ListPriceExclVat,
    s.ListPriceVatRate,
    s.FloorPct,
    s.FloorPriceInclVat,
    s.FloorRateType,
    s.NdMinQty,
    s.NdMaxQty,
    s.Remark,
    s.SourceUpdatedAt,
    s.SourceDeletedAt,
    s.SourceAsatdate,
    s.asatdate
  ))) AS row_hash
FROM src AS s
