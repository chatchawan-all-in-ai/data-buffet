config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_project"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_project: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimProjectTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_project",
};
const DimProjectTableRef = `${DimProjectTable.database}.${DimProjectTable.schema}.${DimProjectTable.name}`;
}

WITH src AS (
  SELECT
    ProjectSK,
    companyName,
    place,
    district,
    province,
    companyStatus,
    profileComp
  FROM `${DimProjectTableRef}`
)
SELECT
  s.ProjectSK,
  s.companyName,
  s.place,
  s.district,
  s.province,
  s.companyStatus,
  s.profileComp,
  TO_JSON_STRING(STRUCT(s.ProjectSK)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.ProjectSK, s.companyName, s.place, s.district, s.province, s.companyStatus, s.profileComp))) AS row_hash
FROM src AS s
