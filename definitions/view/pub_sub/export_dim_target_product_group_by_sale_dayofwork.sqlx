config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_target_product_group_by_sale_dayofwork"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_target_product_group_by_sale_dayofwork: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimTargetProductGroupBySaleDayofworkTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_target_product_group_by_sale_dayofwork",
};
const DimTargetProductGroupBySaleDayofworkTableRef = `${DimTargetProductGroupBySaleDayofworkTable.database}.${DimTargetProductGroupBySaleDayofworkTable.schema}.${DimTargetProductGroupBySaleDayofworkTable.name}`;
}

WITH src AS (
  SELECT
    Year,
    Month,
    Day,
    SaleRepSKLast,
    SectionSKLast,
    ProductMktSK,
    CompanySK,
    Amt_New,
    Qty_New,
    companyID,
    Date,
    EmployeeID,
    DepartmentID,
    TargetID,
    MarketingGroupID,
    SubMarketingID,
    SegmentID,
    ChannelTargetGroup,
    StartDate
  FROM `${DimTargetProductGroupBySaleDayofworkTableRef}`
)
SELECT
  s.Year,
  s.Month,
  s.Day,
  s.SaleRepSKLast,
  s.SectionSKLast,
  s.ProductMktSK,
  s.CompanySK,
  s.Amt_New,
  s.Qty_New,
  TO_JSON_STRING(STRUCT(s.companyID, s.Date, s.EmployeeID, s.DepartmentID, s.TargetID, s.MarketingGroupID, s.SubMarketingID, s.SegmentID, s.ChannelTargetGroup, s.StartDate)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.Year, s.Month, s.Day, s.SaleRepSKLast, s.SectionSKLast, s.ProductMktSK, s.CompanySK, s.Amt_New, s.Qty_New))) AS row_hash
FROM src AS s
