config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_member"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table positions: one row = one position that someone holds in a company; columns of the 2026-11-02 org sample plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterMemberTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_member",
};
const OrgCenterMemberTableRef = `${OrgCenterMemberTable.database}.${OrgCenterMemberTable.schema}.${OrgCenterMemberTable.name}`;
}

WITH pos AS (
  SELECT DISTINCT
    company_id,
    position_code AS code,
    CAST(NULL AS STRING) AS name,
    CAST(NULL AS STRING) AS default_role_id,
    CAST(NULL AS STRING) AS uniform_code
  FROM `${OrgCenterMemberTableRef}`
)
SELECT
  p.*,
  TO_JSON_STRING(STRUCT(p.company_id, p.code)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(p)) AS row_hash
FROM pos AS p
