config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_fact_transcation"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of fact_view.view_fact_transcation: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.FACT_VIEW}.view_fact_transcation`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table fact_view.view_fact_transcation (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = companyID, milType, milVnos, milListno + occurrence.
-- No unique business key: rows are identified by the key columns plus `occurrence`, the position of the row among
-- the rows with the same key ordered by their data JSON, so exact duplicate lines get distinct, repeatable keys.
WITH src AS (
  SELECT
    milYear,
    milMonth,
    milDay,
    milType,
    CustomerSK,
    CustomerReportInfoSK,
    ProductSK,
    NewProductMktSK,
    PumpSK,
    SaleRepSKLast,
    ChangeSectionSKLast,
    InvoiceSK,
    OrderSK,
    ChannelSK,
    Barcode,
    memoextract,
    CompanySK,
    FactOrderSK,
    FlagSaleExc,
    milSum,
    milsum_incvat,
    milQuan,
    milDisca,
    milVnos,
    milDisct,
    milUprice,
    companyID,
    milListno,
    ROW_NUMBER() OVER (
      PARTITION BY companyID, milType, milVnos, milListno
      ORDER BY TO_JSON_STRING(STRUCT(milYear, milMonth, milDay, milType, CustomerSK, CustomerReportInfoSK, ProductSK, NewProductMktSK, PumpSK, SaleRepSKLast, ChangeSectionSKLast, InvoiceSK, OrderSK, ChannelSK, Barcode, memoextract, CompanySK, FactOrderSK, FlagSaleExc, milSum, milsum_incvat, milQuan, milDisca, milVnos, milDisct, milUprice))
    ) AS occurrence
  FROM `${SourceTableRef}`
)
SELECT
  s.milYear,
  s.milMonth,
  s.milDay,
  s.milType,
  s.CustomerSK,
  s.CustomerReportInfoSK,
  s.ProductSK,
  s.NewProductMktSK,
  s.PumpSK,
  s.SaleRepSKLast,
  s.ChangeSectionSKLast,
  s.InvoiceSK,
  s.OrderSK,
  s.ChannelSK,
  s.Barcode,
  s.memoextract,
  s.CompanySK,
  s.FactOrderSK,
  s.FlagSaleExc,
  s.milSum,
  s.milsum_incvat,
  s.milQuan,
  s.milDisca,
  s.milVnos,
  s.milDisct,
  s.milUprice,
  TO_JSON_STRING(STRUCT(s.companyID, s.milType, s.milVnos, s.milListno, s.occurrence)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.milYear, s.milMonth, s.milDay, s.milType, s.CustomerSK, s.CustomerReportInfoSK, s.ProductSK, s.NewProductMktSK, s.PumpSK, s.SaleRepSKLast, s.ChangeSectionSKLast, s.InvoiceSK, s.OrderSK, s.ChannelSK, s.Barcode, s.memoextract, s.CompanySK, s.FactOrderSK, s.FlagSaleExc, s.milSum, s.milsum_incvat, s.milQuan, s.milDisca, s.milVnos, s.milDisct, s.milUprice))) AS row_hash
FROM src AS s
