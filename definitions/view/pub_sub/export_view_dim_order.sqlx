config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_order"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_order: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const ViewDimOrderTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_VIEW,
    name: "view_dim_order",
};
const ViewDimOrderTableRef = `${ViewDimOrderTable.database}.${ViewDimOrderTable.schema}.${ViewDimOrderTable.name}`;
}

WITH src AS (
  SELECT
    OrderSK,
    mix_date,
    mihRef1,
    mihVnos,
    OrderType,
    StatusName,
    OrderStatus,
    CustomerShipTo
  FROM `${ViewDimOrderTableRef}`
)
SELECT
  s.OrderSK,
  s.mix_date,
  s.mihRef1,
  s.mihVnos,
  s.OrderType,
  s.StatusName,
  s.OrderStatus,
  s.CustomerShipTo,
  TO_JSON_STRING(STRUCT(s.OrderSK)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.OrderSK, s.mix_date, s.mihRef1, s.mihVnos, s.OrderType, s.StatusName, s.OrderStatus, s.CustomerShipTo))) AS row_hash
FROM src AS s
