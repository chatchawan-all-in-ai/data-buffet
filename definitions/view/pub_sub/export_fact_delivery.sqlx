config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "fact_delivery"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of fact_table.fact_delivery: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const FactDeliveryTable = {
    database: databuffet.DATABASE,
    schema: databuffet.FACT_TABLE,
    name: "fact_delivery",
};
const FactDeliveryTableRef = `${FactDeliveryTable.database}.${FactDeliveryTable.schema}.${FactDeliveryTable.name}`;
}

WITH src AS (
  SELECT
    FactTransDeliverySK,
    milCus,
    DeliveryDate,
    Vehicle,
    Zone,
    Point,
    documentStatus_2,
    deliveryStatus_2,
    shipmentStatus_2,
    companyID,
    documentID,
    item,
    ROW_NUMBER() OVER (
      PARTITION BY companyID, documentID, item
      ORDER BY TO_JSON_STRING(STRUCT(FactTransDeliverySK, milCus, DeliveryDate, Vehicle, Zone, Point, documentStatus_2, deliveryStatus_2, shipmentStatus_2))
    ) AS occurrence
  FROM `${FactDeliveryTableRef}`
)
SELECT
  s.FactTransDeliverySK,
  s.milCus,
  s.DeliveryDate,
  s.Vehicle,
  s.Zone,
  s.Point,
  s.documentStatus_2,
  s.deliveryStatus_2,
  s.shipmentStatus_2,
  TO_JSON_STRING(STRUCT(s.companyID, s.documentID, s.item, s.occurrence)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.FactTransDeliverySK, s.milCus, s.DeliveryDate, s.Vehicle, s.Zone, s.Point, s.documentStatus_2, s.deliveryStatus_2, s.shipmentStatus_2))) AS row_hash
FROM src AS s
