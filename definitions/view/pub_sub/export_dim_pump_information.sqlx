config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_pump_information"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_pump_information: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimPumpInformationTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_pump_information",
};
const DimPumpInformationTableRef = `${DimPumpInformationTable.database}.${DimPumpInformationTable.schema}.${DimPumpInformationTable.name}`;
}

WITH src AS (
  SELECT
    PumpSK,
    PumpSegment,
    CompanyID,
    milstk,
    RegionID,
    FlagNewProductMKT
  FROM `${DimPumpInformationTableRef}`
)
SELECT
  s.PumpSK,
  s.PumpSegment,
  TO_JSON_STRING(STRUCT(s.CompanyID, s.milstk, s.RegionID, s.FlagNewProductMKT)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.PumpSK, s.PumpSegment))) AS row_hash
FROM src AS s
