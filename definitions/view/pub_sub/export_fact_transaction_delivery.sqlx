config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "fact_transaction_delivery"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of fact_table.fact_transaction_delivery: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.FACT_TABLE}.fact_transaction_delivery`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table fact_table.fact_transaction_delivery (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = companyID, milType, milvnos, milStk + occurrence.
-- No unique business key: rows are identified by the key columns plus `occurrence`, the position of the row among
-- the rows with the same key ordered by their data JSON, so exact duplicate lines get distinct, repeatable keys.
WITH src AS (
  SELECT
    FactTransDeliverySK,
    InvoiceSK,
    ProductSK,
    company_id,
    mix_date,
    milvnos,
    milQuan,
    milSum,
    companyID,
    milType,
    milStk,
    ROW_NUMBER() OVER (
      PARTITION BY companyID, milType, milvnos, milStk
      ORDER BY TO_JSON_STRING(STRUCT(FactTransDeliverySK, InvoiceSK, ProductSK, company_id, mix_date, milvnos, milQuan, milSum))
    ) AS occurrence
  FROM `${SourceTableRef}`
)
SELECT
  s.FactTransDeliverySK,
  s.InvoiceSK,
  s.ProductSK,
  s.company_id,
  s.mix_date,
  s.milvnos,
  s.milQuan,
  s.milSum,
  TO_JSON_STRING(STRUCT(s.companyID, s.milType, s.milvnos, s.milStk, s.occurrence)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.FactTransDeliverySK, s.InvoiceSK, s.ProductSK, s.company_id, s.mix_date, s.milvnos, s.milQuan, s.milSum))) AS row_hash
FROM src AS s
