config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of commission set stk for the TF team: one row = one ag01 product (stk); columns, names and order of the TF sample, plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- Commission sets keep the column names, order and JSON types of the sample sent to TF on
-- 2026-10-14 (commission_tf_ag01_2026), which differ from the source column names on purpose.
-- Natural key = company_source_id, stkcode (unique, never NULL).
-- Data set   : stk  (commission export for TF; target = sample commission_tf_ag01_2026, 2026-10-14)
-- Original   : Query Commission คุณแป้ง/masterdate.sql (STK)
-- Sources    : databuffet-nonprd.validated_mac5.stk
-- PK: company_source_id, stkcode. Scope: all ag01 rows.
-- Columns, names, order and JSON types match the sample.
-- Differences from the original query (the sample is the target):
--   The source filters stkcode885 <> ''; the sample keeps products without a barcode (57,907 NULL rows), so no filter here.
WITH src AS (
  SELECT company_id AS company_source_id, stkcode, stkcode885, stkdesct1 AS STKdescT1
  FROM ${ref(databuffet.VALIDATED_MAC5, "stk")}
  WHERE company_id = 'ag01'
)
SELECT
  s.*,
  TO_JSON_STRING(STRUCT(s.company_source_id, s.stkcode)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(s)) AS row_hash
FROM src AS s
