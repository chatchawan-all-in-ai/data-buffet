config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_exception"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table access_exceptions: one row = one special-access scope of a person (the code arrays split to one value per row); columns of the 2026-11-02 org sample plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterExceptionTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_exception",
};
const OrgCenterExceptionTableRef = `${OrgCenterExceptionTable.database}.${OrgCenterExceptionTable.schema}.${OrgCenterExceptionTable.name}`;
}

WITH access_exception AS (
  SELECT
    x.employee_id,
    x.company_code,
    CAST(NULL AS STRING) AS report_id,
    CAST(NULL AS STRING) AS report_name,
    director_value AS director_code,
    region_value AS region_code,
    section_value AS section_code,
    CAST(NULL AS STRING) AS department_code,
    x.marketing_group_id AS mkt_group_id,
    x.sub_marketing_id AS mkt_subgroup_id,
    x.segment_id AS mkt_segment_id,
    x.flag_customer,
    x.source_row_id
  FROM `${OrgCenterExceptionTableRef}` AS x,
  UNNEST(x.director_code) AS director_value,
  UNNEST(x.region_code) AS region_value,
  UNNEST(x.section_code) AS section_value
)
SELECT
  a.*,
  TO_JSON_STRING(STRUCT(
    a.source_row_id, a.company_code, a.director_code, a.region_code, a.section_code,
    a.mkt_group_id, a.mkt_subgroup_id, a.mkt_segment_id
  )) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(a)) AS row_hash
FROM access_exception AS a
