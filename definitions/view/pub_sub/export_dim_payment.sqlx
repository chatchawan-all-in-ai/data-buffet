config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_payment"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_payment: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimPaymentTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_payment",
};
const DimPaymentTableRef = `${DimPaymentTable.database}.${DimPaymentTable.schema}.${DimPaymentTable.name}`;
}

WITH src AS (
  SELECT
    CodeMemo,
    PaymentMethodTH,
    PaymentType,
    companyID
  FROM `${DimPaymentTableRef}`
)
SELECT
  s.CodeMemo,
  s.PaymentMethodTH,
  s.PaymentType,
  TO_JSON_STRING(STRUCT(s.companyID, s.CodeMemo)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.CodeMemo, s.PaymentMethodTH, s.PaymentType))) AS row_hash
FROM src AS s
