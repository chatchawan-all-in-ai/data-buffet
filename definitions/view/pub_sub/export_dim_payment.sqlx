config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_payment"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_payment: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_payment`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_table.dim_payment (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = companyID, CodeMemo.
WITH src AS (
  SELECT
    CodeMemo,
    PaymentMethodTH,
    PaymentType,
    companyID
  FROM `${SourceTableRef}`
)
SELECT
  s.CodeMemo,
  s.PaymentMethodTH,
  s.PaymentType,
  TO_JSON_STRING(STRUCT(s.companyID, s.CodeMemo)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.CodeMemo, s.PaymentMethodTH, s.PaymentType))) AS row_hash
FROM src AS s
