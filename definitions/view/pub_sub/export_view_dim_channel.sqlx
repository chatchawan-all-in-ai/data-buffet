config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_channel"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_channel: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const ViewDimChannelTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_VIEW,
    name: "view_dim_channel",
};
const ViewDimChannelTableRef = `${ViewDimChannelTable.database}.${ViewDimChannelTable.schema}.${ViewDimChannelTable.name}`;
}

WITH src AS (
  SELECT
    ChannelSK,
    ChannelGroup,
    ChannelName,
    companyID,
    DepCode
  FROM `${ViewDimChannelTableRef}`
)
SELECT
  s.ChannelSK,
  s.ChannelGroup,
  s.ChannelName,
  TO_JSON_STRING(STRUCT(s.companyID, s.DepCode)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.ChannelSK, s.ChannelGroup, s.ChannelName))) AS row_hash
FROM src AS s
