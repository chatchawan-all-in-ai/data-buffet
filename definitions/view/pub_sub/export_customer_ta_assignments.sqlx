config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_customer_ta"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table customer_ta_assignments: one row = one customer in the portfolio of one TA department for a period, with the customer company also used as the department membership company; columns of the 2026-11-02 org sample (membership_id renamed department_id) plus membership_company_id, row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterCustomerTaTableRef = `${databuffet.DATABASE}.${databuffet.ORG_CENTER}.org_center_customer_ta`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- TA app table, shape of the org sample sent to the AI team on 2026-11-02 (one file per app table):
--   no app-generated id / created_at / updated_at / synced_at; company_id = company code;
--   [valid_from, valid_to) with valid_to NULL = still valid (org center keeps the end day itself
--   and 2066-12-31 as "open", so valid_to + 1 day and 2066-12-31 -> NULL where it is noted).
-- Natural key = company_id, customer_id, department_id, valid_from.
-- company_id = the customer's company; department_id = the TA department (the TA position) that owns the customer
-- (NULL when not yet known; it is part of the key, so an empty value is its own key bucket).
-- org_center_customer_ta.valid_to is the first day after the assignment, so only 2066-12-31 -> NULL applies. source_row_id = MDS id.
WITH assignment AS (
  SELECT
    c.company_id,
    c.customer_code AS customer_id,
    c.department_id,
    c.share_percent,
    c.valid_from,
    IF(c.valid_to >= DATE '2066-12-31', CAST(NULL AS DATE), c.valid_to) AS valid_to,
    c.source_row_id,
    IF(c.department_id IS NULL, CAST(NULL AS STRING), c.company_id) AS membership_company_id
  FROM `${OrgCenterCustomerTaTableRef}` AS c
)
SELECT
  a.*,
  TO_JSON_STRING(STRUCT(a.company_id, a.customer_id, a.department_id, a.valid_from)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(a)) AS row_hash
FROM assignment AS a
