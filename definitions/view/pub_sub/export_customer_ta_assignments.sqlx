config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_customer_ta"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table customer_ta_assignments: one row = one customer in the portfolio of one TA department for a period, with the customer company also used as the department membership company; columns of the 2026-11-02 org sample (membership_id renamed department_id) plus membership_company_id, row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const OrgCenterCustomerTaTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_customer_ta",
};
const OrgCenterCustomerTaTableRef = `${OrgCenterCustomerTaTable.database}.${OrgCenterCustomerTaTable.schema}.${OrgCenterCustomerTaTable.name}`;
}

WITH assignment AS (
  SELECT
    c.company_id,
    c.customer_code AS customer_id,
    c.department_id,
    c.share_percent,
    c.valid_from,
    IF(c.valid_to >= DATE '2066-12-31', CAST(NULL AS DATE), c.valid_to) AS valid_to,
    c.source_row_id,
    IF(c.department_id IS NULL, CAST(NULL AS STRING), c.company_id) AS membership_company_id
  FROM `${OrgCenterCustomerTaTableRef}` AS c
)
SELECT
  a.*,
  TO_JSON_STRING(STRUCT(a.company_id, a.customer_id, a.department_id, a.valid_from)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(a)) AS row_hash
FROM assignment AS a
