config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_sale_representative_last"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_sale_representative_last: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const ViewDimSaleRepresentativeLastTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_VIEW,
    name: "view_dim_sale_representative_last",
};
const ViewDimSaleRepresentativeLastTableRef = `${ViewDimSaleRepresentativeLastTable.database}.${ViewDimSaleRepresentativeLastTable.schema}.${ViewDimSaleRepresentativeLastTable.name}`;
}

WITH src AS (
  SELECT
    SaleRepSK,
    EmployeeID,
    EmployeeName,
    EmployeeSurname,
    EmployeeNickname,
    DepartmentID,
    DepartmentName,
    companyID,
    DepCode,
    CostChannelID,
    ProvinceID,
    OrderStartDate,
    OrderEndDate
  FROM `${ViewDimSaleRepresentativeLastTableRef}`
)
SELECT
  s.SaleRepSK,
  s.EmployeeID,
  s.EmployeeName,
  s.EmployeeSurname,
  s.EmployeeNickname,
  s.DepartmentID,
  s.DepartmentName,
  TO_JSON_STRING(STRUCT(s.companyID, s.DepartmentID, s.EmployeeID, s.DepCode, s.CostChannelID, s.ProvinceID, s.OrderStartDate, s.OrderEndDate)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.SaleRepSK, s.EmployeeID, s.EmployeeName, s.EmployeeSurname, s.EmployeeNickname, s.DepartmentID, s.DepartmentName))) AS row_hash
FROM src AS s
