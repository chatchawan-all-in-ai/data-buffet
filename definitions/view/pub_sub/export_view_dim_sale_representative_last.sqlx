config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_sale_representative_last"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_sale_representative_last: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_VIEW}.view_dim_sale_representative_last`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_view.view_dim_sale_representative_last (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = companyID, DepartmentID, EmployeeID, DepCode, CostChannelID, ProvinceID, OrderStartDate, OrderEndDate.
WITH src AS (
  SELECT
    SaleRepSK,
    EmployeeID,
    EmployeeName,
    EmployeeSurname,
    EmployeeNickname,
    DepartmentID,
    DepartmentName,
    companyID,
    DepCode,
    CostChannelID,
    ProvinceID,
    OrderStartDate,
    OrderEndDate
  FROM `${SourceTableRef}`
)
SELECT
  s.SaleRepSK,
  s.EmployeeID,
  s.EmployeeName,
  s.EmployeeSurname,
  s.EmployeeNickname,
  s.DepartmentID,
  s.DepartmentName,
  TO_JSON_STRING(STRUCT(s.companyID, s.DepartmentID, s.EmployeeID, s.DepCode, s.CostChannelID, s.ProvinceID, s.OrderStartDate, s.OrderEndDate)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.SaleRepSK, s.EmployeeID, s.EmployeeName, s.EmployeeSurname, s.EmployeeNickname, s.DepartmentID, s.DepartmentName))) AS row_hash
FROM src AS s
