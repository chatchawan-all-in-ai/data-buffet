config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_customer_segment"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_customer_segment: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_customer_segment`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_table.dim_customer_segment (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = CompanyID, Segment3.
WITH src AS (
  SELECT
    CustomerSegmentSK,
    Segment1,
    Segment2,
    Segment3,
    DescriptionThai,
    DescriptionEng,
    SortOrder,
    CompanyID
  FROM `${SourceTableRef}`
)
SELECT
  s.CustomerSegmentSK,
  s.Segment1,
  s.Segment2,
  s.Segment3,
  s.DescriptionThai,
  s.DescriptionEng,
  s.SortOrder,
  TO_JSON_STRING(STRUCT(s.CompanyID, s.Segment3)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.CustomerSegmentSK, s.Segment1, s.Segment2, s.Segment3, s.DescriptionThai, s.DescriptionEng, s.SortOrder))) AS row_hash
FROM src AS s
