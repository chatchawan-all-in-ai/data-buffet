config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_company"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dim_company: its columns under their dim names (no SK, no MdsId), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimCompanyTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_company`;
}

-- Export view contract (one per exported table, listed in includes/controller/mart-export-config.json):
--   * data columns first, under their source column names, no surrogate keys and nothing that moves
--     by itself day to day, so an unchanged row keeps the same row_hash; no cleaning helpers — the
--     source dim already cleaned them;
--   * row_key = TO_JSON_STRING(STRUCT(<natural key>)), never NULL;
--   * row_hash = FARM_FINGERPRINT of the JSON of every data column, i.e. of exactly the message `data`.
-- Natural key = CompanyID (unique and never NULL in dim_company).
WITH company AS (
  SELECT
    CompanyID,
    CompanyCode,
    CompanyNameTH,
    CompanyNameEN
  FROM `${DimCompanyTableRef}`
)
SELECT
  c.*,
  TO_JSON_STRING(STRUCT(c.CompanyID)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(c)) AS row_hash
FROM company AS c
