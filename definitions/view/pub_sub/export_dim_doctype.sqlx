config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_doctype"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_doctype: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_doctype`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_table.dim_doctype (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = companyID, Code.
WITH src AS (
  SELECT
    Code,
    DescriptionTH,
    companyID
  FROM `${SourceTableRef}`
)
SELECT
  s.Code,
  s.DescriptionTH,
  TO_JSON_STRING(STRUCT(s.companyID, s.Code)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.Code, s.DescriptionTH))) AS row_hash
FROM src AS s
