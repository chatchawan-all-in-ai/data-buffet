config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of mds_dataset.mds_data_org_ols_center: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const MdsDataOrgOlsCenterTable = {
    database: databuffet.DATABASE,
    schema: databuffet.MDS_DATASET,
    name: "mds_data_org_ols_center",
};
const MdsDataOrgOlsCenterTableRef = `${MdsDataOrgOlsCenterTable.database}.${MdsDataOrgOlsCenterTable.schema}.${MdsDataOrgOlsCenterTable.name}`;
}

WITH src AS (
  SELECT
    employeeemail,
    viewtarget,
    is_active
  FROM `${MdsDataOrgOlsCenterTableRef}`
)
SELECT
  s.employeeemail,
  s.viewtarget,
  s.is_active,
  TO_JSON_STRING(STRUCT(s.employeeemail)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.employeeemail, s.viewtarget, s.is_active))) AS row_hash
FROM src AS s
