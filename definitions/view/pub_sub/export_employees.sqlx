config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "org_center_person", "org_center_exception"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of the TA app table employees: one row = one person of org_center_person (with phone and line_uuid from MDS employee info) plus the people of org_center_exception who are not in it (names from MDS); columns of the 2026-11-02 org sample plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
const MdsDataOrgEmployeeMappingCenterTable = {
    database: databuffet.DATABASE,
    schema: databuffet.MDS_DATASET,
    name: "mds_data_org_employee_mapping_center",
};
const MdsDataOrgEmployeeMappingCenterTableRef = `${MdsDataOrgEmployeeMappingCenterTable.database}.${MdsDataOrgEmployeeMappingCenterTable.schema}.${MdsDataOrgEmployeeMappingCenterTable.name}`;

const OrgCenterPersonTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_person",
};
const OrgCenterPersonTableRef = `${OrgCenterPersonTable.database}.${OrgCenterPersonTable.schema}.${OrgCenterPersonTable.name}`;

const OrgCenterExceptionTable = {
    database: databuffet.DATABASE,
    schema: databuffet.ORG_CENTER,
    name: "org_center_exception",
};
const OrgCenterExceptionTableRef = `${OrgCenterExceptionTable.database}.${OrgCenterExceptionTable.schema}.${OrgCenterExceptionTable.name}`;


}

WITH mds_mapping AS (
  SELECT
    ${databuffet.functionData.cleanString("employeeid")} AS employee_id,
    ${databuffet.functionData.cleanString("employeename")} AS employee_name,
    ${databuffet.functionData.cleanString("employeeemail")} AS email
  FROM `${MdsDataOrgEmployeeMappingCenterTableRef}`
  WHERE is_active = TRUE
    AND ${databuffet.functionData.cleanString("employeeid")} IS NOT NULL
  QUALIFY ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY updated_at DESC, id) = 1

), seated AS (
  SELECT
    employee_id AS person_key,
    first_name,
    last_name,
    nickname,
    email,
    mobile_phone AS phone,
    line_uuid
  FROM `${OrgCenterPersonTableRef}`

), unseated AS (
  SELECT
    ex.employee_id AS person_key,
    REGEXP_EXTRACT(mp.employee_name, r'^(\S+)') AS first_name,
    REGEXP_EXTRACT(mp.employee_name, r'^\S+\s+(.+)$') AS last_name,
    CAST(NULL AS STRING) AS nickname,
    mp.email AS email,
    CAST(NULL AS STRING) AS phone,
    CAST(NULL AS STRING) AS line_uuid
  FROM (
    SELECT DISTINCT employee_id
    FROM `${OrgCenterExceptionTableRef}`
    WHERE employee_id IS NOT NULL
  ) AS ex
  LEFT JOIN seated AS se
    ON ex.employee_id = se.person_key
  LEFT JOIN mds_mapping AS mp
    ON ex.employee_id = mp.employee_id
  WHERE se.person_key IS NULL

), employee AS (
  SELECT * FROM seated
  UNION ALL
  SELECT * FROM unseated

), shaped AS (
  SELECT
    person_key,
    COALESCE(nickname, first_name) AS display_name,
    first_name,
    last_name,
    nickname,
    email,
    phone,
    IF(phone IS NULL, CAST(NULL AS STRING), 'mds') AS phone_source,
    line_uuid
  FROM employee
)
SELECT
  s.*,
  TO_JSON_STRING(STRUCT(s.person_key)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(s)) AS row_hash
FROM shaped AS s
