config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "view_dim_customer"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_view.view_dim_customer: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const ViewDimCustomerTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_VIEW,
    name: "view_dim_customer",
};
const ViewDimCustomerTableRef = `${ViewDimCustomerTable.database}.${ViewDimCustomerTable.schema}.${ViewDimCustomerTable.name}`;
}

WITH src AS (
  SELECT
    CustomerSK,
    companyID,
    debcode,
    debnamet,
    NicknameCustomer,
    customer_status_name,
    debbranch,
    District,
    DEBcreditTerm,
    debgrade,
    customer_type_name,
    customer_type_name_en,
    debgroup
  FROM `${ViewDimCustomerTableRef}`
)
SELECT
  s.CustomerSK,
  s.companyID,
  s.debcode,
  s.debnamet,
  s.NicknameCustomer,
  s.customer_status_name,
  s.debbranch,
  s.District,
  s.DEBcreditTerm,
  s.debgrade,
  s.customer_type_name,
  s.customer_type_name_en,
  s.debgroup,
  TO_JSON_STRING(STRUCT(s.CustomerSK)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.CustomerSK, s.companyID, s.debcode, s.debnamet, s.NicknameCustomer, s.customer_status_name, s.debbranch, s.District, s.DEBcreditTerm, s.debgrade, s.customer_type_name, s.customer_type_name_en, s.debgroup))) AS row_hash
FROM src AS s
