config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_calendar"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_calendar: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const DimCalendarTable = {
    database: databuffet.DATABASE,
    schema: databuffet.DIMENSION_TABLE,
    name: "dim_calendar",
};
const DimCalendarTableRef = `${DimCalendarTable.database}.${DimCalendarTable.schema}.${DimCalendarTable.name}`;
}

WITH src AS (
  SELECT
    Date,
    Year,
    MonthNumber,
    MonthShortName,
    MonthOfYear,
    YearMonthNumber,
    WeekendFlag,
    HolidayFlag
  FROM `${DimCalendarTableRef}`
)
SELECT
  s.Date,
  s.Year,
  s.MonthNumber,
  s.MonthShortName,
  s.MonthOfYear,
  s.YearMonthNumber,
  s.WeekendFlag,
  s.HolidayFlag,
  TO_JSON_STRING(STRUCT(s.Date)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.Date, s.Year, s.MonthNumber, s.MonthShortName, s.MonthOfYear, s.YearMonthNumber, s.WeekendFlag, s.HolidayFlag))) AS row_hash
FROM src AS s
