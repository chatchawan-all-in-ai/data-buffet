config {
    type: "view",
    schema: databuffet.PUB_SUB,
    dependencies: ["pub_sub_schema", "dim_calendar"],
    // TAG_VIEW like every view; TAG_PUB_SUB deploys it with the rest of the Pub/Sub export objects
    tags: [databuffet.TAG_VIEW, databuffet.TAG_PUB_SUB],
    description: "Pub/Sub export of dimension_table.dim_calendar: the columns of the sample sent to the AI team (the AI team package of 2026-10-26), plus row_key (primary_key of the message) and row_hash (fingerprint of the message data)",
}

js {
    const SourceTableRef = `${databuffet.DATABASE}.${databuffet.DIMENSION_TABLE}.dim_calendar`;
}

-- Export view contract: document/project_wiki/cdc-process/process.md (Pub/Sub export).
-- AI team sample table dimension_table.dim_calendar (the AI team package of 2026-10-26): the sample's columns, names and order,
-- read from the same source for the whole table (the sample filters are not applied).
-- Natural key = Date.
WITH src AS (
  SELECT
    Date,
    Year,
    MonthNumber,
    MonthShortName,
    MonthOfYear,
    YearMonthNumber,
    WeekendFlag,
    HolidayFlag
  FROM `${SourceTableRef}`
)
SELECT
  s.Date,
  s.Year,
  s.MonthNumber,
  s.MonthShortName,
  s.MonthOfYear,
  s.YearMonthNumber,
  s.WeekendFlag,
  s.HolidayFlag,
  TO_JSON_STRING(STRUCT(s.Date)) AS row_key,
  FARM_FINGERPRINT(TO_JSON_STRING(STRUCT(s.Date, s.Year, s.MonthNumber, s.MonthShortName, s.MonthOfYear, s.YearMonthNumber, s.WeekendFlag, s.HolidayFlag))) AS row_hash
FROM src AS s
